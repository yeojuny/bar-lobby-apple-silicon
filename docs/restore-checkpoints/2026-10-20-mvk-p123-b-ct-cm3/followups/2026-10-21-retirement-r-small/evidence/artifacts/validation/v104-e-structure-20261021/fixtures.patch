+// limits. Receivers remain CPU mocks; no new product diagnostic hooks.
+static void allocatorPolicyBoundaries() {
+    const unsigned limit = MVKMetal4ResourcePoolStats::maxAllocatorEpochRecordings;
+    for (bool submitted : {false, true}) {
