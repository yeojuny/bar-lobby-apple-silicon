+        std::shared_ptr<MVKMetal4AllocatorEpoch> epoch;
+        for (unsigned i = 0; i < limit; ++i) {
+            auto b = f.begin();
+            if (!epoch) { epoch = b->_state->allocatorUse.epoch; }
+            check(b->_state->allocatorUse.epoch == epoch && epoch->writer, "one exclusive writer appends to the same epoch");
+            check(b->end(), "bounded recording ends");
+            check(epoch->recordings == i + 1 && !epoch->writer, "count tracks native ends");
+            check(epoch->state == (i + 1 == limit ? MVKMetal4AllocatorState::Sealed : MVKMetal4AllocatorState::Appendable), "seal exactly at selected count");
+            records.push_back(std::move(b));
