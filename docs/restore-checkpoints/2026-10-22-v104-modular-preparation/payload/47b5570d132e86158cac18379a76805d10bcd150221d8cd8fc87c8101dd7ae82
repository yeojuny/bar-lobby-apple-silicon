// Immutable metadata is attached before publishing a newly created texture or
// an acquired drawable. The weak binding avoids texture -> drawable -> texture
// cycles; registry/submission ownership supplies the actual strong references.
@interface MVKMetal4TextureOwnership : NSObject {
@public
    bool ordinary;
    uint64_t generation;
    std::weak_ptr<MVKMetal4DrawableBinding> binding;
}
@end
@implementation MVKMetal4TextureOwnership
@end

namespace {
char textureOwnershipKey;
MVKMetal4TextureOwnership* ordinaryTextureOwnership() {
    static MVKMetal4TextureOwnership* value = [] {
        auto* result = [MVKMetal4TextureOwnership new];
        result->ordinary = true;
        return result;
    }();
    return value;
}
struct TextureOwnershipSnapshot {
    bool ordinary = false;
    uint64_t generation = 0;
    std::shared_ptr<MVKMetal4DrawableBinding> binding;
};
TextureOwnershipSnapshot textureOwnership(id<MTLTexture> texture) {
    while (texture) {
        auto* source = static_cast<MVKMetal4TextureOwnership*>(objc_getAssociatedObject(texture, &textureOwnershipKey));
        if (source) {
            if (source->ordinary) { return {true, 0, {}}; }
            if (auto binding = source->binding.lock()) { return {false, source->generation, std::move(binding)}; }
        }
        id<MTLTexture> parent = texture.parentTexture;
        if (parent == texture) { break; }
        texture = parent;
    }
    return {};
}
