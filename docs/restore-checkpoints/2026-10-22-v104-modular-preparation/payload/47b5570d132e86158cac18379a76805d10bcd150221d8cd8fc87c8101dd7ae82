MVKMetal4ArgumentTables* MVKMetal4Submission::acquireArgumentTables(NSUInteger bufferCount,
        NSUInteger textureCount, NSUInteger samplerCount, bool computeOnly, NSError** error) {
    if (error) { *error = nil; }
    std::lock_guard<std::mutex> lock(_state->mutex);
    if (_state->phase != Phase::Recording || !_state->pack) {
        fail(error, 3, @"Argument table leases require a recording submission."); return nullptr;
    }
    for (auto& group : _state->pack->argumentTables) {
        const auto& limits = group.tables->getLimits();
        if (group.leased || group.computeOnly != computeOnly ||
            limits.bufferCount != bufferCount || limits.textureCount != textureCount ||
            limits.samplerCount != samplerCount) { continue; }
        group.leased = true;
        std::lock_guard<std::mutex> poolLock(_state->storage->poolMutex);
        ++_state->storage->poolStats.argumentTableGroupsReused;
        return group.tables.get();
    }
    auto tables = std::make_unique<MVKMetal4ArgumentTables>();
    MVKMetal4ArgumentTables::Limits limits {bufferCount, textureCount, samplerCount};
    bool initialized = computeOnly ? tables->initializeCompute(_state->storage->device, limits, error)
                                   : tables->initialize(_state->storage->device, limits, error);
    if (!initialized) { return nullptr; }
    auto* result = tables.get();
    if (_state->pack->argumentTables.size() < MVKMetal4ResourcePoolStats::maxArgumentTableGroupsPerPack) {
        _state->pack->argumentTables.push_back({std::move(tables), computeOnly, true});
    } else {
        _state->transientArgumentTables.push_back({std::move(tables), computeOnly, true});
    }
    {
        std::lock_guard<std::mutex> poolLock(_state->storage->poolMutex);
        ++_state->storage->poolStats.argumentTableGroupsCreated;
    }
    return result;
}

bool MVKMetal4Submission::releaseArgumentTables(MVKMetal4ArgumentTables* tables, NSError** error) {
    if (error) { *error = nil; }
    std::lock_guard<std::mutex> lock(_state->mutex);
    if (_state->phase != Phase::Recording || !_state->pack || !tables) {
        return fail(error, 3, @"Primary argument table return requires a recording submission and owned lease.");
    }
    for (auto& group : _state->pack->argumentTables) {
        if (group.tables.get() != tables) { continue; }
        if (!group.leased || group.computeOnly) {
            return fail(error, 3, @"Only an active primary argument table lease may be returned.");
        }
        // CPU encoding has ended; already encoded work uses snapshots. Keep the
        // wrapper and all immutable upload cache entries owned by this batch.
        if (!tables->resetBindingsForNextEncoder(error)) { return false; }
        group.leased = false;
        return true;
    }
    for (auto& group : _state->transientArgumentTables) {
        if (group.tables.get() != tables) { continue; }
        if (!group.leased || group.computeOnly) {
            return fail(error, 3, @"Only an active primary argument table lease may be returned.");
        }
        // Bounded-pool overflow is deliberately not scanned by acquire. Track a
        // single return without releasing or reusing this in-flight wrapper.
        group.leased = false;
        return true;
    }
    return fail(error, 3, @"Argument table lease is not owned by this submission.");
}

