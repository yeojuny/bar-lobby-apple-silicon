struct MVKMetal4DeviceResidency::Storage {
    struct SetState {
        id<MTLDevice> device;
        id<MTLResidencySet> set;
        std::mutex mutex;
        std::unordered_map<const void*, size_t> members;
        std::atomic<bool> dirty{false};
        SetState(id<MTLDevice> dev, id<MTLResidencySet> value) : device([dev retain]), set([value retain]) {}
        ~SetState() { [set release]; [device release]; }
        void add(id<MTLAllocation> allocation) {
            std::lock_guard<std::mutex> lock(mutex);
            if (++members[(const void*)allocation] == 1) {
                [set addAllocation:allocation];
                dirty.store(true, std::memory_order_release);
            }
        }
        void remove(id<MTLAllocation> allocation) {
            std::lock_guard<std::mutex> lock(mutex);
            auto entry = members.find((const void*)allocation);
            if (entry != members.end() && !--entry->second) {
                members.erase(entry);
                [set removeAllocation:allocation];
                [set commit];
                dirty.store(false, std::memory_order_release);
            }
        }
        void commit() {
            if (!dirty.load(std::memory_order_acquire)) { return; }
            std::lock_guard<std::mutex> lock(mutex);
            if (dirty.exchange(false, std::memory_order_acq_rel)) { [set commit]; }
        }
    };
    struct Entry {
        std::shared_ptr<SetState> state;
        id<MTLAllocation> allocation;
        Entry(std::shared_ptr<SetState> owner, id<MTLAllocation> value)
            : state(std::move(owner)), allocation([value retain]) { state->add(allocation); }
        ~Entry() {
            state->remove(allocation);
            // No registry/set lock is held during native object destruction.
            [allocation release];
        }
    };
    struct Registration { size_t owners; std::shared_ptr<Entry> entry; };
    std::shared_ptr<SetState> state;
    mutable std::mutex mutex;
    std::unordered_map<const void*, Registration> registrations;
};

MVKMetal4DeviceResidency::MVKMetal4DeviceResidency(std::unique_ptr<Storage> storage)
    : _storage(std::move(storage)) {}
MVKMetal4DeviceResidency::~MVKMetal4DeviceResidency() = default;

std::shared_ptr<MVKMetal4DeviceResidency> MVKMetal4DeviceResidency::create(id<MTLDevice> device, NSError** error) {
    if (error) { *error = nil; }
    if (!device || ![device supportsFamily:MTLGPUFamilyMetal4]) {
        fail(error, 1, @"Device residency requires a Metal 4 device."); return {};
    }
    auto* descriptor = [MTLResidencySetDescriptor new];
    descriptor.label = @"MoltenVK Metal 4 allocation owners";
    descriptor.initialCapacity = 256;
    id<MTLResidencySet> set = [device newResidencySetWithDescriptor:descriptor error:error];
    [descriptor release];
    if (!set) {
        if (!error || !*error) { fail(error, 2, @"Could not create Metal 4 device residency."); }
        return {};
    }
    auto storage = std::make_unique<Storage>();
    storage->state = std::make_shared<Storage::SetState>(device, set);
    [set release];
    return std::shared_ptr<MVKMetal4DeviceResidency>(new MVKMetal4DeviceResidency(std::move(storage)));
}

bool MVKMetal4DeviceResidency::registerAllocation(id<MTLAllocation> allocation, NSError** error) {
    id<MTLDevice> allocationDevice = nil;
    if ([allocation conformsToProtocol:@protocol(MTLResource)]) { allocationDevice = [(id<MTLResource>)allocation device]; }
    else if ([allocation conformsToProtocol:@protocol(MTLHeap)]) { allocationDevice = [(id<MTLHeap>)allocation device]; }
    if (!allocation || allocationDevice != device()) { return fail(error, 3, @"Residency allocation belongs to another device."); }
    std::lock_guard<std::mutex> lock(_storage->mutex);
    auto entry = _storage->registrations.find((const void*)allocation);
    if (entry != _storage->registrations.end()) { ++entry->second.owners; }
    else {
        _storage->registrations.emplace((const void*)allocation,
            Storage::Registration{1, std::make_shared<Storage::Entry>(_storage->state, allocation)});
    }
    return true;
}

void MVKMetal4DeviceResidency::unregisterAllocation(id<MTLAllocation> allocation) {
    std::shared_ptr<Storage::Entry> retired;
    {
        std::lock_guard<std::mutex> lock(_storage->mutex);
        auto entry = _storage->registrations.find((const void*)allocation);
        if (entry == _storage->registrations.end()) { return; }
        if (--entry->second.owners) { return; }
        retired = std::move(entry->second.entry);
        _storage->registrations.erase(entry);
    }
    // In-flight GPU recordings keep the entry and residency independently.
    retired.reset();
}

std::shared_ptr<void> MVKMetal4DeviceResidency::lease(id<MTLResource> resource) const {
    return leaseWithKind(resource, MVKMetal4ResourceKind::Unknown);
}

std::shared_ptr<void> MVKMetal4DeviceResidency::leaseWithKind(id<MTLResource> resource, MVKMetal4ResourceKind kind) const {
    if (!resource || resource.device != device()) { return {}; }
    auto find = [&](id<MTLAllocation> allocation) -> std::shared_ptr<void> {
        if (!allocation) { return {}; }
        std::lock_guard<std::mutex> lock(_storage->mutex);
        auto entry = _storage->registrations.find((const void*)allocation);
        return entry == _storage->registrations.end() ? std::shared_ptr<void>{} : entry->second.entry;
    };
    if (auto result = find(resource)) { return result; }
    if (auto result = find(resource.heap)) { return result; }
    if (kind == MVKMetal4ResourceKind::Texture ||
        (kind == MVKMetal4ResourceKind::Unknown && [resource conformsToProtocol:@protocol(MTLTexture)])) {
        id<MTLTexture> texture = (id<MTLTexture>)resource;
        for (unsigned depth = 0; depth < 64; ++depth) {
            id<MTLTexture> parent = texture.parentTexture;
            if (!parent || parent == texture) { break; }
            if (auto result = find(parent)) { return result; }
            if (auto result = find(parent.heap)) { return result; }
            texture = parent;
        }
    }
    return {};
}
void MVKMetal4DeviceResidency::commit() { _storage->state->commit(); }
id<MTLDevice> MVKMetal4DeviceResidency::device() const { return _storage->state->device; }
id<MTLResidencySet> MVKMetal4DeviceResidency::residencySet() const { return _storage->state->set; }

bool mvkRegisterMetal4Drawable(id<MTLTexture> texture, id<MTLDrawable> drawable, NSError** error) {
    if (error) { *error = nil; }
    if (!texture || !drawable) { return fail(error, 3, @"Drawable registration requires a texture and drawable."); }
    if (textureOwnership(texture).ordinary) {
        return fail(error, 3, @"A device-created ordinary texture cannot be a CAMetalLayer drawable.");
    }
    std::lock_guard<std::mutex> lock(drawableRegistryMutex);
    auto entry = drawableRegistry.find(texture);
    if (entry != drawableRegistry.end()) {
        return entry->second->drawable == drawable || fail(error, 3, @"Texture already belongs to another registered drawable.");
    }
    auto binding = std::make_shared<MVKMetal4DrawableBinding>(drawable);
    auto* source = [MVKMetal4TextureOwnership new];
    source->binding = binding;
    drawableRegistry.emplace(texture, binding);
    advanceDrawableRegistryGeneration();
    source->generation = drawableRegistryGeneration.load(std::memory_order_relaxed);
    objc_setAssociatedObject(texture, &textureOwnershipKey, source, OBJC_ASSOCIATION_RETAIN);
    [source release];
    return true;
}

void mvkUnregisterMetal4Drawable(id<MTLTexture> texture, id<MTLDrawable> drawable) {
    std::shared_ptr<MVKMetal4DrawableBinding> released;
    {
        std::lock_guard<std::mutex> lock(drawableRegistryMutex);
        auto entry = drawableRegistry.find(texture);
        if (entry != drawableRegistry.end() && entry->second->drawable == drawable) {
            released = std::move(entry->second);
            drawableRegistry.erase(entry);
            advanceDrawableRegistryGeneration();
        }
    }
    released.reset(); // Releasing a drawable may invoke a presented handler.
}

void mvkMarkMetal4OrdinaryTexture(id<MTLTexture> texture) {
    if (texture) {
        objc_setAssociatedObject(texture, &textureOwnershipKey, ordinaryTextureOwnership(), OBJC_ASSOCIATION_RETAIN);
    }
}

void mvkInheritMetal4TextureOwnership(id<MTLTexture> texture, id<MTLTexture> parent) {
    if (!texture || texture == parent) { return; }
    id source = objc_getAssociatedObject(parent, &textureOwnershipKey);
    if (source) { objc_setAssociatedObject(texture, &textureOwnershipKey, source, OBJC_ASSOCIATION_RETAIN); }
}

struct MVKMetal4EventValue {
    id<MTLEvent> event;
    uint64_t value;
    bool internalTimelineSignal = false;
};
struct MVKMetal4Presentation {
    id<MTLDrawable> drawable;
    double timeSeconds;
    std::function<void()> beforePresent;
};
struct MVKMetal4ObjectIdentity {
    bool resident = false, texture = false;
    bool gpuRetained = false, operationRetained = false;
    uint64_t drawableGeneration = 0;
};
using MVKMetal4ObjectIdentityMap = MVKMetal4RecycledIdentityMap<MVKMetal4ObjectIdentity,
    MVKMetal4ResourcePoolStats::maxHostIdentityBuckets>;

// Queue operations outlive the command allocator when an actual signal observer
// is still pending. Cache only empty capacity, independently of GPU work packs.
struct MVKMetal4CompletionStorage {
    NSMutableArray* retained = nil;
    size_t retainedHighWater = 0;
    std::vector<MVKMetal4EventValue> waits, signals;
    std::vector<id<MTLDrawable>> drawables;
    std::vector<MVKMetal4Presentation> presentations;
    uint64_t hostStorageBytes() const {
        return waits.capacity() * sizeof(MVKMetal4EventValue) + signals.capacity() * sizeof(MVKMetal4EventValue) +
            drawables.capacity() * sizeof(id<MTLDrawable>) + presentations.capacity() * sizeof(MVKMetal4Presentation);
    }
    ~MVKMetal4CompletionStorage() { [retained release]; }
};

// No queue or submission owner references: idle packs cannot form owner cycles.
struct MVKMetal4ResourcePack {
    // Resource packs remain exclusive through their own GPU-retirement gate.
    // Command memory is separately owned by every primary/tail allocator use.
    id<MTL4CommandBuffer> buffer = nil;
    id<MTLResidencySet> residency = nil;
    bool dynamicResidencyHasAllocations = false;
    // Marker, cached slabs, and bounded eligible native buffers strongly owned
    // below. Membership changes only while the pack is exclusive, never in flight.
    id<MTLResidencySet> stableResidency = nil;
    bool stableResidencyDirty = false;
    MVKMetal4StableAllocationCache stableBuffers;
    id<MTLBuffer> marker = nil;
    // Exclusive to this pack until actual retirement. Only small immutable
    // upload slabs are cached; oversized transient uploads are never pooled.
    std::vector<id<MTLBuffer>> uploadSlabs;
    struct ArgumentTableGroup {
        std::unique_ptr<MVKMetal4ArgumentTables> tables;
        bool computeOnly = false, leased = false;
    };
    std::vector<ArgumentTableGroup> argumentTables;
    // Always empty when idle. Only host capacity is reused; each begin retains
    // a fresh submission state/control block and weak recording identity.
    MVKMetal4ObjectIdentityMap objects;
    NSMutableArray* retained = nil;
    size_t retainedHighWater = 0;
    uint64_t hostStorageBytes() const {
        // Bucket/vector payload accounting only; allocator overhead and opaque
        // Foundation capacity are not reported as known allocated bytes.
        return objects.hostStorageBytes() + stableBuffers.hostStorageBytes();
    }
    uint64_t idleBytes = 0;
    void addStableAllocation(id<MTLBuffer> allocation) {
        [stableResidency addAllocation:allocation];
        stableResidencyDirty = true;
    }
    void commitStableResidency() {
        if (!stableResidencyDirty) { return; }
        [stableResidency commit];
        stableResidencyDirty = false;
    }
    bool cacheStableBuffer(id<MTLResource> resource) {
        const void* key = (const void*)resource;
        if (stableBuffers.touch(key)) { return true; }
        // Only explicit, paired allocation-lifetime registration can admit a
        // native object. Textures, imports, heap aliases and ordinary wrappers
        // have no token and remain in the submission's dynamic set.
        auto token = s_metal4StableBufferLifetimes.get(key);
        if (token.expired() || !stableBuffers.insert(key, std::move(token), resource.allocatedSize)) { return false; }
        [resource retain];
        addStableAllocation((id<MTLBuffer>)resource);
        return true;
    }
    void prepareStableBuffersForRecording() {
        std::vector<id<MTLBuffer>> removed;
        stableBuffers.beginRecording([&](const void* object) {
            auto buffer = (id<MTLBuffer>)object;
            [stableResidency removeAllocation:buffer];
            stableResidencyDirty = true;
            removed.push_back(buffer);
        });
        // Removing residency can take effect immediately. Only a retired,
        // exclusive pack enters here, and set removal commits before releases.
        if (!removed.empty()) {
            commitStableResidency();
            for (auto buffer : removed) { [buffer release]; }
        }
    }
    ~MVKMetal4ResourcePack() {
        [buffer release]; [residency release];
        [stableResidency release]; [marker release];
        [retained release];
        for (auto slab : uploadSlabs) { [slab release]; }
        for (auto& entry : stableBuffers.entries()) { [(id)entry.first release]; }
    }
};

enum class MVKMetal4AllocatorState { Appendable, Sealed, Resetting, DiscardOnly };
enum class MVKMetal4AllocatorUsePhase { Reserved, Recording, Ended, Released };

// No references back to storage/queues/records. Available entries or live uses
// own the epoch; metadata is protected solely by the device pool's mutex.
struct MVKMetal4AllocatorEpoch {
    id<MTLDevice> device = nil;
    id<MTL4CommandAllocator> allocator = nil;
    MVKMetal4AllocatorState state = MVKMetal4AllocatorState::Appendable;
    uint32_t liveUses = 0, recordings = 0;
    uint64_t allocatedBytes = 0, resetAllocatedBytes = 0, idleCharge = 0;
    bool writer = false, available = false;
    ~MVKMetal4AllocatorEpoch() { [allocator release]; [device release]; }
};

// Inline, move-only ownership. Reserved rollback differs from cancellation of
// an actually open native buffer. Owners explicitly dispose that buffer before
// releasing a Recording use; the destructor is only the final safety net.
struct MVKMetal4AllocatorUse {
    std::shared_ptr<MVKMetal4RecordingPoolState> storage;
    std::shared_ptr<MVKMetal4AllocatorEpoch> epoch;
    MVKMetal4AllocatorUsePhase phase = MVKMetal4AllocatorUsePhase::Released;
    bool resetElected = false;
    MVKMetal4AllocatorUse() = default;
    MVKMetal4AllocatorUse(std::shared_ptr<MVKMetal4RecordingPoolState> owner,
                         std::shared_ptr<MVKMetal4AllocatorEpoch> value)
        : storage(std::move(owner)), epoch(std::move(value)), phase(MVKMetal4AllocatorUsePhase::Reserved) {}
    MVKMetal4AllocatorUse(const MVKMetal4AllocatorUse&) = delete;
    MVKMetal4AllocatorUse& operator=(const MVKMetal4AllocatorUse&) = delete;
    MVKMetal4AllocatorUse(MVKMetal4AllocatorUse&& other) noexcept
        : storage(std::move(other.storage)), epoch(std::move(other.epoch)),
          phase(std::exchange(other.phase, MVKMetal4AllocatorUsePhase::Released)),
          resetElected(std::exchange(other.resetElected, false)) {}
    MVKMetal4AllocatorUse& operator=(MVKMetal4AllocatorUse&& other) noexcept {
        if (this != &other) {
            assert(!epoch); // Every move target is an empty owner/retirement slot.
            storage = std::move(other.storage); epoch = std::move(other.epoch);
            phase = std::exchange(other.phase, MVKMetal4AllocatorUsePhase::Released);
            resetElected = std::exchange(other.resetElected, false);
        }
        return *this;
    }
    id<MTL4CommandAllocator> allocator() const { return epoch ? epoch->allocator : nil; }
    void begin(id<MTL4CommandBuffer> buffer);
    void end(); // Only after actual native endCommandBuffer.
    void discardOpen(); // Before the owner disposes native buffer/encoders.
    void release();
    void finishRelease(); // Outside every pool/group/child lock.
    ~MVKMetal4AllocatorUse() { release(); }
};

// Has no queue, submission, command-pool, or callback owner. Outstanding
// recordings keep device storage alive without keeping a queue alive.
struct MVKMetal4RecordingPoolState {
    id<MTLDevice> device = nil;
    std::shared_ptr<MVKMetal4DeviceResidency> deviceResidency;
    std::atomic<bool> poisoned{false};
    std::mutex poolMutex;
    std::vector<std::unique_ptr<MVKMetal4ResourcePack>> primaryPool, tailPool;
    // Same eight-entry and measured-byte budget as the existing host cache.
    // No live retains, callback captures or notification identities enter here.
    std::vector<std::unique_ptr<MVKMetal4CompletionStorage>> completionPool;
    std::vector<std::shared_ptr<MVKMetal4AllocatorEpoch>> availableEpochs;
    MVKMetal4ResourcePoolStats poolStats;
    ~MVKMetal4RecordingPoolState() {
        primaryPool.clear(); tailPool.clear(); completionPool.clear(); availableEpochs.clear();
        [device release];
    }
};

struct MVKMetal4SubmissionGroup;

// This is an enqueued-order proof, never a host observation of GPU completion.
// A queue owned from creation is empty. Only our internal full-prefix pair can
// close a prefix with opaque writes; stage barriers cannot do that.
enum class MVKMetal4CounterProof : uint8_t { Closed, Open, Unknown };
enum class MVKMetal4CounterBoundary : uint8_t { EntryTimestamp, EntryResolve, ResolveAfterWrite };

struct MVKMetal4QueueState {
    uint64_t timelineID = 0;
    id<MTLDevice> device = nil;
    id<MTL4CommandQueue> queue = nil;
    std::shared_ptr<MVKMetal4DeviceResidency> deviceResidency;
    // Feedback never takes submitMutex: even immediate feedback cannot deadlock
    // a thread inside Metal's commit call. stateMutex protects only bookkeeping.
    std::timed_mutex submitMutex;
    std::mutex stateMutex;
    std::condition_variable idle;
    uint64_t pending = 0, completed = 0;
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
    MVKMetal4QueueEncodingStats encodingStats;
    std::shared_ptr<MVKBackendCostStats> costStats = mvkBackendCostStatsEnabled()
        ? std::make_shared<MVKBackendCostStats>("native-metal4") : nullptr;
#endif
    NSError* firstError = nil;
    MVKMetal4CounterProof counterProof = MVKMetal4CounterProof::Closed; // stateMutex; submit order under submitMutex.
    // Exceptional retention only. firstError stops new submissions, so this
    // cannot accumulate events from later normal queue churn.
    NSMutableSet* failedEvents = nil;
    // One listener per native queue. Slots temporarily own batch -> queue
    // cycles, broken at retirement or first poison; notification blocks are weak.
    // A full table falls back to the existing tail, never waits or allocates nodes.
    static constexpr unsigned notificationCapacity = 64;
    MTLSharedEventListener* signalListener = nil;
    std::array<std::shared_ptr<MVKMetal4SubmissionGroup>, notificationCapacity> notificationOwners;
    uint64_t freeNotificationSlots = UINT64_MAX; // Protected by stateMutex.
    std::shared_ptr<MVKMetal4RecordingPool> recordingPool;
    std::shared_ptr<MVKMetal4RecordingPoolState> storage;
    ~MVKMetal4QueueState() {
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
        if (mvkMetal4QueueStatsEnabled()) {
            logEncodingStats("mvk-metal4-queue-stats", encodingStats.encoding, encodingStats.endedBatches,
                             encodingStats.submittedBatches, completed);
        }
#endif
        // Failed queue operations have no normal retirement proof. Keep their
        // event objects until native queue teardown, without retaining batches
        // (which own this state and would create a cycle).
        if (deviceResidency && queue) { [queue removeResidencySet:deviceResidency->residencySet()]; }
        [firstError release]; [queue release]; [failedEvents release]; [signalListener release];
        [device release];
    }
};

namespace {
void removeAllocatorAvailableLocked(MVKMetal4RecordingPoolState& storage,
                                    MVKMetal4AllocatorEpoch& epoch) {
    if (!epoch.available) { return; }
    auto& pool = storage.availableEpochs;
    for (size_t i = 0; i < pool.size(); ++i) {
        if (pool[i].get() != &epoch) { continue; }
        // The caller's use/reset owner strongly holds epoch, so erasing this
        // reference cannot release a native object while poolMutex is held.
        if (i + 1 != pool.size()) { pool[i] = std::move(pool.back()); }
        pool.pop_back();
        storage.poolStats.idleBytes -= epoch.idleCharge;
        epoch.idleCharge = 0; epoch.available = false;
        return;
    }
    assert(false && "Allocator availability membership must be unique.");
}

void discardAllocatorLocked(MVKMetal4RecordingPoolState& storage, MVKMetal4AllocatorEpoch& epoch) {
    removeAllocatorAvailableLocked(storage, epoch);
    if (epoch.state != MVKMetal4AllocatorState::DiscardOnly) { ++storage.poolStats.allocatorDiscarded; }
    epoch.state = MVKMetal4AllocatorState::DiscardOnly;
}

void offerAllocatorLocked(MVKMetal4RecordingPoolState& storage,
                          const std::shared_ptr<MVKMetal4AllocatorEpoch>& epoch) {
    assert(!epoch->writer);
    if (storage.poisoned.load(std::memory_order_acquire)) {
        discardAllocatorLocked(storage, *epoch); return;
    }
    if (epoch->state != MVKMetal4AllocatorState::Appendable) { return; }
    if (!epoch->available && storage.availableEpochs.size() >= MVKMetal4ResourcePoolStats::maxAvailableAllocatorEpochs) {
        epoch->state = MVKMetal4AllocatorState::Sealed;
        if (!epoch->liveUses) { discardAllocatorLocked(storage, *epoch); }
        return;
    }
    // Live epochs cost no idle charge. In particular, an already-available
    // Appendable epoch must be charged when its last GPU/unsubmitted user leaves.
    if (!epoch->liveUses && !epoch->idleCharge) {
        if (epoch->allocatedBytes > MVKMetal4ResourcePoolStats::maxIdleBytes - storage.poolStats.idleBytes) {
            discardAllocatorLocked(storage, *epoch); return;
        }
        epoch->idleCharge = epoch->allocatedBytes;
        storage.poolStats.idleBytes += epoch->idleCharge;
    }
    if (!epoch->available) {
        epoch->available = true;
        storage.availableEpochs.push_back(epoch); // Capacity reserved at creation.
    }
}

// Caller holds poolMutex and has checked poison. Reserve recording service in
// the same critical section as the pack and empty completion capacity.
MVKMetal4AllocatorUse takeAllocatorLocked(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage) {
    auto& available = storage->availableEpochs;
    if (available.empty()) { return {}; }
    size_t selected = available.size() - 1;
    // Prefer already-quiescent storage instead of extending another epoch's
    // live command bytes. Keep the common idle-back path and all-busy fallback
    // LIFO; the existing available limit bounds this metadata-only search.
    if (available[selected]->liveUses) {
        for (size_t i = selected; i > 0;) {
            --i;
            if (!available[i]->liveUses) { selected = i; break; }
        }
    }
    auto epoch = std::move(available[selected]);
    if (selected + 1 != available.size()) { available[selected] = std::move(available.back()); }
    available.pop_back();
    assert(!epoch->writer && epoch->state == MVKMetal4AllocatorState::Appendable);
    storage->poolStats.idleBytes -= epoch->idleCharge;
    epoch->idleCharge = 0; epoch->available = false;
    epoch->writer = true; ++epoch->liveUses;
    ++storage->poolStats.allocatorReused;
    return {storage, std::move(epoch)};
}

MVKMetal4AllocatorUse createAllocatorUse(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage,
                                       NSError** error) {
    // No writer or GPU wait: simultaneous open recordings get different storage.
    auto epoch = std::make_shared<MVKMetal4AllocatorEpoch>();
    epoch->device = [storage->device retain];
    epoch->allocator = [storage->device newCommandAllocator];
    if (!epoch->allocator) { fail(error, 2, @"Could not allocate Metal 4 command storage."); return {}; }
    // Also account for cold reservations cancelled before any native begin.
    // New allocators, like reset allocators, contain no live command bytes.
    epoch->allocatedBytes = [epoch->allocator allocatedSize];
    epoch->resetAllocatedBytes = epoch->allocatedBytes;
    {
        std::lock_guard<std::mutex> lock(storage->poolMutex);
        if (storage->poisoned.load(std::memory_order_acquire)) {
            fail(error, 5, @"Recording storage belongs to a lost device."); return {};
        }
        epoch->writer = true; epoch->liveUses = 1;
        ++storage->poolStats.allocatorCreated;
    }
    return {storage, std::move(epoch)};
}

// No ownership is destroyed under the mutex. Every released use retains its
// epoch until the outside-lock finish pass, including the one reset election.
void releaseAllocatorLocked(MVKMetal4AllocatorUse& use) {
    if (!use.epoch || use.phase == MVKMetal4AllocatorUsePhase::Released) { return; }
    auto& storage = *use.storage;
    auto& epoch = *use.epoch;
    const bool reservedRollback = use.phase == MVKMetal4AllocatorUsePhase::Reserved;
    if (use.phase == MVKMetal4AllocatorUsePhase::Recording) { discardAllocatorLocked(storage, epoch); }
    if (use.phase == MVKMetal4AllocatorUsePhase::Recording || use.phase == MVKMetal4AllocatorUsePhase::Reserved) {
        assert(epoch.writer); epoch.writer = false;
    }
    assert(epoch.liveUses); --epoch.liveUses;
    use.phase = MVKMetal4AllocatorUsePhase::Released;
    if (epoch.liveUses) {
        // No native attachment was begun: return its recording service even
        // while older ended/unsubmitted/GPU users still own the same bytes.
        if (reservedRollback && epoch.state == MVKMetal4AllocatorState::Appendable) {
            offerAllocatorLocked(storage, use.epoch);
        }
        return;
    }
    assert(!epoch.writer);
    if (storage.poisoned.load(std::memory_order_acquire)) { discardAllocatorLocked(storage, epoch); }
    // Reclaim ended command bytes at genuine quiescence as well as at the
    // seal bound. A cold reservation has no ended bytes and needs no reset.
    if (epoch.state == MVKMetal4AllocatorState::Sealed ||
        (epoch.state == MVKMetal4AllocatorState::Appendable && epoch.recordings)) {
        removeAllocatorAvailableLocked(storage, epoch);
        epoch.state = MVKMetal4AllocatorState::Resetting;
        use.resetElected = true;
    } else if (epoch.state == MVKMetal4AllocatorState::Appendable) {
        offerAllocatorLocked(storage, use.epoch);
    }
}

template<class UseAt> void releaseAllocatorUses(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage,
                                                size_t count, UseAt useAt) {
    {
        std::lock_guard<std::mutex> lock(storage->poolMutex);
        for (size_t i = 0; i < count; ++i) { releaseAllocatorLocked(useAt(i)); }
    }
    for (size_t i = 0; i < count; ++i) { useAt(i).finishRelease(); }
}
}

void MVKMetal4AllocatorUse::begin(id<MTL4CommandBuffer> buffer) {
    assert(epoch && phase == MVKMetal4AllocatorUsePhase::Reserved);
    // If native begin throws/fails partway through, cancellation must not infer
    // that no recording attachment exists and reoffer its memory.
    phase = MVKMetal4AllocatorUsePhase::Recording;
    [buffer beginCommandBufferWithAllocator:epoch->allocator];
}

void MVKMetal4AllocatorUse::end() {
    assert(epoch && phase == MVKMetal4AllocatorUsePhase::Recording);
    uint64_t bytes = [epoch->allocator allocatedSize]; // Still the exclusive writer.
    std::lock_guard<std::mutex> lock(storage->poolMutex);
    epoch->allocatedBytes = bytes; ++epoch->recordings;
    epoch->writer = false; phase = MVKMetal4AllocatorUsePhase::Ended;
    const uint64_t growth = bytes > epoch->resetAllocatedBytes ? bytes - epoch->resetAllocatedBytes : 0;
    if (epoch->recordings >= MVKMetal4ResourcePoolStats::maxAllocatorEpochRecordings ||
        growth >= MVKMetal4ResourcePoolStats::maxAllocatorEpochGrowthBytes) {
        epoch->state = MVKMetal4AllocatorState::Sealed;
    }
    offerAllocatorLocked(*storage, epoch);
}

void MVKMetal4AllocatorUse::discardOpen() {
    if (!epoch || phase != MVKMetal4AllocatorUsePhase::Recording) { return; }
    std::lock_guard<std::mutex> lock(storage->poolMutex);
    discardAllocatorLocked(*storage, *epoch);
}

void MVKMetal4AllocatorUse::finishRelease() {
    if (!epoch) { return; }
    assert(phase == MVKMetal4AllocatorUsePhase::Released);
    if (resetElected) {
        [epoch->allocator reset];
        uint64_t bytes = [epoch->allocator allocatedSize];
        {
            std::lock_guard<std::mutex> lock(storage->poolMutex);
            assert(!epoch->writer && !epoch->liveUses && epoch->state == MVKMetal4AllocatorState::Resetting);
            ++storage->poolStats.allocatorResets;
            epoch->allocatedBytes = bytes; epoch->resetAllocatedBytes = bytes; epoch->recordings = 0;
            // Poison may overlap an already-elected, zero-user reset, but never
            // its publication. Retained native heap capacity is reusable memory,
            // not new growth: offerAllocatorLocked applies the total idle budget.
            if (storage->poisoned.load(std::memory_order_acquire)) {
                discardAllocatorLocked(*storage, *epoch);
            } else {
                epoch->state = MVKMetal4AllocatorState::Appendable;
                offerAllocatorLocked(*storage, epoch);
            }
        }
        resetElected = false;
    }
    epoch.reset(); storage.reset(); // Native destruction is outside all locks.
}

void MVKMetal4AllocatorUse::release() {
    if (!epoch) { return; }
    {
        std::lock_guard<std::mutex> lock(storage->poolMutex);
        releaseAllocatorLocked(*this);
    }
    finishRelease();
}

// Value-owned tail: no additional heap node for its allocator use. Open failure
// disposes native state before dropping its writer; ended cancellation is safe.
struct MVKMetal4TailRecording {
    std::unique_ptr<MVKMetal4ResourcePack> pack;
    MVKMetal4AllocatorUse allocatorUse;
    MVKMetal4TailRecording() = default;
    MVKMetal4TailRecording(const MVKMetal4TailRecording&) = delete;
    MVKMetal4TailRecording& operator=(const MVKMetal4TailRecording&) = delete;
    MVKMetal4TailRecording(MVKMetal4TailRecording&&) = default;
    MVKMetal4TailRecording& operator=(MVKMetal4TailRecording&& other) noexcept {
        reset(); pack = std::move(other.pack); allocatorUse = std::move(other.allocatorUse); return *this;
    }
    explicit operator bool() const { return bool(pack); }
    void reset() {
        allocatorUse.discardOpen(); pack.reset(); allocatorUse.release();
    }
    ~MVKMetal4TailRecording() { reset(); }
};

namespace {
std::unique_ptr<MVKMetal4ResourcePack> acquirePack(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage,
                                                bool isTail, NSError** error,
                                                MVKMetal4AllocatorUse& allocatorUse,
                                                std::unique_ptr<MVKMetal4CompletionStorage>* completionStorage = nullptr) {
    assert(!allocatorUse.epoch);
    std::unique_ptr<MVKMetal4ResourcePack> reused;
    {
        std::lock_guard<std::mutex> lock(storage->poolMutex);
        if (storage->poisoned.load(std::memory_order_acquire)) {
            fail(error, 5, @"Recording storage belongs to a lost device."); return nullptr;
        }
        // begin() acquires both kinds of empty capacity with the existing lock.
        if (!isTail && completionStorage && !storage->completionPool.empty()) {
            *completionStorage = std::move(storage->completionPool.back()); storage->completionPool.pop_back();
            storage->poolStats.idleBytes -= (*completionStorage)->hostStorageBytes();
        }
        auto& pool = isTail ? storage->tailPool : storage->primaryPool;
        if (!pool.empty()) {
            reused = std::move(pool.back()); pool.pop_back();
            storage->poolStats.idleBytes -= reused->idleBytes;
            ++(isTail ? storage->poolStats.tailReused : storage->poolStats.primaryReused);
            if (!isTail && reused->retained) { ++storage->poolStats.hostStorageReused; }
        }
        allocatorUse = takeAllocatorLocked(storage);
    }
    // Cold creation and every failure unwind remain outside the pool lock.
    // The caller owns Reserved rollback even if subsequent pack creation fails.
    if (!allocatorUse.epoch) { allocatorUse = createAllocatorUse(storage, error); }
    if (!allocatorUse.epoch) { return nullptr; }
    if (reused) {
        if (!isTail) { reused->prepareStableBuffersForRecording(); }
        return reused;
    }
    // Pool exhaustion never waits for GPU completion or resets an in-flight pack.
    auto pack = std::make_unique<MVKMetal4ResourcePack>();
    if (!isTail) {
        pack->uploadSlabs.reserve(MVKMetal4ResourcePoolStats::maxUploadSlabsPerPack);
        pack->argumentTables.reserve(MVKMetal4ResourcePoolStats::maxArgumentTableGroupsPerPack);
    }
    pack->buffer = [storage->device newCommandBuffer];
    pack->marker = [storage->device newBufferWithLength:4 options:MTLResourceStorageModeShared];
    MTLResidencySetDescriptor* desc = [MTLResidencySetDescriptor new];
    if (!isTail) {
        desc.label = @"MoltenVK Metal 4 submission resources";
        pack->residency = [storage->device newResidencySetWithDescriptor:desc error:error];
    }
    if (isTail || pack->residency) {
        desc.label = isTail ? @"MoltenVK Metal 4 owned retirement storage" : @"MoltenVK Metal 4 owned upload storage";
        pack->stableResidency = [storage->device newResidencySetWithDescriptor:desc error:error];
    }
    [desc release];
    if (!pack->buffer || !pack->marker || !pack->stableResidency ||
        (!isTail && !pack->residency)) {
        if (!error || !*error) { fail(error, 2, @"Could not allocate Metal 4 submission resource pack."); }
        return nullptr;
    }
    pack->addStableAllocation(pack->marker);
    {
        std::lock_guard<std::mutex> lock(storage->poolMutex);
        ++(isTail ? storage->poolStats.tailCreated : storage->poolStats.primaryCreated);
    }
    return pack;
}

// Only terminal GPU retirement or cancellation of an ended, unsubmitted buffer
// may call this. No callbacks, Objective-C releases or Metal calls under poolMutex.
void publishIdleStorage(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage,
                        std::unique_ptr<MVKMetal4ResourcePack> pack, bool isTail,
                        std::unique_ptr<MVKMetal4CompletionStorage> completion) {
    std::lock_guard<std::mutex> poolLock(storage->poolMutex);
    // Failure may arrive during reset/preparation. Publish neither kind of
    // reusable storage after observed poison; destruction occurs outside locks.
    if (storage->poisoned.load(std::memory_order_acquire)) { return; }
    constexpr uint64_t cap = MVKMetal4ResourcePoolStats::maxIdleBytes;
    if (pack) {
        auto& pool = isTail ? storage->tailPool : storage->primaryPool;
        if (pool.size() < MVKMetal4ResourcePoolStats::maxIdlePacksPerKind &&
            pack->idleBytes <= cap - storage->poolStats.idleBytes) {
            storage->poolStats.idleBytes += pack->idleBytes;
            pool.push_back(std::move(pack));
        }
    }
    if (completion) {
        uint64_t bytes = completion->hostStorageBytes();
        if (storage->completionPool.size() < MVKMetal4ResourcePoolStats::maxIdlePacksPerKind &&
            bytes <= cap - storage->poolStats.idleBytes) {
            storage->poolStats.idleBytes += bytes;
            storage->completionPool.push_back(std::move(completion));
        }
    }
}

void recyclePack(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage,
                 std::unique_ptr<MVKMetal4ResourcePack> pack, bool isTail,
                 std::unique_ptr<MVKMetal4CompletionStorage> completion = nullptr) {
    if (!pack) {
        if (completion) { publishIdleStorage(storage, nullptr, false, std::move(completion)); }
        return;
    }
    if (storage->poisoned.load(std::memory_order_acquire)) { return; }
    uint64_t residencyBytes = 0;
    if (!isTail) {
        // This pack's GPU feedback (or ended cancellation) is already proved.
        // Tables and dynamic residency are independent of shared command memory.
        for (auto& group : pack->argumentTables) {
            if (!group.tables->resetForReuse()) { return; }
            group.leased = false;
        }
        if (pack->dynamicResidencyHasAllocations) {
            [pack->residency removeAllAllocations];
            [pack->residency commit];
            pack->dynamicResidencyHasAllocations = false;
        }
        residencyBytes = pack->residency.allocatedSize;
    }
    uint64_t stableResidencyBytes = pack->stableResidency.allocatedSize;
    constexpr uint64_t cap = MVKMetal4ResourcePoolStats::maxIdleBytes;
    if (residencyBytes > cap || stableResidencyBytes > cap - residencyBytes) { return; }
    // Count the committed set's reported footprint once. It covers the marker
    // cached slabs and cached native buffers; it may include internal allocations. Adding
    // those same buffers separately would count their storage a second time.
    pack->idleBytes = residencyBytes + stableResidencyBytes;
    if (!isTail) {
        uint64_t hostBytes = pack->hostStorageBytes();
        if (hostBytes > cap - pack->idleBytes) { return; }
        pack->idleBytes += hostBytes;
        for (auto& group : pack->argumentTables) {
            uint64_t bytes = sizeof(MVKMetal4ArgumentTables) + group.tables->retainedHostByteCapacity();
            if (bytes > cap - pack->idleBytes) { return; }
            pack->idleBytes += bytes;
        }
    }
    publishIdleStorage(storage, std::move(pack), isTail, std::move(completion));
    // Excess idle capacity is destroyed here, after releasing the pool lock.
}

void recycleCompletionStorage(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage,
                              std::unique_ptr<MVKMetal4CompletionStorage> completion) {
    if (completion) { publishIdleStorage(storage, nullptr, false, std::move(completion)); }
}
}

struct MVKMetal4SubmissionState {
    uint64_t timelineID = 0;
    // Published only by submit's exclusive adoption claim. Recording storage
    // does not require a queue; the weak diagnostic link is never an owner.
    std::shared_ptr<MVKMetal4QueueState> owner;
    std::shared_ptr<MVKMetal4RecordingPoolState> storage;
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
    std::weak_ptr<MVKMetal4QueueState> diagnosticQueue;
#endif
    std::unique_ptr<MVKMetal4ResourcePack> pack;
    MVKMetal4AllocatorUse allocatorUse;
    // Borrowed from this record's use, detached before releasing that use.
    id<MTL4CommandAllocator> allocator = nil;
    id<MTL4CommandBuffer> buffer = nil;
    // Borrowed from pack/retained. Metadata describes actual native commands,
    // not CPU query activation. Eligibility is recomputed at each submission.
    struct CounterPrefix {
        id<MTL4CommandBuffer> buffer;
        MVKMetal4CounterBoundary following;
        bool writes, timestampBridge;
    };
    std::vector<CounterPrefix> counterPrefixes;
    bool counterBufferWrites = false;
    bool counterPrefixComplete = false, counterWritesPending = false;
    bool externalCounterWait = false;
    bool counterBufferMayHaveWork = false, fullCounterEntryRequired = false;
    id<MTLResidencySet> residency = nil;
    NSMutableArray* retained = nil;
    NSMutableArray* operationRetained = nil;
    size_t operationRetainedHighWater = 0;
    std::unique_ptr<MVKMetal4CompletionStorage> completionStorage;
    using ObjectIdentity = MVKMetal4ObjectIdentity;
    MVKMetal4ObjectIdentityMap objects;
    MVKMetal4PreparedGroupCache preparedGroups;
    MVKMetal4RecordingDependencies dependencies;
    size_t retainedHighWater = 0;
    MVKMetal4ResourceRegistrationStats registrationStats;
    std::vector<std::shared_ptr<void>> deviceResidencyLeases;
    id<MTLBuffer> uploadArena = nil; // Owned by retained and optionally pack until retirement.
    NSUInteger uploadArenaCursor = 0;
    size_t uploadSlabIndex = 0;
    mutable std::mutex mutex;
    std::condition_variable done;
    Phase phase = Phase::Recording;
    NSError* error = nil;
    std::vector<std::function<void()>> cleanup;
    std::vector<std::function<void()>> hostStateActions;
    std::vector<std::function<void(NSError*)>> errorHandlers, completedHandlers;
    bool errorHandlersRunning = false;
    std::vector<MVKMetal4EventValue> waits, signals;
    std::vector<id<MTLDrawable>> drawables;
    std::vector<MVKMetal4Presentation> presentations;
    // Overflow leases retain their native tables until the same GPU retirement,
    // but never increase the idle cache's bounded table group count.
    std::vector<MVKMetal4ResourcePack::ArgumentTableGroup> transientArgumentTables;
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
    MVKMetal4EncodingStats encodingStats;
    bool costPresentation = false; // Set before publication; classification only.
#endif

    // Caller holds mutex while recording. Retention and residency are distinct:
    // an object retained for another purpose must still be registered resident.
    ObjectIdentity& retainUnique(id object) {
        auto result = objects.try_emplace((const void*)object);
        if (!result.first->second.gpuRetained) {
            [retained addObject:object];
            result.first->second.gpuRetained = true;
        }
        if (result.second) { ++registrationStats.retainedObjects; }
        return result.first->second;
    }
    // Recording-only deduplication shares the identity map, but the actual
    // event/drawable owner is independent of the map and GPU retained array.
    bool retainOperationUnique(id object) {
        if (!operationRetained) {
            if (!completionStorage) { completionStorage = std::make_unique<MVKMetal4CompletionStorage>(); }
            operationRetained = [[NSMutableArray alloc] initWithCapacity:8];
            if (!operationRetained) { return false; }
        }
        auto result = objects.try_emplace((const void*)object);
        if (!result.first->second.operationRetained) {
            [operationRetained addObject:object];
            result.first->second.operationRetained = true;
        }
        if (result.second) { ++registrationStats.retainedObjects; }
        return true;
    }
    ObjectIdentity& addResident(id<MTLResource> resource, bool stableBufferCandidate = true,
                                MVKMetal4ResourceKind kind = MVKMetal4ResourceKind::Unknown) {
        auto& identity = retainUnique(resource);
        if (!identity.resident) {
            auto lease = storage->deviceResidency ? storage->deviceResidency->leaseWithKind(resource, kind) : std::shared_ptr<void>{};
            if (lease) {
                deviceResidencyLeases.push_back(std::move(lease));
                ++registrationStats.deviceResidencyLeases;
            } else if (!stableBufferCandidate || !pack->cacheStableBuffer(resource)) {
                [residency addAllocation:resource];
                pack->dynamicResidencyHasAllocations = true;
            }
            identity.resident = true;
            ++registrationStats.residentResources;
        }
        return identity;
    }
    // Explicit owned-storage path only; never infer stable ownership from a
    // caller's pointer. The pack survives independently until GPU retirement.
    void addStableResident(id<MTLBuffer> resource) {
        auto& identity = retainUnique(resource);
        if (!identity.resident) {
            identity.resident = true;
            ++registrationStats.residentResources;
        }
    }
    void forgetIdentities() {
        objects.clear();
        preparedGroups.clear();
        uploadArena = nil; uploadArenaCursor = 0; uploadSlabIndex = 0;
    }
    void clearGPUReferences() {
        retainedHighWater = std::max(retainedHighWater, objects.size());
        forgetIdentities();
        deviceResidencyLeases.clear();
        counterPrefixes.clear();
        [retained removeAllObjects];
    }
    void clearOperationReferences() {
        operationRetainedHighWater = std::max(operationRetainedHighWater, size_t(operationRetained.count));
        [operationRetained removeAllObjects];
        presentations.clear(); // Destroy beforePresent captures before reuse.
        waits.clear(); signals.clear(); drawables.clear();
    }
    template<class T> static void trimEmptyVector(std::vector<T>& values) {
        if (values.capacity() > MVKMetal4ResourcePoolStats::maxHostVectorEntries) {
            std::vector<T>().swap(values);
        }
    }
    // Only after GPU storage retirement or ended-unsubmitted cancellation, after
    // cleanup has run. No live identity, Objective-C retain or callback moves.
    void cacheEmptyHostStorage(MVKMetal4ResourcePack& destination) {
        if (objects.bucket_count() > MVKMetal4ResourcePoolStats::maxHostIdentityBuckets) {
            decltype(objects)().swap(objects);
        }
        if (retainedHighWater > MVKMetal4ResourcePoolStats::maxRetainedHostObjects) {
            [retained release]; retained = nil; retainedHighWater = 0;
        }
        destination.objects.swap(objects);
        destination.retained = retained; retained = nil;
        destination.retainedHighWater = retainedHighWater; retainedHighWater = 0;
        if (destination.hostStorageBytes() > MVKMetal4ResourcePoolStats::maxHostStoragePayloadBytes) {
            decltype(destination.objects)().swap(destination.objects);
        }
    }
    // Queue-operation ownership and callback/vector capacity remain exclusive
    // to this fresh state until full semantic completion or cancellation.
    void cacheEmptyCompletionStorage() {
        if (!completionStorage) { return; }
        trimEmptyVector(waits); trimEmptyVector(signals);
        trimEmptyVector(drawables); trimEmptyVector(presentations);
        if (operationRetainedHighWater > MVKMetal4ResourcePoolStats::maxRetainedHostObjects) {
            [operationRetained release]; operationRetained = nil; operationRetainedHighWater = 0;
        }
        completionStorage->waits.swap(waits); completionStorage->signals.swap(signals);
        completionStorage->drawables.swap(drawables); completionStorage->presentations.swap(presentations);
        completionStorage->retained = operationRetained; operationRetained = nil;
        completionStorage->retainedHighWater = operationRetainedHighWater; operationRetainedHighWater = 0;
        if (completionStorage->hostStorageBytes() > MVKMetal4ResourcePoolStats::maxHostStoragePayloadBytes) {
            decltype(completionStorage->waits)().swap(completionStorage->waits);
            decltype(completionStorage->signals)().swap(completionStorage->signals);
            decltype(completionStorage->drawables)().swap(completionStorage->drawables);
            decltype(completionStorage->presentations)().swap(completionStorage->presentations);
        }
    }

    ~MVKMetal4SubmissionState() {
        // Submitted state is retained by Metal's feedback block and, when work
        // feedback arrives first, its eligible notification owner slot. Neither
        // releases GPU storage before its feedback/scheduling gate. Queue-operation
        // retains and semantic callbacks independently survive signal observation.
        // An unsubmitted batch still owns cleanup obligations (e.g. pool leases).
        for (auto& action : cleanup) { action(); }
        cleanup.clear();
        clearGPUReferences();
        clearOperationReferences();
        buffer = nil; allocator = nil; residency = nil;
        // Recording cancellation is intentionally destroyed, never reset while
        // an encoder might still be open. Ended cancellation has no GPU owner.
        if (phase == Phase::Ended) {
            allocatorUse.release();
            if (pack) { cacheEmptyHostStorage(*pack); }
            cacheEmptyCompletionStorage();
            recyclePack(storage, std::move(pack), false, std::move(completionStorage));
        } else {
            // The prepared encoder's owner disposes its encoders before this
            // state. Explicitly dispose our native buffer before its writer use;
            // member destruction order must not determine allocator safety.
            allocatorUse.discardOpen();
            pack.reset();
            allocatorUse.release();
        }
        [retained release]; retained = nil;
        [operationRetained release]; operationRetained = nil;
        [error release];
    }
};

// A single queue adoption/feedback owner for an ordered array of independent
// recordings. Children never own this object. Retired GPU storage and pending
// signal observation remain separate, just as for the length-one path.
struct MVKMetal4SubmissionGroup {
    struct Retirement {
        std::vector<std::function<void()>> cleanup;
        std::vector<std::function<void(NSError*)>> errors, completed;
        std::unique_ptr<MVKMetal4ResourcePack> pack;
        MVKMetal4AllocatorUse allocatorUse;
    };
    std::shared_ptr<MVKMetal4QueueState> owner;
    std::vector<std::shared_ptr<MVKMetal4SubmissionState>> children;
    // Preallocated before publication; callbacks only swap existing ownership.
    std::vector<Retirement> retirement;
    std::vector<id<MTL4CommandBuffer>> workBuffers;
    struct WorkRange { size_t first, count; bool fullCounterWait, containsElidedEntry; };
    // No extra range/event/feedback storage for the ordinary single commit.
    std::vector<WorkRange> workRanges;
    std::vector<uint8_t> rangeFeedback;
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
    std::vector<double> rangeCommitHosts;
#endif
    size_t remainingRangeFeedback = 0;
    id<MTLEvent> counterEvent = nil;
    mutable std::mutex mutex;
    Phase phase = Phase::Ended;
    NSError* error = nil;
    bool workFeedbackDone = false, tailFeedbackDone = false, submitFinished = false;
    bool errorHandlersRunning = false;
    GPUStorage gpuStorage = GPUStorage::InUse;
    SignalNotification signalNotification = SignalNotification::None;
    uint64_t notificationGeneration = 0;
    unsigned notificationSlot = MVKMetal4QueueState::notificationCapacity;
    const MVKMetal4EventValue* notificationSignal = nullptr;
    MVKMetal4TailRecording tail;
    uint64_t timelineID = 0;
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
    double workCommitHost = 0, tailCommitHost = 0;
    bool costPresentation = false;
#endif
    ~MVKMetal4SubmissionGroup() { [counterEvent release]; [error release]; }
};

namespace {
// Reserve only a mask bit during preparation. The strong owner is published
// atomically with the whole group's Submitted/pending state.
struct NotificationSlotReservation {
    std::shared_ptr<MVKMetal4QueueState> queue;
    unsigned slot = MVKMetal4QueueState::notificationCapacity;
    explicit NotificationSlotReservation(std::shared_ptr<MVKMetal4QueueState> owner)
        : queue(std::move(owner)) {}
    bool reserve() {
        std::lock_guard<std::mutex> lock(queue->stateMutex);
        if (queue->firstError || !queue->signalListener || !queue->freeNotificationSlots) { return false; }
        slot = __builtin_ctzll(queue->freeNotificationSlots);
        queue->freeNotificationSlots &= ~(uint64_t{1} << slot);
        return true;
    }
    void release() {
        if (slot == MVKMetal4QueueState::notificationCapacity) { return; }
        {
            std::lock_guard<std::mutex> lock(queue->stateMutex);
            if (!queue->notificationOwners[slot]) { queue->freeNotificationSlots |= uint64_t{1} << slot; }
        }
        slot = MVKMetal4QueueState::notificationCapacity;
    }
    ~NotificationSlotReservation() { release(); }
};

// Every group acquires child mutexes in address order, independent of its work
// order and destination queue. Storage for these locks is allocated before claim.
struct SubmissionChildLocks {
    // Declare each strong owner before its lock so destruction unlocks first.
    std::shared_ptr<MVKMetal4SubmissionState> single;
    std::unique_lock<std::mutex> singleHeld;
    std::vector<std::shared_ptr<MVKMetal4SubmissionState>> ordered;
    std::vector<std::unique_lock<std::mutex>> held;
    explicit SubmissionChildLocks(const std::vector<std::shared_ptr<MVKMetal4SubmissionState>>& children) {
        if (children.size() == 1) { single = children.front(); return; }
        ordered = children;
        held.resize(children.size());
        std::sort(ordered.begin(), ordered.end(), [](const auto& a, const auto& b) {
            return std::less<MVKMetal4SubmissionState*>{}(a.get(), b.get());
        });
    }
    bool hasDuplicates() const {
        for (size_t i = 1; i < ordered.size(); ++i) {
            if (ordered[i - 1] == ordered[i]) { return true; }
        }
        return false;
    }
    void lock() {
        if (single) { singleHeld = std::unique_lock<std::mutex>(single->mutex); return; }
        for (size_t i = 0; i < ordered.size(); ++i) { held[i] = std::unique_lock<std::mutex>(ordered[i]->mutex); }
    }
    void unlock() {
        if (single) { singleHeld.unlock(); return; }
        for (size_t i = held.size(); i; --i) { held[i - 1].unlock(); }
    }
};

// Caller holds the group mutex. Move all first-error handlers before allowing
// any retirement election; errors wake child waiters without releasing storage.
bool publishGroupError(const std::shared_ptr<MVKMetal4SubmissionGroup>& group, NSError* error) {
    if (group->error) { return false; }
    group->error = [error retain];
    bool hasHandlers = false;
    for (size_t i = 0; i < group->children.size(); ++i) {
        auto& batch = group->children[i];
        std::lock_guard<std::mutex> lock(batch->mutex);
        if (!batch->error) { batch->error = [error retain]; }
        group->retirement[i].errors.swap(batch->errorHandlers);
        hasHandlers = hasHandlers || !group->retirement[i].errors.empty();
    }
    group->errorHandlersRunning = hasHandlers;
    return hasHandlers;
}

void notifyGroupWaiters(const std::shared_ptr<MVKMetal4SubmissionGroup>& group) {
    for (auto& batch : group->children) { batch->done.notify_all(); }
    group->owner->idle.notify_all();
}

void runGroupErrorHandlers(const std::shared_ptr<MVKMetal4SubmissionGroup>& group) {
    for (size_t i = 0; i < group->children.size(); ++i) {
        auto& handlers = group->retirement[i].errors;
        for (auto& handler : handlers) { handler(group->children[i]->error); }
        handlers.clear();
    }
    std::lock_guard<std::mutex> lock(group->mutex);
    group->errorHandlersRunning = false;
}

// All native work, the one tail (when present), and finished scheduling protect
// every recording's allocator use. Actual-event observation can retain semantic
// owners after GPU storage is reclaimed. Mandatory cleanup for ALL children
// precedes ALL workload completion callbacks, including a final Vulkan fence.
void retireIfReady(std::shared_ptr<MVKMetal4SubmissionGroup> group) {
    auto queue = group->owner;
    std::shared_ptr<MVKMetal4SubmissionGroup> notificationOwner;
    MVKMetal4TailRecording tail;
    bool reclaimGPU = false, completeNow = false;
    {
        std::lock_guard<std::mutex> lock(group->mutex);
        if (group->phase != Phase::Submitted || !group->submitFinished ||
            !group->workFeedbackDone || !group->tailFeedbackDone || group->errorHandlersRunning ||
            group->gpuStorage == GPUStorage::Reclaiming) { return; }
        completeNow = group->signalNotification != SignalNotification::Pending;
        if (!completeNow && group->gpuStorage == GPUStorage::Reclaimed) { return; }
        if (group->signalNotification != SignalNotification::None) {
            std::lock_guard<std::mutex> queueLock(queue->stateMutex);
            if (queue->firstError &&
                (group->signalNotification != SignalNotification::Failed || !group->error)) { return; }
            if (completeNow && group->notificationSlot < MVKMetal4QueueState::notificationCapacity) {
                auto& owner = queue->notificationOwners[group->notificationSlot];
                if (owner.get() == group.get()) {
                    notificationOwner = std::move(owner);
                    queue->freeNotificationSlots |= uint64_t{1} << group->notificationSlot;
                }
            }
            if (completeNow) { group->notificationSlot = MVKMetal4QueueState::notificationCapacity; }
        }
        if (completeNow) { group->phase = Phase::Retiring; }
        if (group->gpuStorage == GPUStorage::InUse) {
            group->gpuStorage = GPUStorage::Reclaiming;
            reclaimGPU = true;
            tail = std::move(group->tail);
        }
        for (size_t i = 0; i < group->children.size(); ++i) {
            auto& batch = group->children[i];
            auto& retired = group->retirement[i];
            std::lock_guard<std::mutex> childLock(batch->mutex);
            if (completeNow) {
                batch->phase = Phase::Retiring;
                retired.completed.swap(batch->completedHandlers);
            }
            if (reclaimGPU) {
                retired.cleanup.swap(batch->cleanup);
                retired.pack = std::move(batch->pack);
                retired.allocatorUse = std::move(batch->allocatorUse);
                batch->buffer = nil; batch->allocator = nil; batch->residency = nil;
            }
        }
    }
    notificationOwner.reset();
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
    auto* timeline = mvkBackendTimeline();
    const uint64_t groupID = group->timelineID, queueID = queue->timelineID;
    double phaseStart = timeline ? timeline->clock() : 0;
    if (timeline && completeNow) {
        timeline->record(MVKBackendTimelineKind::RetireReady, phaseStart, phaseStart, groupID, queueID);
    }
#endif
    if (reclaimGPU) {
        for (size_t i = 0; i < group->children.size(); ++i) {
            auto& batch = group->children[i];
            auto& cleanup = group->retirement[i].cleanup;
            for (auto& action : cleanup) { action(); }
            cleanup.clear();
            batch->clearGPUReferences();
            batch->transientArgumentTables.clear();
        }
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
        if (timeline) {
            double now = timeline->clock();
            timeline->record(MVKBackendTimelineKind::MandatoryCleanup, phaseStart, now, groupID, queueID);
            phaseStart = now;
        }
#endif
    }
    if (completeNow) {
        {
            std::lock_guard<std::mutex> lock(queue->stateMutex);
            if (queue->firstError) {
                if (group->counterEvent) { [queue->failedEvents addObject:group->counterEvent]; }
                for (auto& batch : group->children) {
                    for (auto& event : batch->waits) { [queue->failedEvents addObject:event.event]; }
                    for (auto& event : batch->signals) { [queue->failedEvents addObject:event.event]; }
                }
            }
        }
        for (size_t i = 0; i < group->children.size(); ++i) {
            auto& batch = group->children[i];
            batch->clearOperationReferences();
            auto& handlers = group->retirement[i].completed;
            for (auto& handler : handlers) { handler(batch->error); }
            handlers.clear();
        }
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
        if (timeline) {
            double now = timeline->clock();
            timeline->record(MVKBackendTimelineKind::CompletionHandlers, phaseStart, now, groupID, queueID);
            phaseStart = now;
        }
#endif
    }
    if (reclaimGPU) {
        // One pool lock for all uses in this already-proven group. Shared epochs
        // reset only on their last user; callbacks have already run independently
        // of unrelated records and of this cache/reset work. No allocations here.
        const size_t children = group->retirement.size();
        releaseAllocatorUses(queue->storage, children + (tail ? 1 : 0),
            [&](size_t i) -> MVKMetal4AllocatorUse& {
                return i < children ? group->retirement[i].allocatorUse : tail.allocatorUse;
            });
        for (size_t i = 0; i < group->children.size(); ++i) {
            auto& batch = group->children[i];
            auto& pack = group->retirement[i].pack;
            if (pack) { batch->cacheEmptyHostStorage(*pack); }
            if (completeNow) { batch->cacheEmptyCompletionStorage(); }
            recyclePack(batch->storage, std::move(pack), false,
                        completeNow ? std::move(batch->completionStorage) : nullptr);
        }
        recyclePack(queue->storage, std::move(tail.pack), true);
        {
            std::lock_guard<std::mutex> lock(group->mutex);
            group->gpuStorage = GPUStorage::Reclaimed;
        }
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
        if (timeline) {
            timeline->record(MVKBackendTimelineKind::CacheRecycle, phaseStart, timeline->clock(), groupID, queueID);
        }
#endif
    }
    if (!completeNow) {
        retireIfReady(group); // Recheck a signal/error arriving during cleanup.
        return;
    }
    if (!reclaimGPU) {
        for (auto& batch : group->children) {
            batch->cacheEmptyCompletionStorage();
            recycleCompletionStorage(batch->storage, std::move(batch->completionStorage));
        }
    }
    for (auto& batch : group->children) {
        std::lock_guard<std::mutex> lock(batch->mutex);
        batch->phase = Phase::Completed;
    }
    {
        std::lock_guard<std::mutex> lock(group->mutex);
        std::lock_guard<std::mutex> queueLock(queue->stateMutex);
        group->phase = Phase::Completed;
        --queue->pending; ++queue->completed;
        globalCompletedSubmissions.fetch_add(1, std::memory_order_relaxed);
    }
    notifyGroupWaiters(group);
}

void recordSignalNotification(const std::shared_ptr<MVKMetal4SubmissionGroup>& group, uint64_t generation) {
    {
        std::lock_guard<std::mutex> lock(group->mutex);
        if (group->phase != Phase::Submitted || group->notificationGeneration != generation ||
            group->signalNotification != SignalNotification::Pending) { return; }
        std::lock_guard<std::mutex> queueLock(group->owner->stateMutex);
        if (group->owner->firstError) { return; }
        group->signalNotification = SignalNotification::Succeeded;
    }
    retireIfReady(group);
}

// Queue -> group cycles are detached under stateMutex, then errors are published
// under group -> child locks outside it. GPU feedback remains mandatory.
void failSignalNotificationOwners(const std::shared_ptr<MVKMetal4QueueState>& queue, NSError* error) {
    std::array<std::shared_ptr<MVKMetal4SubmissionGroup>, MVKMetal4QueueState::notificationCapacity> failed;
    NSError* actualError;
    {
        std::lock_guard<std::mutex> lock(queue->stateMutex);
        if (!queue->firstError) { queue->firstError = [error retain]; }
        queue->counterProof = MVKMetal4CounterProof::Unknown;
        queue->storage->poisoned.store(true, std::memory_order_release);
        actualError = [queue->firstError retain];
        failed.swap(queue->notificationOwners);
        queue->freeNotificationSlots = UINT64_MAX;
    }
    queue->idle.notify_all();
    for (auto& group : failed) {
        if (!group) { continue; }
        bool runErrors = false;
        {
            std::lock_guard<std::mutex> lock(group->mutex);
            if (group->phase != Phase::Submitted || group->signalNotification == SignalNotification::None) { continue; }
            runErrors = publishGroupError(group, actualError);
            group->signalNotification = SignalNotification::Failed;
            group->notificationSlot = MVKMetal4QueueState::notificationCapacity;
        }
        notifyGroupWaiters(group);
        if (runErrors) { runGroupErrorHandlers(group); }
        retireIfReady(group);
    }
    [actualError release];
}

void recordFeedback(const std::shared_ptr<MVKMetal4SubmissionGroup>& group,
                    id<MTL4CommitFeedback> feedback, bool isTail, size_t workRange = 0,
                    uint64_t costQueue = 0, uint32_t costFlags = 0, double costCallback = 0) {
#if !MVK_ENABLE_CUSTOM_DIAGNOSTICS
    (void)costQueue; (void)costFlags; (void)costCallback;
#endif
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
    // Record every delivery before the existing duplicate/phase checks and lock.
    // Numeric category was copied before publication; no retirement-owned data read.
    if (auto* capture = mvkBackendCostTimeline()) {
        capture->feedback(group->timelineID, costQueue, workRange,
            costFlags | (feedback.error ? MVKCostError : 0u),
            feedback.GPUStartTime, feedback.GPUEndTime, costCallback);
    }
#endif
    auto queue = group->owner;
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
    auto cost = queue->costStats;
    auto* timeline = mvkBackendTimeline();
    double callbackHost = (cost || timeline) ? MVKBackendCostStats::hostSeconds() : 0, commitHost = 0;
#endif
    bool runErrors = false;
    {
        std::lock_guard<std::mutex> lock(group->mutex);
        if (group->phase != Phase::Submitted) { return; }
        if (isTail ? group->tailFeedbackDone : group->rangeFeedback.empty()
            ? (workRange != 0 || group->workFeedbackDone)
            : (workRange >= group->rangeFeedback.size() || group->rangeFeedback[workRange])) { return; }
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
        if (cost || timeline) {
            commitHost = isTail ? group->tailCommitHost : group->rangeCommitHosts.empty()
                ? group->workCommitHost : group->rangeCommitHosts[workRange];
        }
#endif
        if (feedback.error) {
            runErrors = publishGroupError(group, feedback.error);
            std::lock_guard<std::mutex> queueLock(queue->stateMutex);
            if (!queue->firstError) { queue->firstError = [feedback.error retain]; }
            queue->counterProof = MVKMetal4CounterProof::Unknown;
            queue->storage->poisoned.store(true, std::memory_order_release);
        }
        if (isTail) { group->tailFeedbackDone = true; }
        else if (group->rangeFeedback.empty()) { group->workFeedbackDone = true; }
        else {
            group->rangeFeedback[workRange] = 1;
            group->workFeedbackDone = --group->remainingRangeFeedback == 0;
        }
    }
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
    if (timeline) {
        double start = feedback.GPUStartTime, end = feedback.GPUEndTime;
        bool validGPU = !feedback.error && std::isfinite(start) && std::isfinite(end) &&
            start > 0 && end >= start && start >= commitHost - 0.001 && end <= callbackHost + 0.001;
        uint32_t flags = (group->costPresentation ? 1u : 0u) | (feedback.error ? 2u : 0u) |
                         (validGPU ? 0u : 4u) | (isTail ? 8u : 0u);
        timeline->record(MVKBackendTimelineKind::CallbackEntry, callbackHost, callbackHost,
                         group->timelineID, queue->timelineID, 0, flags, commitHost, callbackHost);
        if (validGPU) {
            timeline->record(isTail ? MVKBackendTimelineKind::GPUTail : MVKBackendTimelineKind::GPUWork,
                             start, end, group->timelineID, queue->timelineID, 0, flags, commitHost, callbackHost);
        }
    }
    if (cost) {
        cost->recordGPU(feedback.error ? 0 : feedback.GPUStartTime, feedback.GPUEndTime,
                        commitHost, callbackHost, isTail, group->costPresentation);
    }
#endif
    // Success feedback alone changes neither public wait predicate.
    // Errors must still wake waiters even when no error handler exists.
    if (feedback.error) { notifyGroupWaiters(group); }
    if (feedback.error) { failSignalNotificationOwners(queue, feedback.error); }
    if (runErrors) { runGroupErrorHandlers(group); }
    retireIfReady(group);
}

MVKMetal4TailRecording makeRetirementTail(const std::shared_ptr<MVKMetal4QueueState>& queue,
                                         NSError** error) {
    MVKMetal4TailRecording tail;
    tail.pack = acquirePack(queue->storage, true, error, tail.allocatorUse);
    if (!tail) { return {}; }
    tail.allocatorUse.begin(tail.pack->buffer);
    tail.pack->commitStableResidency();
    // begin clears command-buffer associations, not set membership. Reattach
    // the persistent marker set on every tail recording, including pool reuse.
    [tail.pack->buffer useResidencySet:tail.pack->stableResidency];
    id<MTL4ComputeCommandEncoder> encoder = [tail.pack->buffer computeCommandEncoder];
    if (!encoder) {
        // Open cancellation discards this epoch from future writers, preserving
        // every earlier primary's bytes/leases for adoption retry or execution.
        fail(error, 2, @"Could not encode event retirement marker."); return {};
    }
    [encoder fillBuffer:tail.pack->marker range:NSMakeRange(0, 4) value:0];
    [encoder endEncoding];
    [tail.pack->buffer endCommandBuffer];
    tail.allocatorUse.end();
    return tail;
}

// A valid Metal/Vulkan signal strictly increases the value at execution.
// Shared events expose their current value, allowing an already-invalid request
// to fail before any queue mutation. This is not a race-proof validation layer:
// callers must also obey Vulkan's pending-signal/host-signal ordering rules.
bool validSignalValue(id<MTLEvent> event, uint64_t value) {
    return value && (![event conformsToProtocol:@protocol(MTLSharedEvent)] ||
                     value > ((id<MTLSharedEvent>)event).signaledValue);
}

// The group can use one actual-value notification only when its entire operation
// list has exactly one MVK internal timeline signal and no input waits/drawables.
bool eligibleSignalNotification(MVKMetal4SubmissionGroup& group) {
    group.notificationSignal = nullptr;
    for (auto& batch : group.children) {
        if (!batch->waits.empty() || !batch->drawables.empty() || !batch->presentations.empty()) { return false; }
        for (auto& signal : batch->signals) {
            if (group.notificationSignal || !signal.internalTimelineSignal ||
                ![signal.event conformsToProtocol:@protocol(MTLSharedEvent)]) { return false; }
            group.notificationSignal = &signal;
        }
    }
    return group.notificationSignal != nullptr;
}

// Registration happens before publication/queue mutation. The callback owns
// only a weak reference to this fresh group, so abandoned registrations cannot
// observe or complete a later retry of the same ended children.
bool registerSignalNotification(const std::shared_ptr<MVKMetal4SubmissionGroup>& group, uint64_t generation) {
    std::weak_ptr<MVKMetal4SubmissionGroup> weakGroup = group;
    auto& signal = *group->notificationSignal;
    @try {
        [(id<MTLSharedEvent>)signal.event notifyListener:group->owner->signalListener atValue:signal.value
            block:^(id<MTLSharedEvent>, uint64_t) {
                @autoreleasepool {
                    if (auto owner = weakGroup.lock()) { recordSignalNotification(owner, generation); }
                }
            }];
        return true;
    } @catch (NSException* exception) { (void)exception; return false; }
}

// Check the actual event values again immediately before publication, and reject
// signals within this ordered group that do not strictly increase one event.
// Values remain immutable after each recording's end(). Invalid concurrent host
// advancement is still excluded by the same Metal/Vulkan caller contract.
// A submit-local proof of relative signal order for one fresh, strongly held
// group. Ended children are exclusively claimed; legal event mutators reject
// them, and neither child order nor signal arrays change before publication.
// Current shared-event values are deliberately NOT part of this proof.
class GroupSignalOrderProof {
    const MVKMetal4SubmissionGroup* _group = nullptr;
    friend bool validateAndProveGroupSignals(const MVKMetal4SubmissionGroup&, NSError**, GroupSignalOrderProof&);
public:
    GroupSignalOrderProof() = default;
    GroupSignalOrderProof(const GroupSignalOrderProof&) = delete;
    GroupSignalOrderProof& operator=(const GroupSignalOrderProof&) = delete;
    GroupSignalOrderProof(GroupSignalOrderProof&&) = delete;
    GroupSignalOrderProof& operator=(GroupSignalOrderProof&&) = delete;
    bool covers(const MVKMetal4SubmissionGroup& group) const { return _group == &group; }
};

bool validGroupSignals(const MVKMetal4SubmissionGroup& group, NSError** error,
                       const GroupSignalOrderProof* proof = nullptr) {
    const bool checkRelativeOrder = !proof || !proof->covers(group);
    for (size_t i = 0; i < group.children.size(); ++i) {
        auto& signals = group.children[i]->signals;
        for (size_t j = 0; j < signals.size(); ++j) {
            auto& signal = signals[j];
            if (!validSignalValue(signal.event, signal.value)) {
                return fail(error, 3, @"An event signal must increase its current value at submission.");
            }
            if (!checkRelativeOrder) { continue; }
            for (size_t before = 0; before <= i; ++before) {
                auto& prior = group.children[before]->signals;
                size_t count = before == i ? j : prior.size();
                for (size_t k = 0; k < count; ++k) {
                    if (prior[k].event == signal.event && prior[k].value >= signal.value) {
                        return fail(error, 3, @"Ordered group signals must strictly increase each event.");
                    }
                }
            }
        }
    }
    return true;
}


// Only a successful complete check creates a proof. Reusing a local output
// after failure must not preserve a prior group's proof.
bool validateAndProveGroupSignals(const MVKMetal4SubmissionGroup& group, NSError** error,
                                 GroupSignalOrderProof& proof) {
    proof._group = nullptr;
    if (!validGroupSignals(group, error)) { return false; }
    proof._group = &group;
    return true;
}

// The submit lock is held. All children are exclusively claimed before this
// function; publication takes group -> sorted child -> queue locks. Poison sees
// the complete strong notification owner and Submitted state, or no group.
bool publishPreparedSubmission(const std::shared_ptr<MVKMetal4SubmissionGroup>& group,
                               SubmissionChildLocks& children,
                               MVKMetal4TailRecording tail,
                               bool notificationRegistered, NotificationSlotReservation& reservation,
                               NSError** error, const GroupSignalOrderProof* orderProof = nullptr) {
    std::lock_guard<std::mutex> groupLock(group->mutex);
    children.lock();
    struct UnlockChildren { SubmissionChildLocks& locks; ~UnlockChildren() { locks.unlock(); } } unlock{children};
    auto queue = group->owner;
    for (auto& batch : group->children) {
        if (batch->phase != Phase::Ended || batch->owner != queue) {
            return fail(error, 3, @"Only an exclusively claimed, ended group may be committed.");
        }
    }
    if (!validGroupSignals(*group, error, orderProof)) { return false; }
    std::lock_guard<std::mutex> queueLock(queue->stateMutex);
    if (queue->firstError) { return report(error, queue->firstError); }
    if (queue->storage->poisoned.load(std::memory_order_acquire)) {
        return fail(error, 5, @"Recording storage was invalidated before queue adoption.");
    }
    if (notificationRegistered) {
        if (reservation.slot >= MVKMetal4QueueState::notificationCapacity ||
            queue->notificationOwners[reservation.slot] ||
            (queue->freeNotificationSlots & (uint64_t{1} << reservation.slot))) {
            return fail(error, 3, @"No reserved slot for native signal notification.");
        }
        group->signalNotification = SignalNotification::Pending;
        group->notificationSlot = reservation.slot;
        queue->notificationOwners[reservation.slot] = group;
        reservation.slot = MVKMetal4QueueState::notificationCapacity;
    }
    group->tail = std::move(tail);
    group->tailFeedbackDone = !group->tail;
    group->phase = Phase::Submitted;
    for (auto& batch : group->children) { batch->phase = Phase::Submitted; }
    ++queue->pending;
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
    if (mvkMetal4QueueStatsEnabled() && queue->encodingStats.submittedBatches != UINT64_MAX) {
        ++queue->encodingStats.submittedBatches;
    }
#endif
    return true;
}

bool addEvent(const std::shared_ptr<MVKMetal4SubmissionState>& batch,
              id<MTLEvent> event, uint64_t value, bool signal, NSError** error,
              bool internalTimelineSignal = false, bool internalSemaphoreWait = false) {
    if (error) { *error = nil; }
    std::lock_guard<std::mutex> lock(batch->mutex);
    if (batch->phase != Phase::Recording || !event ||
        (event.device && event.device != batch->storage->device)) {
        return fail(error, 3, @"Events must be registered while recording and be usable on this device.");
    }
    if (signal && !validSignalValue(event, value)) {
        return fail(error, 3, @"An event signal must increase its current value.");
    }
    if (!batch->retainOperationUnique(event)) {
        return fail(error, 2, @"Could not allocate Metal 4 event ownership storage.");
    }
    (signal ? batch->signals : batch->waits).push_back({ event, value, signal && internalTimelineSignal });
    if (!signal && !internalSemaphoreWait) { batch->externalCounterWait = true; }
    return true;
}
}

MVKMetal4Submission::MVKMetal4Submission(std::shared_ptr<MVKMetal4SubmissionState> state)
    : _state(std::move(state)) {}
MVKMetal4Submission::~MVKMetal4Submission() = default;
MVKMetal4Queue::MVKMetal4Queue(std::shared_ptr<MVKMetal4QueueState> state)
    : _state(std::move(state)) {}
MVKMetal4Queue::~MVKMetal4Queue() = default;

MVKMetal4RecordingPool::MVKMetal4RecordingPool(std::shared_ptr<MVKMetal4RecordingPoolState> state)
    : _state(std::move(state)) {}
MVKMetal4RecordingPool::~MVKMetal4RecordingPool() = default;

std::shared_ptr<MVKMetal4RecordingPool> MVKMetal4RecordingPool::create(id<MTLDevice> device,
        NSError** error, std::shared_ptr<MVKMetal4DeviceResidency> residency) {
    if (error) { *error = nil; }
    if (!device || ![device supportsFamily:MTLGPUFamilyMetal4] ||
        (residency && residency->device() != device)) {
        fail(error, 3, @"Recording storage requires a Metal 4 device and matching residency."); return nullptr;
    }
    auto state = std::make_shared<MVKMetal4RecordingPoolState>();
    state->device = [device retain];
    state->deviceResidency = std::move(residency);
    // Terminal feedback may publish empty capacity without allocating nodes.
    state->primaryPool.reserve(MVKMetal4ResourcePoolStats::maxIdlePacksPerKind);
    state->tailPool.reserve(MVKMetal4ResourcePoolStats::maxIdlePacksPerKind);
    state->completionPool.reserve(MVKMetal4ResourcePoolStats::maxIdlePacksPerKind);
    state->availableEpochs.reserve(MVKMetal4ResourcePoolStats::maxAvailableAllocatorEpochs);
    return std::shared_ptr<MVKMetal4RecordingPool>(new MVKMetal4RecordingPool(std::move(state)));
}

std::unique_ptr<MVKMetal4Queue> MVKMetal4Queue::create(id<MTLDevice> device, NSError** error,
                                                  std::shared_ptr<MVKMetal4DeviceResidency> residency,
                                                  std::shared_ptr<MVKMetal4RecordingPool> recordingPool) {
    if (error) { *error = nil; }
    if (@available(macOS 26.0, iOS 26.0, *)) {
        if (!device || ![device supportsFamily:MTLGPUFamilyMetal4]) {
            fail(error, 1, @"The device does not support Metal 4."); return nullptr;
        }
        if (residency && residency->device() != device) {
            fail(error, 3, @"The residency set belongs to another device."); return nullptr;
        }
        auto state = std::make_shared<MVKMetal4QueueState>();
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
        if (auto* timeline = mvkBackendTimeline()) { state->timelineID = timeline->nextID(); }
#endif
        if (!recordingPool) { recordingPool = MVKMetal4RecordingPool::create(device, error, residency); }
        if (!recordingPool) { return nullptr; }
        if (recordingPool->_state->device != device || recordingPool->_state->deviceResidency != residency) {
            fail(error, 3, @"Queue and recording pool must use the same device and residency owner."); return nullptr;
        }
        state->storage = recordingPool->_state;
        state->recordingPool = std::move(recordingPool);
        state->device = [device retain];
        state->failedEvents = [NSMutableSet new];
        // Listener failure only disables the optimization; the native queue
        // remains usable through its existing retirement-tail path.
        @try { state->signalListener = [MTLSharedEventListener new]; }
        @catch (NSException* exception) { (void)exception; }
        MTL4CommandQueueDescriptor* desc = [MTL4CommandQueueDescriptor new];
        desc.label = @"MoltenVK BAR Metal 4";
        state->queue = [device newMTL4CommandQueueWithDescriptor:desc error:error];
        [desc release];
        if (!state->queue || !state->failedEvents) {
            if (!error || !*error) { fail(error, 2, @"Could not create a Metal 4 command queue."); }
            return nullptr;
        }
        state->deviceResidency = std::move(residency);
        if (state->deviceResidency) { [state->queue addResidencySet:state->deviceResidency->residencySet()]; }
        return std::unique_ptr<MVKMetal4Queue>(new MVKMetal4Queue(std::move(state)));
    }
    fail(error, 1, @"Metal 4 requires macOS 26 or iOS 26."); return nullptr;
}

std::shared_ptr<MVKMetal4Submission> MVKMetal4Queue::begin(NSError** error, bool presentation) {
    if (error) { *error = nil; }
    {
        std::lock_guard<std::mutex> lock(_state->stateMutex);
        if (_state->firstError) { report(error, _state->firstError); return nullptr; }
    }
    auto batch = _state->recordingPool->begin(error, presentation);
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
    if (batch) { batch->_state->diagnosticQueue = _state; }
#endif
    return batch;
}

std::shared_ptr<MVKMetal4RecordingPool> MVKMetal4Queue::recordingPool() const { return _state->recordingPool; }

bool MVKMetal4Queue::counterEntryNeedsFullWait() const {
    std::lock_guard<std::mutex> lock(_state->stateMutex);
    return _state->counterProof != MVKMetal4CounterProof::Closed || _state->firstError ||
        _state->storage->poisoned.load(std::memory_order_acquire);
}

std::shared_ptr<MVKMetal4Submission> MVKMetal4RecordingPool::begin(NSError** error, bool presentation) {
#if !MVK_ENABLE_CUSTOM_DIAGNOSTICS
    (void)presentation;
#endif
    if (error) { *error = nil; }
    auto state = std::make_shared<MVKMetal4SubmissionState>();
#if MVK_ENABLE_CUSTOM_DIAGNOSTICS
    if (auto* timeline = mvkBackendTimeline()) { state->timelineID = timeline->nextID(); }
    state->costPresentation = presentation;
#endif
    state->storage = _state;
    state->pack = acquirePack(_state, false, error, state->allocatorUse, &state->completionStorage);
    if (!state->pack) { return nullptr; }
    state->allocator = state->allocatorUse.allocator();
    state->buffer = state->pack->buffer;
    state->residency = state->pack->residency;
    // Move only empty capacity. Callbacks, state and weak-token identity remain
    // fresh; resident/drawable identities were cleared before the pack retired.
    state->objects.swap(state->pack->objects);
    if (state->completionStorage) {
        auto& storage = *state->completionStorage;
        state->waits.swap(storage.waits); state->signals.swap(storage.signals);
        state->drawables.swap(storage.drawables); state->presentations.swap(storage.presentations);
        state->operationRetained = storage.retained; storage.retained = nil;
        state->operationRetainedHighWater = storage.retainedHighWater; storage.retainedHighWater = 0;
    }
    state->retained = state->pack->retained; state->pack->retained = nil;
    state->retainedHighWater = state->pack->retainedHighWater; state->pack->retainedHighWater = 0;
    if (!state->retained) { state->retained = [[NSMutableArray alloc] initWithCapacity:32]; }
    if (!state->allocator || !state->buffer || !state->residency || !state->retained) {
        if (!error || !*error) { fail(error, 2, @"Could not allocate Metal 4 submission storage."); }
        return nullptr;
    }
    state->allocatorUse.begin(state->buffer);
    return std::shared_ptr<MVKMetal4Submission>(new MVKMetal4Submission(std::move(state)));
}

id<MTL4CommandBuffer> MVKMetal4Submission::commandBuffer() const {
    std::lock_guard<std::mutex> lock(_state->mutex);
    // A borrowed raw buffer may receive commands we cannot inspect. Only a
    // never-borrowed, internally untouched initial buffer is proved empty.
    _state->counterBufferMayHaveWork = true;
    return _state->phase == Phase::Recording && !_state->error ? _state->buffer : nil;
}

void MVKMetal4Submission::requireFullCounterEntry() {
    std::lock_guard<std::mutex> lock(_state->mutex);
    if (_state->phase == Phase::Recording && !_state->counterPrefixComplete) {
        _state->fullCounterEntryRequired = true;
    }
}

bool MVKMetal4Submission::splitForCounterCompletionLocked(bool timestampEntry, NSError** error) {
    auto boundary = timestampEntry ? MVKMetal4CounterBoundary::EntryTimestamp
        : _state->counterWritesPending ? MVKMetal4CounterBoundary::ResolveAfterWrite
                                      : MVKMetal4CounterBoundary::EntryResolve;
    const bool emptyEntry = !_state->counterBufferMayHaveWork && _state->counterPrefixes.empty();
    if (emptyEntry) {
        // Keep the queue boundary as metadata before this existing buffer;
        // allocating/committing an empty predecessor contributes no ordering.
        _state->counterPrefixes.push_back({nil, boundary, false, false});
    } else {
        auto next = [_state->storage->device newCommandBuffer];
        if (!next) { return fail(error, 2, @"Could not allocate a counter completion recording."); }
        _state->retainUnique(next);
        [next release];
        _state->counterPrefixes.push_back({_state->buffer, boundary, _state->counterBufferWrites, false});
        // Every segment retains the same exclusive allocator and resource pack.
        [_state->buffer useResidencySet:_state->residency];
        [_state->buffer useResidencySet:_state->pack->stableResidency];
        [_state->buffer endCommandBuffer];
        _state->buffer = next;
        [next beginCommandBufferWithAllocator:_state->allocator];
    }
    _state->counterBufferWrites = false;
    auto encoder = [_state->buffer computeCommandEncoder];
    if (!encoder) {
        NSError* failure = nil;
        fail(&failure, 2, @"Could not encode the counter completion wait consumer.");
        _state->error = [failure retain];
        return report(error, failure);
    }
    // When prior opaque writes already have a submitted full-prefix proof,
    // this real Blit waits for preceding queue stages. The same-buffer timestamp
    // then waits for the marker, without serializing all its later stage work.
    // An unproven opaque write still requires the existing queue event.
    // A generic/imported wait already known at recording time forces the full
    // event path. Do not also encode an entry-only stage bridge in that case.
    // A later wait or an earlier queue write can still force fallback at submit.
    const bool timestampBridge = timestampEntry && !_state->externalCounterWait && !_state->fullCounterEntryRequired;
    if (timestampBridge) {
        [encoder barrierAfterQueueStages:MTLStageAll beforeStages:MTLStageBlit
                       visibilityOptions:MTL4VisibilityOptionNone];
    }
    [encoder fillBuffer:_state->pack->marker range:NSMakeRange(0, sizeof(uint32_t)) value:0];
    [encoder endEncoding];
    _state->counterPrefixes.back().timestampBridge = timestampBridge;
    _state->counterPrefixComplete = true;
    _state->counterWritesPending = false;
    _state->counterBufferMayHaveWork = true;
    return true;
}

bool MVKMetal4Submission::writeTimestamp(id<MTL4CounterHeap> heap, NSUInteger index, NSError** error) {
    if (error) { *error = nil; }
    std::lock_guard<std::mutex> lock(_state->mutex);
    if (_state->error) { return report(error, _state->error); }
    if (_state->phase != Phase::Recording || !heap) {
        return fail(error, 3, @"Timestamps require an ended-encoder recording and a counter heap.");
    }
    if (!_state->counterPrefixComplete && !splitForCounterCompletionLocked(true, error)) { return false; }
    _state->retainUnique(heap);
    // This API waits for all earlier work IN THIS COMMAND BUFFER, including
    // earlier counter writes and resolves. Submission chooses a proven entry
    // marker bridge or the existing full event for other buffers.
    [_state->buffer writeTimestampIntoHeap:heap atIndex:index];
    _state->counterBufferWrites = true;
    _state->counterWritesPending = true;
    return true;
}

bool MVKMetal4Submission::resolveCounterHeap(id<MTL4CounterHeap> heap, NSRange range,
                                            MTL4BufferRange destination, NSError** error, bool resultsAlreadyComplete) {
    if (error) { *error = nil; }
    std::lock_guard<std::mutex> lock(_state->mutex);
    if (_state->error) { return report(error, _state->error); }
    if (_state->phase != Phase::Recording || !heap) {
        return fail(error, 3, @"Counter resolves require an ended-encoder recording and a counter heap.");
    }
    if (!resultsAlreadyComplete && (!_state->counterPrefixComplete || _state->counterWritesPending) &&
        !splitForCounterCompletionLocked(false, error)) { return false; }
    _state->retainUnique(heap);
    // Queue signal/wait completes every preceding opaque write. Adjacent reads
    // share that proof until a new timestamp is recorded; no synthetic D/B write.
    [_state->buffer resolveCounterHeap:heap withRange:range intoBuffer:destination waitFence:nil updateFence:nil];
    // This narrow host-completion fact covers only this range. It must not
    // close the queue proof, clear other pending writes, or cover a later T.
    _state->counterBufferMayHaveWork = true;
    return true;
}

