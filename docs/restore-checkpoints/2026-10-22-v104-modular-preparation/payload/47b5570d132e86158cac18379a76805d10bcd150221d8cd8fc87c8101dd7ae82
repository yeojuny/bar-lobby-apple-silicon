}

MVKMetal4Upload MVKMetal4Submission::uploadBytesRangeWithPrimitiveInputs(const void* bytes, NSUInteger length,
        id pipelineObject, id<MTLBuffer> arguments, id<MTLBuffer> indices, NSError** error) {
    if (error) { *error = nil; }
    std::lock_guard<std::mutex> lock(_state->mutex);
    if (_state->phase != Phase::Recording || !bytes || !length || !pipelineObject || !arguments) {
        fail(error, 3, @"Primitive inputs require nonempty parameters and owned objects in a recording submission."); return {};
    }
    // Validate every input before uploading or retaining anything. These are
    // directly owned buffers, never indirect descriptors or drawable textures.
    id<MTLBuffer> buffers[] = {arguments, indices};
    bool alreadyResident[] = {false, false};
    for (size_t i = 0; i < 2; ++i) {
        id<MTLBuffer> buffer = buffers[i];
        if (!buffer) { continue; }
        if (i && buffer == arguments) { continue; } // Validated/registered by the first slot.
        auto found = _state->objects.find((const void*)buffer);
        if (found != _state->objects.end() && found->second.resident && !found->second.texture) {
            alreadyResident[i] = true; continue;
        }
        if (![buffer conformsToProtocol:@protocol(MTLBuffer)] || buffer.device != _state->storage->device) {
            fail(error, 3, @"Primitive input buffers must belong to the recording submission's device."); return {};
        }
    }
    auto upload = uploadBytesRangeLocked(bytes, length, error);
    if (!upload.buffer) { return {}; }
    _state->retainUnique(pipelineObject);
    // The upload may rehash objects, so keep only the proved boolean membership,
    // never an iterator. The same recording lock preserves retention/residency.
    for (size_t i = 0; i < 2; ++i) {
        if (buffers[i] && !alreadyResident[i] && (!i || buffers[i] != arguments)) {
            _state->addResident(buffers[i]);
        }
    }
    return upload;
}

MVKMetal4Upload MVKMetal4Submission::uploadBytesRangeLocked(const void* bytes, NSUInteger length, NSError** error) {
    constexpr NSUInteger alignment = 256, slabLength = 64 * 1024;
    NSUInteger limit = _state->storage->device.maxBufferLength;
    if (length > limit || length > std::numeric_limits<NSUInteger>::max() - (alignment - 1)) {
        fail(error, 2, @"Upload slice exceeds the device buffer length limit."); return {};
    }
    NSUInteger roundedLength = (length + alignment - 1) & ~(alignment - 1);
    if (roundedLength > slabLength) {
        // Do not grow reusable slabs to large transient upload sizes.
        id<MTLBuffer> buffer = [_state->storage->device newBufferWithBytes:bytes length:length options:MTLResourceStorageModeShared];
        if (!buffer) { fail(error, 2, @"Could not allocate a dedicated upload slice."); return {}; }
        _state->addResident(buffer, false);
        [buffer release];
        return {buffer, 0};
    }
    if (!_state->uploadArena || _state->uploadArenaCursor > _state->uploadArena.length ||
        roundedLength > _state->uploadArena.length - _state->uploadArenaCursor) {
        NSUInteger capacity = std::min(slabLength, limit);
        if (roundedLength > capacity) {
            fail(error, 2, @"Aligned upload slice exceeds the device buffer length limit."); return {};
        }
        id<MTLBuffer> buffer = nil;
        bool reused = _state->uploadSlabIndex < _state->pack->uploadSlabs.size();
        bool stableOwned = reused;
        if (reused) {
            buffer = _state->pack->uploadSlabs[_state->uploadSlabIndex];
        } else {
            buffer = [_state->storage->device newBufferWithLength:capacity options:MTLResourceStorageModeShared];
            if (!buffer || !buffer.contents) {
                [buffer release]; fail(error, 2, @"Could not allocate shared upload slab storage."); return {};
            }
            if (_state->pack->uploadSlabs.size() < MVKMetal4ResourcePoolStats::maxUploadSlabsPerPack) {
                _state->pack->uploadSlabs.push_back([buffer retain]);
                _state->pack->addStableAllocation(buffer);
                stableOwned = true;
            }
        }
        ++_state->uploadSlabIndex;
        if (stableOwned) { _state->addStableResident(buffer); }
        else { _state->addResident(buffer, false); } // Uncached overflow remains dynamic.
        _state->uploadArena = buffer;
        _state->uploadArenaCursor = 0;
        if (!reused) { [buffer release]; }
        {
            std::lock_guard<std::mutex> poolLock(_state->storage->poolMutex);
            ++(reused ? _state->storage->poolStats.uploadSlabsReused : _state->storage->poolStats.uploadSlabsCreated);
        }
    }
    MVKMetal4Upload upload {_state->uploadArena, _state->uploadArenaCursor};
    memcpy(static_cast<uint8_t*>(upload.buffer.contents) + upload.offset, bytes, length);
    _state->uploadArenaCursor += roundedLength;
    return upload;
}

