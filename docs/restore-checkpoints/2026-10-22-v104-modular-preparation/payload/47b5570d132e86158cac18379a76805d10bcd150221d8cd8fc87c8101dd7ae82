double MVKBackendCostStats::hostSeconds() {
    static const double scale = [] {
        mach_timebase_info_data_t info;
        mach_timebase_info(&info);
        return double(info.numer) / double(info.denom) * 1e-9;
    }();
    return double(mach_absolute_time()) * scale;
}

MVKBackendCostStats::MVKBackendCostStats(const char* backend) : _backend(backend) {
    _originHost = hostSeconds();
    _originUnixMS = std::chrono::duration<double, std::milli>(
        std::chrono::system_clock::now().time_since_epoch()).count();
}

void MVKBackendCostStats::recordCPU(double start, double end, bool semaphoreWait) {
    std::lock_guard<std::mutex> lock(_mutex);
    if (!std::isfinite(start) || !std::isfinite(end) || start < _originHost || end < start) {
        ++_data.invalidCPU; return;
    }
    double position = start - _originHost;
    if (position >= maxBins) { ++_data.outsideWindow; return; }
    auto& bin = _data.bins[size_t(position)];
    double elapsed = end - start;
    if (semaphoreWait) { ++bin.waitCount; bin.waitSum += elapsed; }
    else { ++bin.cpuCount; bin.cpuSum += elapsed; bin.cpuMax = std::max(bin.cpuMax, elapsed); }
}

void MVKBackendCostStats::recordGPU(double start, double end, double commit, double callback,
                                   bool tail, bool presentation) {
    std::lock_guard<std::mutex> lock(_mutex);
    // GPU properties use host seconds. Reject missing/error/domain-mismatched
    // samples instead of deriving GPU time from callback wall-clock latency.
    if (!std::isfinite(start) || !std::isfinite(end) || !std::isfinite(commit) ||
        !std::isfinite(callback) || start <= 0 || end < start || start < _originHost ||
        commit < _originHost || callback < commit || end > callback + 0.001 || start < commit - 0.001) {
        ++_data.invalidGPU; return;
    }
    double position = start - _originHost;
    if (position >= maxBins) { ++_data.outsideWindow; return; }
    auto& bin = _data.bins[size_t(position)];
    double elapsed = end - start;
    if (tail) { ++bin.tailCount; bin.tailSum += elapsed; }
    else if (presentation) {
        ++bin.presentCount; bin.presentSum += elapsed;
        bin.presentMax = std::max(bin.presentMax, elapsed);
        bin.presentFirstGPU = bin.presentFirstGPU ? std::min(bin.presentFirstGPU, start) : start;
        bin.presentLastGPU = std::max(bin.presentLastGPU, end);
        bin.presentQueueDelaySum += std::max(0.0, start - commit);
        bin.presentFeedbackLagSum += std::max(0.0, callback - end);
    }
    else {
        ++bin.workCount; bin.workSum += elapsed; bin.workMax = std::max(bin.workMax, elapsed);
        bin.firstGPU = bin.firstGPU ? std::min(bin.firstGPU, start) : start;
        bin.lastGPU = std::max(bin.lastGPU, end);
        bin.queueDelaySum += std::max(0.0, start - commit);
        bin.feedbackLagSum += std::max(0.0, callback - end);
    }
}

MVKBackendCostStats::Snapshot MVKBackendCostStats::snapshot() const {
    std::lock_guard<std::mutex> lock(_mutex);
    return _data;
}

void MVKBackendCostStats::recordEncoding(const MVKMetal4EncodingStats& stats, double recordHost) {
    std::lock_guard<std::mutex> lock(_mutex);
    if (!std::isfinite(recordHost) || recordHost < _originHost) {
        ++_data.invalidEncoding; return;
    }
    double position = recordHost - _originHost;
    if (position >= maxBins) { ++_data.outsideWindow; return; }
    auto& bin = _data.bins[size_t(position)];
    mergeEncodingStats(bin.encoding, stats);
    if (bin.encodingCount != UINT64_MAX) { ++bin.encodingCount; }
    bin.encodingFirstRecordHost = bin.encodingFirstRecordHost ? std::min(bin.encodingFirstRecordHost, recordHost) : recordHost;
    bin.encodingLastRecordHost = std::max(bin.encodingLastRecordHost, recordHost);
}

MVKBackendCostStats::~MVKBackendCostStats() {
    // Last owning reference is released after feedback: no collector/GPU cycles.
    // One bounded line; sums and envelopes intentionally do not claim GPU busy
    // union or critical-path time when batches overlap or include dependencies.
    std::string line;
    line.reserve(maxBins * 1024 + 4096);
    char chunk[2048];
    std::snprintf(chunk, sizeof(chunk), "[mvk-backend-cost] {\"schema\":\"mvk-backend-cost-v3\",\"backend\":\"%s\",\"host_anchor_s\":%.9f,\"unix_anchor_ms\":%.3f,\"bin_seconds\":1,\"max_seconds\":300,\"cpu_scope\":\"vulkan_command_submit_wall_excludes_presentation\",\"gpu_work_scope\":\"vulkan_commands_excludes_presentation_and_tails\",\"gpu_sums_are_critical_path\":false,\"timing_bin_attribution\":\"sample_start_time_full_unclipped_duration\",\"encoding_scope\":\"native_encoding_and_submit_metadata_not_GPU_completed_work\",\"encoding_bin_attribution\":\"stats_delivery_host_time_command_data_at_encoding_end_fusedSignalSubmits_at_precommit\",\"gpu_feedback_lag_scope\":\"callback_entry_not_fence_signal\",\"texture_proof_ready_scope\":\"complete_proof_before_bounded_cache_insertion\",\"invalid_cpu\":%llu,\"invalid_gpu\":%llu,\"invalid_encoding\":%llu,\"outside_window\":%llu,\"bins\":[",
        _backend, _originHost, _originUnixMS, (unsigned long long)_data.invalidCPU,
        (unsigned long long)_data.invalidGPU, (unsigned long long)_data.invalidEncoding,
        (unsigned long long)_data.outsideWindow);
    line += chunk;
    bool comma = false;
    for (size_t i = 0; i < maxBins; ++i) {
        const auto& b = _data.bins[i];
        if (!(b.cpuCount || b.waitCount || b.workCount || b.tailCount || b.presentCount || b.encodingCount)) { continue; }
        // Compact column schema is fixed in this receipt, not a per-frame log.
        std::snprintf(chunk, sizeof(chunk), "%s[%zu,%llu,%.6f,%.6f,%llu,%.6f,%llu,%.6f,%.6f,%llu,%.6f,%.9f,%.9f,%.6f,%.6f,%llu,%.6f,%.6f,%.9f,%.9f,%.6f,%.6f",
            comma ? "," : "", i, (unsigned long long)b.cpuCount, b.cpuSum * 1000, b.cpuMax * 1000,
            (unsigned long long)b.waitCount, b.waitSum * 1000, (unsigned long long)b.workCount,
            b.workSum * 1000, b.workMax * 1000, (unsigned long long)b.tailCount, b.tailSum * 1000,
            b.firstGPU, b.lastGPU, b.queueDelaySum * 1000, b.feedbackLagSum * 1000,
            (unsigned long long)b.presentCount, b.presentSum * 1000, b.presentMax * 1000,
            b.presentFirstGPU, b.presentLastGPU, b.presentQueueDelaySum * 1000, b.presentFeedbackLagSum * 1000);
        line += chunk;
        std::snprintf(chunk, sizeof(chunk), ",%llu,%.9f,%.9f", (unsigned long long)b.encodingCount,
                      b.encodingFirstRecordHost, b.encodingLastRecordHost);
        line += chunk;
        for (const auto& field : encodingStatFields) {
            std::snprintf(chunk, sizeof(chunk), ",%llu", (unsigned long long)(b.encoding.*field.member));
            line += chunk;
        }
        line += ']';
        comma = true;
    }
    line += "],\"columns\":[\"second\",\"cpu_cmd_count\",\"cpu_cmd_ms\",\"cpu_cmd_max_ms\",\"cpu_wait_count\",\"cpu_wait_ms\",\"gpu_work_count\",\"gpu_work_ms\",\"gpu_work_max_ms\",\"gpu_tail_count\",\"gpu_tail_ms\",\"gpu_first_host_s\",\"gpu_last_host_s\",\"commit_to_gpu_start_ms\",\"gpu_end_to_callback_ms\",\"gpu_present_count\",\"gpu_present_ms\",\"gpu_present_max_ms\",\"gpu_present_first_host_s\",\"gpu_present_last_host_s\",\"present_commit_to_gpu_start_ms\",\"present_gpu_end_to_callback_ms\",\"encoding_record_count\",\"encoding_first_record_host_s\",\"encoding_last_record_host_s\"";
    for (const auto& field : encodingStatFields) { line += ",\""; line += field.name; line += '"'; }
    line += "]}";
    std::fprintf(stderr, "%s\n", line.c_str());
}

