--- a/rts/Rendering/Fonts/CFontTexture.cpp
+++ b/rts/Rendering/Fonts/CFontTexture.cpp
@@ -809,8 +809,25 @@
 
 	// Store pattern
 	FcPattern* pattern = FcFreeTypeQueryFace(face, reinterpret_cast<const FcChar8*>(fontfile.c_str()), 0, NULL);
+	if (pattern == nullptr) {
+		LOG_L(L_WARNING, "[%s] could not query pattern for %s", __func__, fontfile.c_str());
+		return false;
+	}
+
+	// QueryFace canonicalizes relative paths against the working directory.
+	// Registered fallback fonts are reloaded through LoadFontFace's VFS lookup;
+	// keep the same name that successfully loaded this face. Absolute disk paths
+	// remain absolute, and patterns discovered by system font search are unchanged.
+	FcPatternDel(pattern, FC_FILE);
+	if (!FcPatternAddString(pattern, FC_FILE, reinterpret_cast<const FcChar8*>(fontfile.c_str()))) {
+		FcPatternDestroy(pattern);
+		LOG_L(L_WARNING, "[%s] could not preserve filename for %s", __func__, fontfile.c_str());
+		return false;
+	}
+
 	if (!FcFontSetAdd(set, pattern))
 	{
+		FcPatternDestroy(pattern);
 		LOG_L(L_WARNING, "[%s] could not add pattern for %s", __func__, fontfile.c_str());
 		return false;
 	}
