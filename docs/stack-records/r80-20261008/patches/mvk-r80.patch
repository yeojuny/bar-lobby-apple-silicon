+// Diagnostic-only IDs are immutable for an object lifetime and carry no ownership.
+uint64_t hostWaitDiagnosticIdentity(std::atomic<uint64_t>& identity) {
+    auto* timeline = mvkBackendTimeline();
+    if (!timeline) { return 0; }
+    uint64_t value = identity.load(std::memory_order_acquire);
+    if (value) { return value; }
+    uint64_t fresh = timeline->nextID();
+    if (!fresh) { return 0; }
+    if (identity.compare_exchange_strong(value, fresh, std::memory_order_acq_rel,
+                                        std::memory_order_acquire)) { return fresh; }
+    return value;
+}
