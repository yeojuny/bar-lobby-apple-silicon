+bool mvkRegisterMetal4Drawable(id<MTLTexture> texture, id<MTLDrawable> drawable, NSError** error) {
+    if (error) { *error = nil; }
+    if (!texture || !drawable) { return fail(error, 3, @"Drawable registration requires a texture and drawable."); }
+    if (textureOwnership(texture).ordinary) {
+        return fail(error, 3, @"A device-created ordinary texture cannot be a CAMetalLayer drawable.");
+    }
+    std::lock_guard<std::mutex> lock(drawableRegistryMutex);
+    auto entry = drawableRegistry.find(texture);
+    if (entry != drawableRegistry.end()) {
+        return entry->second->drawable == drawable || fail(error, 3, @"Texture already belongs to another registered drawable.");
+    }
+    auto binding = std::make_shared<MVKMetal4DrawableBinding>(drawable);
+    auto* source = [MVKMetal4TextureOwnership new];
+    source->binding = binding;
+    drawableRegistry.emplace(texture, binding);
+    advanceDrawableRegistryGeneration();
+    source->generation = drawableRegistryGeneration.load(std::memory_order_relaxed);
+    objc_setAssociatedObject(texture, &textureOwnershipKey, source, OBJC_ASSOCIATION_RETAIN);
+    [source release];
+    return true;
+}
+
+void mvkUnregisterMetal4Drawable(id<MTLTexture> texture, id<MTLDrawable> drawable) {
+    std::shared_ptr<MVKMetal4DrawableBinding> released;
+    {
+        std::lock_guard<std::mutex> lock(drawableRegistryMutex);
+        auto entry = drawableRegistry.find(texture);
+        if (entry != drawableRegistry.end() && entry->second->drawable == drawable) {
+            released = std::move(entry->second);
+            drawableRegistry.erase(entry);
+            advanceDrawableRegistryGeneration();
+        }
+    }
+    released.reset(); // Releasing a drawable may invoke a presented handler.
+}
+
+void mvkMarkMetal4OrdinaryTexture(id<MTLTexture> texture) {
+    if (texture) {
+        objc_setAssociatedObject(texture, &textureOwnershipKey, ordinaryTextureOwnership(), OBJC_ASSOCIATION_RETAIN);
+    }
+}
+
+void mvkInheritMetal4TextureOwnership(id<MTLTexture> texture, id<MTLTexture> parent) {
+    if (!texture || texture == parent) { return; }
+    id source = objc_getAssociatedObject(parent, &textureOwnershipKey);
+    if (source) { objc_setAssociatedObject(texture, &textureOwnershipKey, source, OBJC_ASSOCIATION_RETAIN); }
+}
