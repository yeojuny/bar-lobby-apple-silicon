+namespace {
+void mergeEncodingStats(MVKMetal4EncodingStats& total, const MVKMetal4EncodingStats& stats) {
+    auto add = [](uint64_t& destination, uint64_t value) {
+        destination += std::min(value, UINT64_MAX - destination);
+    };
+    add(total.drawCalls, stats.drawCalls);
+    add(total.indirectDrawCalls, stats.indirectDrawCalls);
+    add(total.converted, stats.converted);
+    add(total.provokingVertex, stats.provokingVertex);
+    add(total.listRestart, stats.listRestart);
+    add(total.stripRestart, stats.stripRestart);
+    add(total.fan, stats.fan);
+    add(total.uint8Indices, stats.uint8Indices);
+    add(total.restartKernelCalls, stats.restartKernelCalls);
+    add(total.fusedRestartKernelCalls, stats.fusedRestartKernelCalls);
+    add(total.batchedRestartDispatches, stats.batchedRestartDispatches);
+    add(total.batchedRestartDraws, stats.batchedRestartDraws);
+    add(total.maxInputCountSum, stats.maxInputCountSum);
+    total.maxInputCountMax = std::max(total.maxInputCountMax, stats.maxInputCountMax);
+    add(total.directInputCountSum, stats.directInputCountSum);
+    add(total.indirectBoundCountSum, stats.indirectBoundCountSum);
+    add(total.scratchBytes, stats.scratchBytes);
+    add(total.renderWasActive, stats.renderWasActive);
+    add(total.prepassBatches, stats.prepassBatches);
+    add(total.prepassHandoffBatches, stats.prepassHandoffBatches);
+    add(total.prepassLeadingOrdinaryDraws, stats.prepassLeadingOrdinaryDraws);
+    add(total.prepassDeferredWaits, stats.prepassDeferredWaits);
+    add(total.prepassHandoffFallbacks, stats.prepassHandoffFallbacks);
+    add(total.fusedSignalSubmits, stats.fusedSignalSubmits);
+    add(total.preconvertedDraws, stats.preconvertedDraws);
+    add(total.renderPasses, stats.renderPasses);
+    add(total.computePasses, stats.computePasses);
+    add(total.computeBarrierContinuations, stats.computeBarrierContinuations);
+    add(total.independentCopyRegions, stats.independentCopyRegions);
+    add(total.clearHelperRestores, stats.clearHelperRestores);
+    add(total.indirectConversionBatches, stats.indirectConversionBatches);
+    add(total.indirectBatchedDraws, stats.indirectBatchedDraws);
+    add(total.indirectBatchFallbacks, stats.indirectBatchFallbacks);
+    add(total.textureBindingVisits, stats.textureBindingVisits);
+    add(total.textureCacheEligible, stats.textureCacheEligible);
+    add(total.textureCacheHits, stats.textureCacheHits);
+    add(total.textureCacheMisses, stats.textureCacheMisses);
+    add(total.textureHitResourceSlots, stats.textureHitResourceSlots);
+    add(total.textureNegativeMemoSkips, stats.textureNegativeMemoSkips);
+    add(total.textureProofAttempts, stats.textureProofAttempts);
+    add(total.textureProofReady, stats.textureProofReady);
+    add(total.textureProofRejected, stats.textureProofRejected);
+    add(total.directTextureBindings, stats.directTextureBindings);
+    add(total.indirectGroupChecks, stats.indirectGroupChecks);
+    add(total.indirectGroupHits, stats.indirectGroupHits);
+    add(total.indirectGroupPreparations, stats.indirectGroupPreparations);
+    add(total.invariantNoFlatDraws, stats.invariantNoFlatDraws);
+    add(total.invariantAdmittedDraws, stats.invariantAdmittedDraws);
+    add(total.invariantExternalWritesDraws, stats.invariantExternalWritesDraws);
+    add(total.invariantBuiltinsDraws, stats.invariantBuiltinsDraws);
+    add(total.invariantLayoutDraws, stats.invariantLayoutDraws);
+    add(total.invariantProofRejectedDraws, stats.invariantProofRejectedDraws);
+    add(total.invariantUnsupportedDraws, stats.invariantUnsupportedDraws);
+}
+void logEncodingStats(const char* kind, const MVKMetal4EncodingStats& stats,
+                      uint64_t ended, uint64_t submitted, uint64_t completed) {
+        std::fprintf(stderr, "[%s] drawCalls=%" PRIu64 " indirectDrawCalls=%" PRIu64
+                     " converted=%" PRIu64 " provokingVertex=%" PRIu64 " listRestart=%" PRIu64
+                     " stripRestart=%" PRIu64 " fan=%" PRIu64 " uint8Indices=%" PRIu64
+                     " restartKernelCalls=%" PRIu64 " fusedRestartKernelCalls=%" PRIu64
+                     " batchedRestartDispatches=%" PRIu64 " batchedRestartDraws=%" PRIu64
+                     " maxInputCountSum=%" PRIu64 " maxInputCountMax=%" PRIu64
+                     " directInputCountSum=%" PRIu64 " indirectBoundCountSum=%" PRIu64
+                     " scratchBytes=%" PRIu64 " renderWasActive=%" PRIu64
+                     " prepassBatches=%" PRIu64 " preconvertedDraws=%" PRIu64 " renderPasses=%" PRIu64
+                     " prepassHandoffBatches=%" PRIu64 " prepassLeadingOrdinaryDraws=%" PRIu64
+                     " prepassDeferredWaits=%" PRIu64 " prepassHandoffFallbacks=%" PRIu64
+                     " fusedSignalSubmits=%" PRIu64
+                     " computePasses=%" PRIu64 " computeBarrierContinuations=%" PRIu64
+                     " independentCopyRegions=%" PRIu64 " clearHelperRestores=%" PRIu64
+                     " indirectConversionBatches=%" PRIu64 " indirectBatchedDraws=%" PRIu64
+                     " indirectBatchFallbacks=%" PRIu64 " endedBatches=%" PRIu64
+                     " submittedBatches=%" PRIu64 " completedBatches=%" PRIu64,
+                     kind,
+                     stats.drawCalls, stats.indirectDrawCalls, stats.converted, stats.provokingVertex,
+                     stats.listRestart, stats.stripRestart, stats.fan, stats.uint8Indices, stats.restartKernelCalls,
+                     stats.fusedRestartKernelCalls, stats.batchedRestartDispatches, stats.batchedRestartDraws,
+                     stats.maxInputCountSum, stats.maxInputCountMax, stats.directInputCountSum,
+                     stats.indirectBoundCountSum, stats.scratchBytes, stats.renderWasActive,
+                     stats.prepassBatches, stats.preconvertedDraws, stats.renderPasses,
+                     stats.prepassHandoffBatches, stats.prepassLeadingOrdinaryDraws,
+                     stats.prepassDeferredWaits, stats.prepassHandoffFallbacks,
+                     stats.fusedSignalSubmits,
+                     stats.computePasses, stats.computeBarrierContinuations,
+                     stats.independentCopyRegions, stats.clearHelperRestores, stats.indirectConversionBatches,
+                     stats.indirectBatchedDraws, stats.indirectBatchFallbacks, ended, submitted, completed);
+        // Retain the established optional text format; backend-cost-only mode
+        // does not enter this path. New counters also appear in cost-bin JSON.
+        for (size_t i = 33; i < sizeof(encodingStatFields) / sizeof(encodingStatFields[0]); ++i) {
+            const auto& field = encodingStatFields[i];
+            std::fprintf(stderr, " %s=%" PRIu64, field.name, stats.*field.member);
+        }
+        std::fputc('\n', stderr);
+}
