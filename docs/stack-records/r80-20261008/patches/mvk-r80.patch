+bool MVKMetal4Queue::submit(const std::shared_ptr<MVKMetal4Submission>& submission, NSError** error) {
+    return submit(std::vector<std::shared_ptr<MVKMetal4Submission>>{submission}, error);
+}
+
+bool MVKMetal4Queue::submit(const std::vector<std::shared_ptr<MVKMetal4Submission>>& submissions,
+                          NSError** error) {
+    if (error) { *error = nil; }
+    if (submissions.empty()) { return fail(error, 3, @"A native submission group must contain a recording."); }
+    auto queue = _state;
+    auto group = std::make_shared<MVKMetal4SubmissionGroup>();
+    group->owner = queue;
+    group->children.reserve(submissions.size());
+    for (auto& submission : submissions) {
+        if (!submission || submission->_state->storage != queue->storage) {
+            return fail(error, 3, @"All group recordings and the queue must share device recording storage.");
+        }
+        group->children.push_back(submission->_state);
+        group->costPresentation = group->costPresentation || submission->_state->costPresentation;
+    }
+    group->retirement.resize(submissions.size());
+    group->workBuffers.reserve(submissions.size());
+    group->timelineID = group->children.back()->timelineID;
+    SubmissionChildLocks childLocks(group->children);
+    for (size_t i = 1; i < childLocks.ordered.size(); ++i) {
+        if (childLocks.ordered[i - 1] == childLocks.ordered[i]) {
+            return fail(error, 3, @"A native submission group cannot contain duplicate recordings.");
+        }
+    }
+    auto* timeline = mvkBackendTimeline();
+    NativeTimelineSpan submitSpan(timeline, MVKBackendTimelineKind::NativeSubmit, group->timelineID, queue->timelineID);
+    submitSpan.flags = 2;
+    double lockStart = timeline ? timeline->clock() : 0;
+    std::unique_lock<std::timed_mutex> submitLock(queue->submitMutex);
+    if (timeline) { timeline->record(MVKBackendTimelineKind::SubmitLock, lockStart, timeline->clock(), group->timelineID, queue->timelineID); }
+    {
+        std::lock_guard<std::mutex> lock(queue->stateMutex);
+        if (queue->firstError) { return report(error, queue->firstError); }
+    }
+    childLocks.lock();
+    for (auto& batch : group->children) {
+        if (batch->phase != Phase::Ended || batch->owner ||
+            batch->storage->poisoned.load(std::memory_order_acquire)) {
+            childLocks.unlock();
+            return fail(error, 3, @"Every recording must be available for atomic queue adoption.");
+        }
+    }
+    size_t rangeStart = 0;
+    for (auto& batch : group->children) {
+        for (auto prefix : batch->counterPrefixes) {
+            group->workBuffers.push_back(prefix);
+            group->workRanges.push_back({rangeStart, group->workBuffers.size() - rangeStart});
+            rangeStart = group->workBuffers.size();
+        }
+        group->workBuffers.push_back(batch->buffer);
+    }
+    if (!group->workRanges.empty()) {
+        group->workRanges.push_back({rangeStart, group->workBuffers.size() - rangeStart});
+        group->remainingRangeFeedback = group->workRanges.size();
+        group->rangeFeedback.resize(group->workRanges.size(), 0);
+        group->rangeCommitHosts.resize(group->workRanges.size(), 0);
+    }
+    for (auto& batch : group->children) { batch->owner = queue; }
+    childLocks.unlock();
+    struct AdoptionClaim {
+        const std::shared_ptr<MVKMetal4SubmissionGroup>& group;
+        SubmissionChildLocks& children;
+        ~AdoptionClaim() {
+            children.lock();
+            for (auto& batch : group->children) {
+                if (batch->phase == Phase::Ended) { batch->owner.reset(); }
+            }
+            children.unlock();
+        }
+    } adoption{group, childLocks};
+    struct CommitOptions {
+        MTL4CommitOptions* work = [MTL4CommitOptions new];
+        MTL4CommitOptions* tail = nil;
+        std::vector<MTL4CommitOptions*> following;
+        ~CommitOptions() {
+            for (auto option : following) { [option release]; }
+            [work release]; [tail release];
+        }
+    } options;
+    if (!options.work) { return fail(error, 2, @"Could not allocate commit options."); }
+    if (!group->workRanges.empty()) {
+        group->counterEvent = [queue->device newEvent];
+        if (!group->counterEvent) { return fail(error, 2, @"Could not allocate counter completion event."); }
+        options.following.reserve(group->workRanges.size() - 1);
+        for (size_t i = 1; i < group->workRanges.size(); ++i) {
+            auto option = [MTL4CommitOptions new];
+            if (!option) { return fail(error, 2, @"Could not allocate counter completion options."); }
+            options.following.push_back(option);
+            [option addFeedbackHandler:^(id<MTL4CommitFeedback> feedback) {
+                @autoreleasepool { recordFeedback(group, feedback, false, i); }
+            }];
+        }
+    }
+    if (!validGroupSignals(*group, error)) { return false; }
+    bool needsSignalRetirement = false;
+    for (auto& batch : group->children) {
+        needsSignalRetirement = needsSignalRetirement || !batch->signals.empty() || !batch->presentations.empty();
+    }
+    NotificationSlotReservation notification(queue);
+    if (eligibleSignalNotification(*group) && notification.reserve()) { group->notificationGeneration = 1; }
+    bool notificationRegistered = group->notificationGeneration &&
+                                  registerSignalNotification(group, group->notificationGeneration);
+    if (!notificationRegistered) { notification.release(); }
+    MVKMetal4TailRecording tail;
+    if (needsSignalRetirement && !notificationRegistered) {
+        NativeTimelineSpan tailSetup(timeline, MVKBackendTimelineKind::TailSetup, group->timelineID, queue->timelineID);
+        options.tail = [MTL4CommitOptions new];
+        if (!options.tail) { return fail(error, 2, @"Could not allocate event retirement options."); }
+        // Native end makes an epoch available for another CPU record, so a tail
+        // acquires its own exclusive writer instead of borrowing a child's raw
+        // allocator (which another thread may already be recording into).
+        tail = makeRetirementTail(queue, error);
+        if (!tail) { return false; }
+    }
+    [options.work addFeedbackHandler:^(id<MTL4CommitFeedback> feedback) {
+        @autoreleasepool { recordFeedback(group, feedback, false); }
+    }];
+    [options.tail addFeedbackHandler:^(id<MTL4CommitFeedback> feedback) {
+        @autoreleasepool { recordFeedback(group, feedback, true); }
+    }];
+    if (!publishPreparedSubmission(group, childLocks, std::move(tail), notificationRegistered, notification, error)) {
+        return false;
+    }
+    // Adoption publishes host journals in Vulkan order before queue operations.
+    // Early feedback is unable to retire any pack while submitFinished is false.
+    for (auto& batch : group->children) {
+        auto actions = std::move(batch->hostStateActions);
+        for (auto& action : actions) { action(); }
+        actions.clear();
+    }
+    for (auto& batch : group->children) {
+        for (auto& event : batch->waits) { [queue->queue waitForEvent:event.event value:event.value]; }
+        for (auto drawable : batch->drawables) { [queue->queue waitForDrawable:drawable]; }
+    }
+    if (queue->costStats || timeline) {
+        std::lock_guard<std::mutex> lock(group->mutex);
+        group->workCommitHost = MVKBackendCostStats::hostSeconds();
+    }
+    if (queue->deviceResidency) { queue->deviceResidency->commit(); }
+    double commitStart = timeline ? timeline->clock() : 0;
+    if (group->workRanges.empty()) {
+        [queue->queue commit:group->workBuffers.data() count:group->workBuffers.size() options:options.work];
+    } else {
+        for (size_t i = 0; i < group->workRanges.size(); ++i) {
+            // Unlike stage-scoped barriers, a queue event orders opaque counter
+            // writes too. Keep these internal pairs in place: outer wait/signal
+            // lists are intentionally hoisted and cannot express this boundary.
+            if (i) {
+                [queue->queue signalEvent:group->counterEvent value:i];
+                [queue->queue waitForEvent:group->counterEvent value:i];
+            }
+            if (queue->costStats || timeline) {
+                std::lock_guard<std::mutex> lock(group->mutex);
+                group->rangeCommitHosts[i] = MVKBackendCostStats::hostSeconds();
+            }
+            const auto& range = group->workRanges[i];
+            auto option = i ? options.following[i - 1] : options.work;
+            [queue->queue commit:group->workBuffers.data() + range.first count:range.count options:option];
+        }
+    }
+    double signalStart = timeline ? timeline->clock() : 0;
+    if (timeline) { timeline->record(MVKBackendTimelineKind::WorkCommit, commitStart, signalStart, group->timelineID, queue->timelineID); }
+    size_t signalCount = 0;
+    for (auto& batch : group->children) {
+        for (auto& event : batch->signals) {
+            [queue->queue signalEvent:event.event value:event.value];
+            ++signalCount;
+        }
+        for (auto& presentation : batch->presentations) {
+            [queue->queue signalDrawable:presentation.drawable];
+            presentation.beforePresent();
+            if (presentation.timeSeconds) { [presentation.drawable presentAtTime:presentation.timeSeconds]; }
+            else { [presentation.drawable present]; }
+        }
+    }
+    if (group->tail) {
+        for (auto& batch : group->children) {
+            for (auto& event : batch->signals) { [queue->queue waitForEvent:event.event value:event.value]; }
+        }
+        id<MTL4CommandBuffer> tailBuffer = group->tail.pack->buffer;
+        if (queue->costStats || timeline) {
+            std::lock_guard<std::mutex> lock(group->mutex);
+            group->tailCommitHost = MVKBackendCostStats::hostSeconds();
+        }
+        double tailStart = timeline ? timeline->clock() : 0;
+        if (timeline) { timeline->record(MVKBackendTimelineKind::SignalPresent, signalStart, tailStart,
+                                        group->timelineID, queue->timelineID, signalCount, group->costPresentation ? 1 : 0); }
+        [queue->queue commit:&tailBuffer count:1 options:options.tail];
+        if (timeline) { timeline->record(MVKBackendTimelineKind::TailCommit, tailStart, timeline->clock(), group->timelineID, queue->timelineID); }
+    } else if (timeline) {
+        timeline->record(MVKBackendTimelineKind::SignalPresent, signalStart, timeline->clock(), group->timelineID, queue->timelineID);
+    }
+    submitLock.unlock();
+    {
+        std::lock_guard<std::mutex> lock(group->mutex);
+        group->submitFinished = true;
+    }
+    retireIfReady(group);
+    submitSpan.flags = 0;
+    return true;
+}
+
+bool MVKMetal4Submission::wait(uint64_t timeoutMilliseconds, NSError** error) const {
+    if (error) { *error = nil; }
+    std::unique_lock<std::mutex> lock(_state->mutex);
+    if (_state->phase == Phase::Recording || _state->phase == Phase::Ended) {
+        return fail(error, 3, @"Cannot wait for a submission that has not been committed.");
+    }
+    if (!_state->done.wait_until(lock, deadline(timeoutMilliseconds), [&] { return _state->phase == Phase::Completed || _state->error; })) {
+        return fail(error, 4, @"Timed out waiting for Metal 4; in-flight storage remains retained.");
+    }
+    return _state->error ? report(error, _state->error) : true;
+}
+
+bool MVKMetal4Submission::completed() const {
+    std::lock_guard<std::mutex> lock(_state->mutex);
+    return _state->phase == Phase::Completed;
+}
+
+bool MVKMetal4Queue::waitIdle(uint64_t timeoutMilliseconds, NSError** error) const {
+    if (error) { *error = nil; }
+    const auto until = deadline(timeoutMilliseconds);
+    std::unique_lock<std::timed_mutex> submitLock(_state->submitMutex, std::defer_lock);
+    if (!submitLock.try_lock_until(until)) {
+        return fail(error, 4, @"Timed out waiting for Metal 4 queue serialization; submitted work remains retained.");
+    }
+    std::unique_lock<std::mutex> lock(_state->stateMutex);
+    if (!_state->idle.wait_until(lock, until, [&] { return _state->pending == 0 || _state->firstError; })) {
+        return fail(error, 4, @"Timed out waiting for the Metal 4 queue; submitted work remains retained.");
+    }
+    return _state->firstError ? report(error, _state->firstError) : true;
+}
+
+uint64_t MVKMetal4Queue::completedSubmissionCount() const {
+    std::lock_guard<std::mutex> lock(_state->stateMutex);
+    return _state->completed;
+}
+
+MVKMetal4ResourcePoolStats MVKMetal4Queue::resourcePoolStats() const {
+    return _state->recordingPool->resourcePoolStats();
+}
+
+MVKMetal4ResourcePoolStats MVKMetal4RecordingPool::resourcePoolStats() const {
+    std::lock_guard<std::mutex> lock(_state->poolMutex);
+    auto stats = _state->poolStats;
+    stats.primaryIdle = _state->primaryPool.size();
+    stats.tailIdle = _state->tailPool.size();
+    stats.allocatorAvailable = _state->availableEpochs.size();
+    for (auto& pack : _state->primaryPool) {
+        stats.argumentTableGroupsIdle += pack->argumentTables.size();
+        stats.hostStorageIdleBytes += pack->hostStorageBytes();
+        stats.retainedObjectSlotsIdle += pack->retainedHighWater;
+    }
+    for (auto& storage : _state->completionPool) {
+        stats.hostStorageIdleBytes += storage->hostStorageBytes();
+        stats.retainedObjectSlotsIdle += storage->retainedHighWater;
+    }
+    return stats;
+}
+
+MVKMetal4QueueEncodingStats MVKMetal4Queue::encodingStats() const {
+    std::lock_guard<std::mutex> lock(_state->stateMutex);
+    auto stats = _state->encodingStats;
+    stats.completedBatches = _state->completed;
+    return stats;
+}
+
+std::shared_ptr<MVKBackendCostStats> MVKMetal4Queue::costStats() const { return _state->costStats; }
+
+void MVKMetal4Queue::notifyDeviceLost() {
+    NSError* error = [NSError errorWithDomain:@"MVKMetal4Submission" code:5
+        userInfo:@{NSLocalizedDescriptionKey: @"The Vulkan device lost a native submission; GPU storage remains retained until feedback."}];
+    failSignalNotificationOwners(_state, error);
+}
