+static bool metal4ProveNoExternalShaderWrites(const std::vector<uint32_t>& words,
+		const char* entryPoint, spv::ExecutionModel model) {
+	if (!entryPoint || (model != spv::ExecutionModelVertex && model != spv::ExecutionModelFragment) ||
+		words.size() < 5 || words[0] != spv::MagicNumber || words[1] < 0x00010000 ||
+		words[1] > spv::Version || (words[1] & 0xff0000ffu) || !words[3] || words[4]) { return false; }
+	struct Instruction { const uint32_t* words; uint32_t count; spv::Op op; };
+	std::vector<Instruction> instructions;
+	std::unordered_map<uint32_t, uint32_t> pointerStorage, resultTypes;
+	std::unordered_set<uint32_t> defined, glslImports, functionsWithBodies;
+	uint32_t currentFunction = 0, selectedEntry = 0;
+	auto validId = [&](uint32_t id) { return id && id < words[3]; };
+	auto literalEquals = [](const uint32_t* data, uint32_t count, const char* expected) {
+		const char* value = reinterpret_cast<const char*>(data);
+		const void* end = memchr(value, 0, size_t(count) * sizeof(uint32_t));
+		return end && size_t(static_cast<const char*>(end) - value) == strlen(expected) && strcmp(value, expected) == 0;
+	};
+	for (size_t offset = 5; offset < words.size();) {
+		uint32_t count = words[offset] >> spv::WordCountShift;
+		auto op = static_cast<spv::Op>(words[offset] & spv::OpCodeMask);
+		if (!count || count > words.size() - offset || !metal4KnownReadOnlyOpcode(op)) { return false; }
+		const uint32_t* w = words.data() + offset;
+		bool hasResult, hasType;
+		spv::HasResultAndType(op, &hasResult, &hasType);
+		if (hasResult) {
+			uint32_t resultIndex = hasType ? 2 : 1;
+			if (count <= resultIndex || !validId(w[resultIndex]) || !defined.insert(w[resultIndex]).second) { return false; }
+			if (hasType) {
+				if (!validId(w[1])) { return false; }
+				resultTypes.emplace(w[2], w[1]);
+			}
+		}
+		if (op == spv::OpTypePointer) {
+			if (count != 4 || !validId(w[3])) { return false; }
+			switch (w[2]) {
+				case spv::StorageClassUniformConstant: case spv::StorageClassInput: case spv::StorageClassUniform:
+				case spv::StorageClassOutput: case spv::StorageClassPrivate: case spv::StorageClassFunction:
+				case spv::StorageClassPushConstant: case spv::StorageClassStorageBuffer: break;
+				default: return false;
+			}
+			pointerStorage.emplace(w[1], w[2]);
+		} else if (op == spv::OpExtInstImport) {
+			if (count < 3 || !literalEquals(w + 2, count - 2, "GLSL.std.450")) { return false; }
+			glslImports.insert(w[1]);
+		} else if (op == spv::OpEntryPoint) {
+			if (count < 4 || !validId(w[2]) || (w[1] != spv::ExecutionModelVertex && w[1] != spv::ExecutionModelFragment)) { return false; }
+			if (w[1] == model && literalEquals(w + 3, count - 3, entryPoint)) { selectedEntry = w[2]; }
+		} else if (op == spv::OpFunction) {
+			if (count != 5 || currentFunction) { return false; }
+			currentFunction = w[2];
+		} else if (op == spv::OpLabel) {
+			if (!currentFunction) { return false; }
+			functionsWithBodies.insert(currentFunction);
+		} else if (op == spv::OpFunctionEnd) {
+			if (count != 1 || !currentFunction) { return false; }
+			currentFunction = 0;
+		}
+		instructions.push_back({w, count, op});
+		offset += count;
+	}
+	if (currentFunction || !selectedEntry || !functionsWithBodies.count(selectedEntry)) { return false; }
+	auto storageOf = [&](uint32_t id) -> uint32_t {
+		auto type = resultTypes.find(id);
+		if (type == resultTypes.end()) { return spv::StorageClassMax; }
+		auto storage = pointerStorage.find(type->second);
+		return storage == pointerStorage.end() ? uint32_t(spv::StorageClassMax) : storage->second;
+	};
+	auto localPointer = [&](uint32_t id) { return metal4LocalStorage(storageOf(id)); };
+	bool memoryModel = false;
+	for (const auto& instruction : instructions) {
+		const uint32_t* w = instruction.words;
+		uint32_t count = instruction.count;
+		auto op = instruction.op;
+		bool hasResult, hasType;
+		spv::HasResultAndType(op, &hasResult, &hasType);
+		// Logical pointer provenance is restricted to declarations, same-storage
+		// chains/copies and typed phi/select. Loaded/cast/returned pointers fail
+		// closed. Function pointer parameters retain their declared storage class.
+		if (hasType && pointerStorage.count(w[1])) {
+			uint32_t storage = pointerStorage.at(w[1]);
+			switch (op) {
+				case spv::OpVariable:
+					if (count < 4 || count > 5 || w[3] != storage || (count == 5 && !metal4LocalStorage(storage))) { return false; }
+					break;
+				case spv::OpFunctionParameter: if (count != 3) { return false; } break;
+				case spv::OpAccessChain: case spv::OpInBoundsAccessChain:
+				case spv::OpPtrAccessChain: case spv::OpInBoundsPtrAccessChain: case spv::OpCopyObject:
+					if (count < 4 || storageOf(w[3]) != storage) { return false; }
+					break;
+				case spv::OpSelect:
+					if (count != 6 || storageOf(w[4]) != storage || storageOf(w[5]) != storage) { return false; }
+					break;
+				case spv::OpPhi:
+					if (count < 5 || !(count & 1)) { return false; }
+					for (uint32_t i = 3; i < count; i += 2) { if (storageOf(w[i]) != storage) { return false; } }
+					break;
+				default: return false;
+			}
+		}
+		switch (op) {
+			case spv::OpMemoryModel:
+				if (count != 3 || memoryModel || w[1] != spv::AddressingModelLogical ||
+					(w[2] != spv::MemoryModelGLSL450 && w[2] != spv::MemoryModelVulkan)) { return false; }
+				memoryModel = true; break;
+			case spv::OpCapability:
+				if (count != 2 || w[1] == spv::CapabilityTransformFeedback || w[1] == spv::CapabilityLinkage ||
+					w[1] == spv::CapabilityPhysicalStorageBufferAddresses || w[1] == spv::CapabilityAddresses) { return false; }
+				break;
+			case spv::OpExecutionMode: case spv::OpExecutionModeId:
+				if (count < 3 || w[2] == spv::ExecutionModeXfb) { return false; }
+				break;
+			case spv::OpDecorate: case spv::OpDecorateId:
+				if (count < 3 || !metal4ReadOnlyDecoration(w[2])) { return false; } break;
+			case spv::OpMemberDecorate:
+				if (count < 4 || !metal4ReadOnlyDecoration(w[3])) { return false; } break;
+			case spv::OpStore: case spv::OpCopyMemory:
+				if (count < 3 || !localPointer(w[1])) { return false; } break;
+			case spv::OpCopyMemorySized:
+				if (count < 4 || !localPointer(w[1])) { return false; } break;
+			case spv::OpFunctionCall:
+				if (count < 4 || !functionsWithBodies.count(w[3])) { return false; } break;
+			case spv::OpBitcast:
+				if (count != 4 || storageOf(w[3]) != spv::StorageClassMax) { return false; } break;
+			case spv::OpSpecConstantOp:
+				if (count < 4 || !metal4PureValueOpcode(static_cast<spv::Op>(w[3]))) { return false; } break;
+			case spv::OpExtInst:
+				// GLSL.std.450 revision 3 has 1..81; IMix(47) is reserved.
+				// Modf(35) and Frexp(51) alone have an output pointer operand.
+				if (count < 5 || !glslImports.count(w[3]) || w[4] < 1 || w[4] > 81 || w[4] == 47) { return false; }
+				if ((w[4] == 35 || w[4] == 51) && (count != 7 || !localPointer(w[6]))) { return false; }
+				break;
+			default: break;
+		}
+	}
+	return memoryModel;
+}
