+}
+
+bool MVKMetal4Submission::addResource(id<MTLResource> resource, NSError** error) {
+    if (error) { *error = nil; }
+    std::lock_guard<std::mutex> lock(_state->mutex);
+    if (_state->phase != Phase::Recording || !resource) {
+        return fail(error, 3, @"Resources must belong to the recording submission's device.");
+    }
+    auto found = _state->objects.find((const void*)resource);
+    MVKMetal4SubmissionState::ObjectIdentity* identity;
+    if (found != _state->objects.end() && found->second.resident) {
+        identity = &found->second;
+        // Residency already owns this exact object, so its device/type cannot
+        // change or its address be reused while this batch is recording.
+        if (!identity->texture) { return true; }
+        if (!identity->drawableGeneration) { return true; } // Proven ordinary texture.
+        uint64_t generation = drawableRegistrationGeneration((id<MTLTexture>)resource);
+        if (generation != UINT64_MAX && identity->drawableGeneration == generation) { return true; }
+    } else {
+        if (resource.device != _state->storage->device) {
+            return fail(error, 3, @"Resources must belong to the recording submission's device.");
+        }
+        bool isTexture = [resource conformsToProtocol:@protocol(MTLTexture)];
+        identity = &_state->addResident(resource, !isTexture);
+        identity->texture = isTexture;
+    }
+    if (identity->texture) {
+        auto ownership = textureOwnership((id<MTLTexture>)resource);
+        if (ownership.ordinary) {
+            identity->drawableGeneration = 0;
+            return true;
+        }
+        // Acquisition metadata names the exact drawable. Keep its snapshot
+        // until operation completion, independently of later image acquisition.
+        auto keepDrawable = [&](id<MTLDrawable> drawable) {
+            if (std::find(_state->drawables.begin(), _state->drawables.end(), drawable) != _state->drawables.end()) { return true; }
+            if (!_state->retainOperationUnique(drawable)) {
+                return fail(error, 2, @"Could not allocate Metal 4 drawable ownership storage.");
+            }
+            _state->drawables.push_back(drawable);
+            return true;
+        };
+        if (ownership.binding) {
+            identity->drawableGeneration = ownership.generation;
+            return keepDrawable(ownership.binding->drawable);
+        }
+        // Only unknown/external textures retain reverse-registry discovery.
+        std::lock_guard<std::mutex> registryLock(drawableRegistryMutex);
+        ++_state->registrationStats.drawableRegistryLookups;
+        // Store before retaining the drawable, which may rehash objects.
+        identity->drawableGeneration = drawableRegistryGeneration.load(std::memory_order_relaxed);
+        id<MTLTexture> texture = (id<MTLTexture>)resource;
+        while (texture) {
+            auto entry = drawableRegistry.find(texture);
+            if (entry != drawableRegistry.end()) {
+                return keepDrawable(entry->second->drawable);
+            }
+            id<MTLTexture> parent = texture.parentTexture;
+            if (parent == texture) { break; }
+            texture = parent;
+        }
+    }
+    return true;
+}
+
+uint64_t MVKMetal4Submission::drawableRegistrationGeneration(id<MTLTexture> texture) {
+    while (texture) {
+        auto* source = static_cast<MVKMetal4TextureOwnership*>(objc_getAssociatedObject(texture, &textureOwnershipKey));
+        if (source) {
+            if (source->ordinary) { return 0; }
+            // Reading an incarnation needs no temporary drawable ownership or
+            // release callback. addResource takes the strong snapshot on miss.
+            if (!source->binding.expired()) { return source->generation; }
+        }
+        id<MTLTexture> parent = texture.parentTexture;
+        if (parent == texture) { break; }
+        texture = parent;
+    }
+    return drawableRegistryGeneration.load(std::memory_order_acquire);
+}
+
+uint64_t MVKMetal4Submission::drawableRegistryEpoch() {
+    return drawableRegistryGeneration.load(std::memory_order_acquire);
+}
