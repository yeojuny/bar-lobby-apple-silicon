+// Native Metal 4 uses first-vertex flat interpolation and fixed strip restart.
+// Convert Vulkan primitives to uint32 lists without changing their winding or
+// shader-visible vertex/base-instance identities. Host layout is asserted.
+struct Metal4PrimitiveConversion {
+	uint topology;
+	uint indexBytes;
+	// Bit0 rotates LAST to FIRST; bit1 reserves a second original-index result.
+	uint provokingLast;
+	uint outputCapacity;
+	ulong inputCapacity;
+	uint instanceMultiplier;
+	uint threadStride;
+};
+
+static uint metal4ReadIndex(const device uchar* indices, ulong position, uint bytes) {
+	if (bytes == 1) return indices[position];
+	if (bytes == 2) return reinterpret_cast<const device ushort*>(indices)[position];
+	if (bytes == 4) return reinterpret_cast<const device uint*>(indices)[position];
+	return uint(position);
+}
+
+static uint metal4PrimitiveCount(uint count, uint topology) {
+	switch (topology) {
+		case 0: return count;
+		case 1: return count / 2;
+		case 2: return count > 1 ? count - 1 : 0;
+		case 3: return count / 3;
+		default: return count > 2 ? count - 2 : 0;
+	}
+}
+
+static uint metal4PrimitiveSize(uint topology) { return topology == 0 ? 1 : topology < 3 ? 2 : 3; }
+
+static bool metal4ConversionValid(const device MTLDrawIndexedPrimitivesIndirectArguments& draw,
+								 constant Metal4PrimitiveConversion& parameters) {
+	return ulong(draw.indexStart) + draw.indexCount <= parameters.inputCapacity &&
+		ulong(draw.instanceCount) * parameters.instanceMultiplier <= 0xFFFFFFFFul;
+}
+
+static void metal4WriteTriangle(device uint* out, uint a, uint b, uint c, bool odd, bool last, bool fan) {
+	// Cyclic rotations preserve facing. Odd strips reverse their second edge.
+	if (last) { out[0] = c; out[1] = odd ? b : a; out[2] = odd ? a : b; }
+	else if (fan) { out[0] = b; out[1] = c; out[2] = a; }
+	else { out[0] = a; out[1] = odd ? c : b; out[2] = odd ? b : c; }
+}
+
+static void metal4ConvertPrimitive(const device uchar* indices,
+		const device MTLDrawIndexedPrimitivesIndirectArguments& source, device uint* output,
+		constant Metal4PrimitiveConversion& parameters, uint primitive, uint primitiveSize) {
+	uint first = parameters.topology == 1 || parameters.topology == 3 ? primitive * primitiveSize : primitive;
+	ulong base = source.indexStart;
+	uint a = metal4ReadIndex(indices, base + (parameters.topology == 5 ? 0 : first), parameters.indexBytes);
+	device uint* out = output + ulong(primitive) * primitiveSize;
+	if (primitiveSize == 1) { out[0] = a; return; }
+	uint b = metal4ReadIndex(indices, base + first + 1, parameters.indexBytes);
+	if (primitiveSize == 2) { out[0] = (parameters.provokingLast & 1u) ? b : a; out[1] = (parameters.provokingLast & 1u) ? a : b; return; }
+	uint c = metal4ReadIndex(indices, base + first + 2, parameters.indexBytes);
+	metal4WriteTriangle(out, a, b, c, parameters.topology == 4 && (primitive & 1),
+		(parameters.provokingLast & 1u) != 0, parameters.topology == 5);
+}
+
+kernel void metal4ConvertPrimitives(const device uchar* indices [[buffer(0)]],
+		const device MTLDrawIndexedPrimitivesIndirectArguments& source [[buffer(1)]],
+		device uint* output [[buffer(2)]],
+		device MTLDrawIndexedPrimitivesIndirectArguments& result [[buffer(3)]],
+		constant Metal4PrimitiveConversion& parameters [[buffer(4)]], uint position [[thread_position_in_grid]]) {
+	uint primitiveSize = metal4PrimitiveSize(parameters.topology);
+	uint primitiveCount = metal4PrimitiveCount(source.indexCount, parameters.topology);
+	bool valid = parameters.threadStride && metal4ConversionValid(source, parameters) &&
+		ulong(primitiveCount) * primitiveSize <= parameters.outputCapacity;
+	if (position == 0) {
+		result = source;
+		result.indexStart = 0;
+		result.indexCount = valid ? primitiveCount * primitiveSize : 0;
+		result.instanceCount = valid ? source.instanceCount * parameters.instanceMultiplier : 0;
+	}
+	if (!valid) return;
+	// The GPU-produced count remains authoritative. A 64-bit induction variable
+	// also keeps the last increment from wrapping for a near-UINT32_MAX count.
+	for (ulong primitive = position; primitive < primitiveCount; primitive += parameters.threadStride) {
+		metal4ConvertPrimitive(indices, source, output, parameters, uint(primitive), primitiveSize);
+	}
