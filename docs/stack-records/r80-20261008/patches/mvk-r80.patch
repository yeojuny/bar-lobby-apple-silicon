+// A single queue adoption/feedback owner for an ordered array of independent
+// recordings. Children never own this object. Retired GPU storage and pending
+// signal observation remain separate, just as for the length-one path.
+struct MVKMetal4SubmissionGroup {
+    struct Retirement {
+        std::vector<std::function<void()>> cleanup;
+        std::vector<std::function<void(NSError*)>> errors, completed;
+        std::unique_ptr<MVKMetal4ResourcePack> pack;
+        MVKMetal4AllocatorUse allocatorUse;
+    };
+    std::shared_ptr<MVKMetal4QueueState> owner;
+    std::vector<std::shared_ptr<MVKMetal4SubmissionState>> children;
+    // Preallocated before publication; callbacks only swap existing ownership.
+    std::vector<Retirement> retirement;
+    std::vector<id<MTL4CommandBuffer>> workBuffers;
+    struct WorkRange { size_t first, count; };
+    // No extra range/event/feedback storage for the ordinary single commit.
+    std::vector<WorkRange> workRanges;
+    std::vector<uint8_t> rangeFeedback;
+    std::vector<double> rangeCommitHosts;
+    size_t remainingRangeFeedback = 0;
+    id<MTLEvent> counterEvent = nil;
+    mutable std::mutex mutex;
+    Phase phase = Phase::Ended;
+    NSError* error = nil;
+    bool workFeedbackDone = false, tailFeedbackDone = false, submitFinished = false;
+    bool errorHandlersRunning = false;
+    GPUStorage gpuStorage = GPUStorage::InUse;
+    SignalNotification signalNotification = SignalNotification::None;
+    uint64_t notificationGeneration = 0;
+    unsigned notificationSlot = MVKMetal4QueueState::notificationCapacity;
+    const MVKMetal4EventValue* notificationSignal = nullptr;
+    MVKMetal4TailRecording tail;
+    uint64_t timelineID = 0;
+    double workCommitHost = 0, tailCommitHost = 0;
+    bool costPresentation = false;
+    ~MVKMetal4SubmissionGroup() { [counterEvent release]; [error release]; }
+};
+
+namespace {
+// Reserve only a mask bit during preparation. The strong owner is published
+// atomically with the whole group's Submitted/pending state.
+struct NotificationSlotReservation {
+    std::shared_ptr<MVKMetal4QueueState> queue;
+    unsigned slot = MVKMetal4QueueState::notificationCapacity;
+    explicit NotificationSlotReservation(std::shared_ptr<MVKMetal4QueueState> owner)
+        : queue(std::move(owner)) {}
+    bool reserve() {
+        std::lock_guard<std::mutex> lock(queue->stateMutex);
+        if (queue->firstError || !queue->signalListener || !queue->freeNotificationSlots) { return false; }
+        slot = __builtin_ctzll(queue->freeNotificationSlots);
+        queue->freeNotificationSlots &= ~(uint64_t{1} << slot);
+        return true;
+    }
+    void release() {
+        if (slot == MVKMetal4QueueState::notificationCapacity) { return; }
+        {
+            std::lock_guard<std::mutex> lock(queue->stateMutex);
+            if (!queue->notificationOwners[slot]) { queue->freeNotificationSlots |= uint64_t{1} << slot; }
+        }
+        slot = MVKMetal4QueueState::notificationCapacity;
+    }
+    ~NotificationSlotReservation() { release(); }
+};
+
+// Every group acquires child mutexes in address order, independent of its work
+// order and destination queue. Storage for these locks is allocated before claim.
+struct SubmissionChildLocks {
+    std::vector<std::shared_ptr<MVKMetal4SubmissionState>> ordered;
+    std::vector<std::unique_lock<std::mutex>> held;
+    explicit SubmissionChildLocks(const std::vector<std::shared_ptr<MVKMetal4SubmissionState>>& children)
+        : ordered(children), held(children.size()) {
+        std::sort(ordered.begin(), ordered.end(), [](const auto& a, const auto& b) {
+            return std::less<MVKMetal4SubmissionState*>{}(a.get(), b.get());
+        });
+    }
+    void lock() {
+        for (size_t i = 0; i < ordered.size(); ++i) { held[i] = std::unique_lock<std::mutex>(ordered[i]->mutex); }
+    }
+    void unlock() {
+        for (size_t i = held.size(); i; --i) { held[i - 1].unlock(); }
+    }
+};
+
+// Caller holds the group mutex. Move all first-error handlers before allowing
+// any retirement election; errors wake child waiters without releasing storage.
+bool publishGroupError(const std::shared_ptr<MVKMetal4SubmissionGroup>& group, NSError* error) {
+    if (group->error) { return false; }
+    group->error = [error retain];
+    bool hasHandlers = false;
+    for (size_t i = 0; i < group->children.size(); ++i) {
+        auto& batch = group->children[i];
+        std::lock_guard<std::mutex> lock(batch->mutex);
+        if (!batch->error) { batch->error = [error retain]; }
+        group->retirement[i].errors.swap(batch->errorHandlers);
+        hasHandlers = hasHandlers || !group->retirement[i].errors.empty();
+    }
+    group->errorHandlersRunning = hasHandlers;
+    return hasHandlers;
+}
+
+void notifyGroupWaiters(const std::shared_ptr<MVKMetal4SubmissionGroup>& group) {
+    for (auto& batch : group->children) { batch->done.notify_all(); }
+    group->owner->idle.notify_all();
+}
+
+void runGroupErrorHandlers(const std::shared_ptr<MVKMetal4SubmissionGroup>& group) {
+    for (size_t i = 0; i < group->children.size(); ++i) {
+        auto& handlers = group->retirement[i].errors;
+        for (auto& handler : handlers) { handler(group->children[i]->error); }
+        handlers.clear();
+    }
+    std::lock_guard<std::mutex> lock(group->mutex);
+    group->errorHandlersRunning = false;
+}
+
+// All native work, the one tail (when present), and finished scheduling protect
+// every recording's allocator use. Actual-event observation can retain semantic
+// owners after GPU storage is reclaimed. Mandatory cleanup for ALL children
+// precedes ALL workload completion callbacks, including a final Vulkan fence.
+void retireIfReady(std::shared_ptr<MVKMetal4SubmissionGroup> group) {
+    auto queue = group->owner;
+    std::shared_ptr<MVKMetal4SubmissionGroup> notificationOwner;
+    MVKMetal4TailRecording tail;
+    bool reclaimGPU = false, completeNow = false;
+    {
+        std::lock_guard<std::mutex> lock(group->mutex);
+        if (group->phase != Phase::Submitted || !group->submitFinished ||
+            !group->workFeedbackDone || !group->tailFeedbackDone || group->errorHandlersRunning ||
+            group->gpuStorage == GPUStorage::Reclaiming) { return; }
+        completeNow = group->signalNotification != SignalNotification::Pending;
+        if (!completeNow && group->gpuStorage == GPUStorage::Reclaimed) { return; }
+        if (group->signalNotification != SignalNotification::None) {
+            std::lock_guard<std::mutex> queueLock(queue->stateMutex);
+            if (queue->firstError &&
+                (group->signalNotification != SignalNotification::Failed || !group->error)) { return; }
+            if (completeNow && group->notificationSlot < MVKMetal4QueueState::notificationCapacity) {
+                auto& owner = queue->notificationOwners[group->notificationSlot];
+                if (owner.get() == group.get()) {
+                    notificationOwner = std::move(owner);
+                    queue->freeNotificationSlots |= uint64_t{1} << group->notificationSlot;
+                }
+            }
+            if (completeNow) { group->notificationSlot = MVKMetal4QueueState::notificationCapacity; }
+        }
+        if (completeNow) { group->phase = Phase::Retiring; }
+        if (group->gpuStorage == GPUStorage::InUse) {
+            group->gpuStorage = GPUStorage::Reclaiming;
+            reclaimGPU = true;
+            tail = std::move(group->tail);
+        }
+        for (size_t i = 0; i < group->children.size(); ++i) {
+            auto& batch = group->children[i];
+            auto& retired = group->retirement[i];
+            std::lock_guard<std::mutex> childLock(batch->mutex);
+            if (completeNow) {
+                batch->phase = Phase::Retiring;
+                retired.completed.swap(batch->completedHandlers);
+            }
+            if (reclaimGPU) {
+                retired.cleanup.swap(batch->cleanup);
+                retired.pack = std::move(batch->pack);
+                retired.allocatorUse = std::move(batch->allocatorUse);
+                batch->buffer = nil; batch->allocator = nil; batch->residency = nil;
+            }
+        }
+    }
+    notificationOwner.reset();
+    auto* timeline = mvkBackendTimeline();
+    const uint64_t groupID = group->timelineID, queueID = queue->timelineID;
+    double phaseStart = timeline ? timeline->clock() : 0;
+    if (timeline && completeNow) {
+        timeline->record(MVKBackendTimelineKind::RetireReady, phaseStart, phaseStart, groupID, queueID);
+    }
+    if (reclaimGPU) {
+        for (size_t i = 0; i < group->children.size(); ++i) {
+            auto& batch = group->children[i];
+            auto& cleanup = group->retirement[i].cleanup;
+            for (auto& action : cleanup) { action(); }
+            cleanup.clear();
+            batch->clearGPUReferences();
+            batch->transientArgumentTables.clear();
+        }
+        if (timeline) {
+            double now = timeline->clock();
+            timeline->record(MVKBackendTimelineKind::MandatoryCleanup, phaseStart, now, groupID, queueID);
+            phaseStart = now;
+        }
+    }
+    if (completeNow) {
+        {
+            std::lock_guard<std::mutex> lock(queue->stateMutex);
+            if (queue->firstError) {
+                if (group->counterEvent) { [queue->failedEvents addObject:group->counterEvent]; }
+                for (auto& batch : group->children) {
+                    for (auto& event : batch->waits) { [queue->failedEvents addObject:event.event]; }
+                    for (auto& event : batch->signals) { [queue->failedEvents addObject:event.event]; }
+                }
+            }
+        }
+        for (size_t i = 0; i < group->children.size(); ++i) {
+            auto& batch = group->children[i];
+            batch->clearOperationReferences();
+            auto& handlers = group->retirement[i].completed;
+            for (auto& handler : handlers) { handler(batch->error); }
+            handlers.clear();
+        }
+        if (timeline) {
+            double now = timeline->clock();
+            timeline->record(MVKBackendTimelineKind::CompletionHandlers, phaseStart, now, groupID, queueID);
+            phaseStart = now;
+        }
+    }
+    if (reclaimGPU) {
+        // One pool lock for all uses in this already-proven group. Shared epochs
+        // reset only on their last user; callbacks have already run independently
+        // of unrelated records and of this cache/reset work. No allocations here.
+        const size_t children = group->retirement.size();
+        releaseAllocatorUses(queue->storage, children + (tail ? 1 : 0),
+            [&](size_t i) -> MVKMetal4AllocatorUse& {
+                return i < children ? group->retirement[i].allocatorUse : tail.allocatorUse;
+            });
+        for (size_t i = 0; i < group->children.size(); ++i) {
+            auto& batch = group->children[i];
+            auto& pack = group->retirement[i].pack;
+            if (pack) { batch->cacheEmptyHostStorage(*pack); }
+            if (completeNow) { batch->cacheEmptyCompletionStorage(); }
+            recyclePack(batch->storage, std::move(pack), false,
+                        completeNow ? std::move(batch->completionStorage) : nullptr);
+        }
+        recyclePack(queue->storage, std::move(tail.pack), true);
+        {
+            std::lock_guard<std::mutex> lock(group->mutex);
+            group->gpuStorage = GPUStorage::Reclaimed;
+        }
+        if (timeline) {
+            timeline->record(MVKBackendTimelineKind::CacheRecycle, phaseStart, timeline->clock(), groupID, queueID);
+        }
+    }
+    if (!completeNow) {
+        retireIfReady(group); // Recheck a signal/error arriving during cleanup.
+        return;
+    }
+    if (!reclaimGPU) {
+        for (auto& batch : group->children) {
+            batch->cacheEmptyCompletionStorage();
+            recycleCompletionStorage(batch->storage, std::move(batch->completionStorage));
+        }
+    }
+    for (auto& batch : group->children) {
+        std::lock_guard<std::mutex> lock(batch->mutex);
+        batch->phase = Phase::Completed;
+    }
+    {
+        std::lock_guard<std::mutex> lock(group->mutex);
+        std::lock_guard<std::mutex> queueLock(queue->stateMutex);
+        group->phase = Phase::Completed;
+        --queue->pending; ++queue->completed;
+        globalCompletedSubmissions.fetch_add(1, std::memory_order_relaxed);
+    }
+    notifyGroupWaiters(group);
+}
+
+void recordSignalNotification(const std::shared_ptr<MVKMetal4SubmissionGroup>& group, uint64_t generation) {
+    {
+        std::lock_guard<std::mutex> lock(group->mutex);
+        if (group->phase != Phase::Submitted || group->notificationGeneration != generation ||
+            group->signalNotification != SignalNotification::Pending) { return; }
+        std::lock_guard<std::mutex> queueLock(group->owner->stateMutex);
+        if (group->owner->firstError) { return; }
+        group->signalNotification = SignalNotification::Succeeded;
+    }
+    retireIfReady(group);
+}
+
+// Queue -> group cycles are detached under stateMutex, then errors are published
+// under group -> child locks outside it. GPU feedback remains mandatory.
+void failSignalNotificationOwners(const std::shared_ptr<MVKMetal4QueueState>& queue, NSError* error) {
+    std::array<std::shared_ptr<MVKMetal4SubmissionGroup>, MVKMetal4QueueState::notificationCapacity> failed;
+    NSError* actualError;
+    {
+        std::lock_guard<std::mutex> lock(queue->stateMutex);
+        if (!queue->firstError) { queue->firstError = [error retain]; }
+        queue->storage->poisoned.store(true, std::memory_order_release);
+        actualError = [queue->firstError retain];
+        failed.swap(queue->notificationOwners);
+        queue->freeNotificationSlots = UINT64_MAX;
+    }
+    queue->idle.notify_all();
+    for (auto& group : failed) {
+        if (!group) { continue; }
+        bool runErrors = false;
+        {
+            std::lock_guard<std::mutex> lock(group->mutex);
+            if (group->phase != Phase::Submitted || group->signalNotification == SignalNotification::None) { continue; }
+            runErrors = publishGroupError(group, actualError);
+            group->signalNotification = SignalNotification::Failed;
+            group->notificationSlot = MVKMetal4QueueState::notificationCapacity;
+        }
+        notifyGroupWaiters(group);
+        if (runErrors) { runGroupErrorHandlers(group); }
+        retireIfReady(group);
+    }
+    [actualError release];
+}
+
+void recordFeedback(const std::shared_ptr<MVKMetal4SubmissionGroup>& group,
+                    id<MTL4CommitFeedback> feedback, bool isTail, size_t workRange = 0) {
+    auto queue = group->owner;
+    auto cost = queue->costStats;
+    auto* timeline = mvkBackendTimeline();
+    double callbackHost = (cost || timeline) ? MVKBackendCostStats::hostSeconds() : 0, commitHost = 0;
+    bool runErrors = false;
+    {
+        std::lock_guard<std::mutex> lock(group->mutex);
+        if (group->phase != Phase::Submitted) { return; }
+        if (isTail ? group->tailFeedbackDone : group->rangeFeedback.empty()
+            ? (workRange != 0 || group->workFeedbackDone)
+            : (workRange >= group->rangeFeedback.size() || group->rangeFeedback[workRange])) { return; }
+        if (cost || timeline) {
+            commitHost = isTail ? group->tailCommitHost : group->rangeCommitHosts.empty()
+                ? group->workCommitHost : group->rangeCommitHosts[workRange];
+        }
+        if (feedback.error) {
+            runErrors = publishGroupError(group, feedback.error);
+            std::lock_guard<std::mutex> queueLock(queue->stateMutex);
+            if (!queue->firstError) { queue->firstError = [feedback.error retain]; }
+            queue->storage->poisoned.store(true, std::memory_order_release);
+        }
+        if (isTail) { group->tailFeedbackDone = true; }
+        else if (group->rangeFeedback.empty()) { group->workFeedbackDone = true; }
+        else {
+            group->rangeFeedback[workRange] = 1;
+            group->workFeedbackDone = --group->remainingRangeFeedback == 0;
+        }
+    }
+    if (timeline) {
+        double start = feedback.GPUStartTime, end = feedback.GPUEndTime;
+        bool validGPU = !feedback.error && std::isfinite(start) && std::isfinite(end) &&
+            start > 0 && end >= start && start >= commitHost - 0.001 && end <= callbackHost + 0.001;
+        uint32_t flags = (group->costPresentation ? 1u : 0u) | (feedback.error ? 2u : 0u) |
+                         (validGPU ? 0u : 4u) | (isTail ? 8u : 0u);
+        timeline->record(MVKBackendTimelineKind::CallbackEntry, callbackHost, callbackHost,
+                         group->timelineID, queue->timelineID, 0, flags, commitHost, callbackHost);
+        if (validGPU) {
+            timeline->record(isTail ? MVKBackendTimelineKind::GPUTail : MVKBackendTimelineKind::GPUWork,
+                             start, end, group->timelineID, queue->timelineID, 0, flags, commitHost, callbackHost);
+        }
+    }
+    if (cost) {
+        cost->recordGPU(feedback.error ? 0 : feedback.GPUStartTime, feedback.GPUEndTime,
+                        commitHost, callbackHost, isTail, group->costPresentation);
+    }
+    notifyGroupWaiters(group);
+    if (feedback.error) { failSignalNotificationOwners(queue, feedback.error); }
+    if (runErrors) { runGroupErrorHandlers(group); }
+    retireIfReady(group);
+}
+
+MVKMetal4TailRecording makeRetirementTail(const std::shared_ptr<MVKMetal4QueueState>& queue,
+                                         NSError** error) {
+    MVKMetal4TailRecording tail;
+    tail.pack = acquirePack(queue->storage, true, error, tail.allocatorUse);
+    if (!tail) { return {}; }
+    tail.allocatorUse.begin(tail.pack->buffer);
+    tail.pack->commitStableResidency();
+    // begin clears command-buffer associations, not set membership. Reattach
+    // the persistent marker set on every tail recording, including pool reuse.
+    [tail.pack->buffer useResidencySet:tail.pack->stableResidency];
+    id<MTL4ComputeCommandEncoder> encoder = [tail.pack->buffer computeCommandEncoder];
+    if (!encoder) {
+        // Open cancellation discards this epoch from future writers, preserving
+        // every earlier primary's bytes/leases for adoption retry or execution.
+        fail(error, 2, @"Could not encode event retirement marker."); return {};
+    }
+    [encoder fillBuffer:tail.pack->marker range:NSMakeRange(0, 4) value:0];
+    [encoder endEncoding];
+    [tail.pack->buffer endCommandBuffer];
+    tail.allocatorUse.end();
+    return tail;
+}
+
+// A valid Metal/Vulkan signal strictly increases the value at execution.
+// Shared events expose their current value, allowing an already-invalid request
+// to fail before any queue mutation. This is not a race-proof validation layer:
+// callers must also obey Vulkan's pending-signal/host-signal ordering rules.
+bool validSignalValue(id<MTLEvent> event, uint64_t value) {
+    return value && (![event conformsToProtocol:@protocol(MTLSharedEvent)] ||
+                     value > ((id<MTLSharedEvent>)event).signaledValue);
+}
+
+// The group can use one actual-value notification only when its entire operation
+// list has exactly one MVK internal timeline signal and no input waits/drawables.
+bool eligibleSignalNotification(MVKMetal4SubmissionGroup& group) {
+    group.notificationSignal = nullptr;
+    for (auto& batch : group.children) {
+        if (!batch->waits.empty() || !batch->drawables.empty() || !batch->presentations.empty()) { return false; }
+        for (auto& signal : batch->signals) {
+            if (group.notificationSignal || !signal.internalTimelineSignal ||
+                ![signal.event conformsToProtocol:@protocol(MTLSharedEvent)]) { return false; }
+            group.notificationSignal = &signal;
+        }
+    }
+    return group.notificationSignal != nullptr;
+}
+
+// Registration happens before publication/queue mutation. The callback owns
+// only a weak reference to this fresh group, so abandoned registrations cannot
+// observe or complete a later retry of the same ended children.
+bool registerSignalNotification(const std::shared_ptr<MVKMetal4SubmissionGroup>& group, uint64_t generation) {
+    std::weak_ptr<MVKMetal4SubmissionGroup> weakGroup = group;
+    auto& signal = *group->notificationSignal;
+    @try {
+        [(id<MTLSharedEvent>)signal.event notifyListener:group->owner->signalListener atValue:signal.value
+            block:^(id<MTLSharedEvent>, uint64_t) {
+                @autoreleasepool {
+                    if (auto owner = weakGroup.lock()) { recordSignalNotification(owner, generation); }
+                }
+            }];
+        return true;
+    } @catch (NSException* exception) { (void)exception; return false; }
+}
+
+// Check the actual event values again immediately before publication, and reject
+// signals within this ordered group that do not strictly increase one event.
+// Values remain immutable after each recording's end(). Invalid concurrent host
+// advancement is still excluded by the same Metal/Vulkan caller contract.
+bool validGroupSignals(const MVKMetal4SubmissionGroup& group, NSError** error) {
+    for (size_t i = 0; i < group.children.size(); ++i) {
+        auto& signals = group.children[i]->signals;
+        for (size_t j = 0; j < signals.size(); ++j) {
+            auto& signal = signals[j];
+            if (!validSignalValue(signal.event, signal.value)) {
+                return fail(error, 3, @"An event signal must increase its current value at submission.");
+            }
+            for (size_t before = 0; before <= i; ++before) {
+                auto& prior = group.children[before]->signals;
+                size_t count = before == i ? j : prior.size();
+                for (size_t k = 0; k < count; ++k) {
+                    if (prior[k].event == signal.event && prior[k].value >= signal.value) {
+                        return fail(error, 3, @"Ordered group signals must strictly increase each event.");
+                    }
+                }
+            }
+        }
+    }
+    return true;
+}
+
+// The submit lock is held. All children are exclusively claimed before this
+// function; publication takes group -> sorted child -> queue locks. Poison sees
+// the complete strong notification owner and Submitted state, or no group.
+bool publishPreparedSubmission(const std::shared_ptr<MVKMetal4SubmissionGroup>& group,
+                               SubmissionChildLocks& children,
+                               MVKMetal4TailRecording tail,
+                               bool notificationRegistered, NotificationSlotReservation& reservation,
+                               NSError** error) {
+    std::lock_guard<std::mutex> groupLock(group->mutex);
+    children.lock();
+    struct UnlockChildren { SubmissionChildLocks& locks; ~UnlockChildren() { locks.unlock(); } } unlock{children};
+    auto queue = group->owner;
+    for (auto& batch : group->children) {
+        if (batch->phase != Phase::Ended || batch->owner != queue) {
+            return fail(error, 3, @"Only an exclusively claimed, ended group may be committed.");
+        }
+    }
+    if (!validGroupSignals(*group, error)) { return false; }
+    std::lock_guard<std::mutex> queueLock(queue->stateMutex);
+    if (queue->firstError) { return report(error, queue->firstError); }
+    if (queue->storage->poisoned.load(std::memory_order_acquire)) {
+        return fail(error, 5, @"Recording storage was invalidated before queue adoption.");
+    }
+    if (notificationRegistered) {
+        if (reservation.slot >= MVKMetal4QueueState::notificationCapacity ||
+            queue->notificationOwners[reservation.slot] ||
+            (queue->freeNotificationSlots & (uint64_t{1} << reservation.slot))) {
+            return fail(error, 3, @"No reserved slot for native signal notification.");
+        }
+        group->signalNotification = SignalNotification::Pending;
+        group->notificationSlot = reservation.slot;
+        queue->notificationOwners[reservation.slot] = group;
+        reservation.slot = MVKMetal4QueueState::notificationCapacity;
+    }
+    group->tail = std::move(tail);
+    group->tailFeedbackDone = !group->tail;
+    group->phase = Phase::Submitted;
+    for (auto& batch : group->children) { batch->phase = Phase::Submitted; }
+    ++queue->pending;
+    if (mvkMetal4QueueStatsEnabled() && queue->encodingStats.submittedBatches != UINT64_MAX) {
+        ++queue->encodingStats.submittedBatches;
+    }
+    return true;
+}
+
+bool addEvent(const std::shared_ptr<MVKMetal4SubmissionState>& batch,
+              id<MTLEvent> event, uint64_t value, bool signal, NSError** error,
+              bool internalTimelineSignal = false) {
+    if (error) { *error = nil; }
+    std::lock_guard<std::mutex> lock(batch->mutex);
+    if (batch->phase != Phase::Recording || !event ||
+        (event.device && event.device != batch->storage->device)) {
+        return fail(error, 3, @"Events must be registered while recording and be usable on this device.");
+    }
+    if (signal && !validSignalValue(event, value)) {
+        return fail(error, 3, @"An event signal must increase its current value.");
+    }
+    if (!batch->retainOperationUnique(event)) {
+        return fail(error, 2, @"Could not allocate Metal 4 event ownership storage.");
+    }
+    (signal ? batch->signals : batch->waits).push_back({ event, value, signal && internalTimelineSignal });
+    return true;
+}
+}
