+bool mvkMetal4ShaderHasNoExternalWrites(const std::vector<uint32_t>& words,
+		const char* entryPoint, spv::ExecutionModel model) {
+#if defined(__cpp_exceptions) || defined(__EXCEPTIONS)
+	try { return metal4ProveNoExternalShaderWrites(words, entryPoint, model); }
+	catch (...) { return false; }
+#else
+	// A build without exception handling must not turn allocation failure into
+	// a positive side-effect proof. Leave the optional scheduling metadata false.
+	return false;
+#endif
+}
