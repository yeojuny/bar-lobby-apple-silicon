+bool MVKMetal4Submission::addPresentation(id<MTLDrawable> drawable, double timeSeconds,
+                                         std::function<void()> beforePresent, NSError** error) {
+    if (error) { *error = nil; }
+    std::lock_guard<std::mutex> lock(_state->mutex);
+    if (_state->phase != Phase::Recording || !drawable || !beforePresent || timeSeconds < 0) {
+        return fail(error, 3, @"Presentation requires a drawable and preparation callback while recording.");
+    }
+    for (auto& presentation : _state->presentations) {
+        if (presentation.drawable == drawable) { return fail(error, 3, @"A drawable may be presented only once per submission."); }
+    }
+    if (!_state->retainOperationUnique(drawable)) {
+        return fail(error, 2, @"Could not allocate Metal 4 presentation ownership storage.");
+    }
+    if (std::find(_state->drawables.begin(), _state->drawables.end(), drawable) == _state->drawables.end()) {
+        _state->drawables.push_back(drawable);
+    }
+    _state->presentations.push_back({drawable, timeSeconds, std::move(beforePresent)});
+    return true;
+}
