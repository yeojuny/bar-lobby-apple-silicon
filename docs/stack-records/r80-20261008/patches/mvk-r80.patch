+++ b/MoltenVK/MoltenVK/GPUObjects/MVKMetal4ClippedPath.h
@@ -0,0 +1,181 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include "spirv_reflect.hpp"
+#include <vulkan/vulkan.h>
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+// Sufficient visibility proof for valid ordinary vertex SPIR-V, not an optimizer.
+// A returned block has a straight-line suffix ending with one constant Position
+// strictly outside the same depth clip plane for every invocation taking it.
+// The consumer must ALSO prove primitive-uniform control of that block. Nothing
+// here makes undefined values invariant or changes the shader/culling behavior.
+namespace mvk_metal4_clipped {
+using namespace SPIRV_CROSS_NAMESPACE;
+inline bool staticDepthClip(const VkGraphicsPipelineCreateInfo* info,bool allPointClipPlanes) {
+    if(!info||!allPointClipPlanes||!info->pRasterizationState||info->pRasterizationState->depthClampEnable)return false;
+    // In the absence of EXT_depth_clip_enable, no depth clamp means depth clip.
+    for(auto* p=(const VkBaseInStructure*)info->pRasterizationState->pNext;p;p=p->pNext){
+        if(p->sType==VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_DEPTH_CLIP_STATE_CREATE_INFO_EXT){
+            if(!((const VkPipelineRasterizationDepthClipStateCreateInfoEXT*)p)->depthClipEnable)return false;
+        }else if(p->sType!=VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_PROVOKING_VERTEX_STATE_CREATE_INFO_EXT&&
+                 p->sType!=VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_LINE_STATE_CREATE_INFO)return false;
+        // Line mode/stipple controls rasterization after clipping. Zink chains
+        // this state even on triangle pipelines; it cannot undo depth clipping.
+    }
+    if(!info->pViewportState)return false;
+    for(auto* p=(const VkBaseInStructure*)info->pViewportState->pNext;p;p=p->pNext)
+        if(p->sType!=VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_DEPTH_CLIP_CONTROL_CREATE_INFO_EXT)return false;
+    if(info->pDynamicState)for(uint32_t i=0;i<info->pDynamicState->dynamicStateCount;++i){
+        switch(info->pDynamicState->pDynamicStates[i]){
+            case VK_DYNAMIC_STATE_DEPTH_CLAMP_ENABLE_EXT:case VK_DYNAMIC_STATE_DEPTH_CLIP_ENABLE_EXT:
+            case VK_DYNAMIC_STATE_DEPTH_CLAMP_RANGE_EXT:case VK_DYNAMIC_STATE_VIEWPORT_W_SCALING_NV:
+            case VK_DYNAMIC_STATE_VIEWPORT_W_SCALING_ENABLE_NV:case VK_DYNAMIC_STATE_VIEWPORT_SWIZZLE_NV:
+            case VK_DYNAMIC_STATE_CONSERVATIVE_RASTERIZATION_MODE_EXT:return false;
+            default:break;
+        }
+    }
+    return true;
+}
+class SuffixProof : public CompilerReflection {
+    struct Op { spv::Op code;const uint32_t* a;uint32_t n; };
+    struct Pointer { uint32_t root=0;std::vector<uint32_t> path; };
+    struct Constant { uint32_t type=0;std::vector<uint32_t> bits; };
+    std::unordered_map<uint32_t,Op> _defs;
+    std::unordered_map<uint32_t,std::vector<Op>> _ops;
+    std::unordered_map<uint32_t,uint32_t> _next;
+    std::unordered_set<uint32_t> _returns;
+    uint32_t _position=0;std::vector<uint32_t> _positionPath;
+    bool _valid=false;
+    bool shape(uint32_t id) const {
+        const auto& t=get_type(id);
+        return t.array.empty()&&t.member_types.empty()&&t.columns==1&&t.width==32&&t.vecsize>=1&&t.vecsize<=4&&
+            (t.basetype==SPIRType::Float||t.basetype==SPIRType::Int||t.basetype==SPIRType::UInt);
+    }
+    bool literal(uint32_t id,uint32_t& v) const {
+        // Producers can express a literal access-chain index as a bitcast of
+        // constant float bits. Evaluate only pure constants, never a load.
+        auto constant=value(id,{});
+        if(constant.bits.size()!=1)return false;
+        const auto& t=get_type(constant.type);
+        if(t.basetype!=SPIRType::Int&&t.basetype!=SPIRType::UInt)return false;
+        v=constant.bits[0];return true;
+    }
+    Pointer pointer(uint32_t id,unsigned depth=0) const {
+        if(depth>32)return {};auto it=_defs.find(id);if(it==_defs.end())return {};const auto& op=it->second;
+        if(op.code==spv::OpVariable)return {id,{}};
+        if(op.code==spv::OpCopyObject&&op.n==3)return pointer(op.a[2],depth+1);
+        if((op.code==spv::OpAccessChain||op.code==spv::OpInBoundsAccessChain)&&op.n>=3){
+            auto p=pointer(op.a[2],depth+1);if(!p.root||p.path.size()+op.n-3>8)return {};
+            for(uint32_t i=3;i<op.n;++i){uint32_t v;if(!literal(op.a[i],v))return {};p.path.push_back(v);}return p;
+        }
+        return {};
+    }
+    Constant value(uint32_t id,const std::unordered_map<uint32_t,Constant>& loads,unsigned depth=0) const {
+        if(depth>64)return {};auto it=_defs.find(id);if(it==_defs.end())return {};const auto& op=it->second;
+        if(op.n<2||!shape(op.a[0]))return {};Constant result{op.a[0],{}};
+        const auto& type=get_type(result.type);
+        switch(op.code){
+            case spv::OpConstant:if(op.n==3&&type.vecsize==1)result.bits={op.a[2]};break;
+            case spv::OpConstantNull:result.bits.resize(type.vecsize,0);break;
+            case spv::OpCopyObject:case spv::OpBitcast:{
+                if(op.n!=3)break;auto v=value(op.a[2],loads,depth+1);result.bits=std::move(v.bits);break;
+            }
+            case spv::OpConstantComposite:case spv::OpCompositeConstruct:
+                for(uint32_t i=2;i<op.n;++i){auto v=value(op.a[i],loads,depth+1);if(v.bits.empty())return {};result.bits.insert(result.bits.end(),v.bits.begin(),v.bits.end());if(result.bits.size()>4)return {};}
+                break;
+            case spv::OpCompositeExtract:{
+                if(op.n!=4)break;auto v=value(op.a[2],loads,depth+1);if(op.a[3]<v.bits.size())result.bits={v.bits[op.a[3]]};break;
+            }
+            case spv::OpLoad:{
+                // A load denotes its value AT the load, not at a later use.
+                auto found=loads.find(id);if(found!=loads.end())result.bits=found->second.bits;break;
+            }
+            case spv::OpFNegate:{
+                if(op.n!=3||type.basetype!=SPIRType::Float)break;auto v=value(op.a[2],loads,depth+1);
+                result.bits=v.bits;for(auto& word:result.bits)word^=0x80000000u;break;
+            }
+            default:break;
+        }
+        if(result.bits.size()!=type.vecsize)return {};return result;
+    }
+    bool suffix(uint32_t block) const {
+        std::unordered_map<uint32_t,Constant> locals,loads;std::unordered_set<uint32_t> visited;
+        Constant position;
+        while(block&&visited.insert(block).second&&visited.size()<=512){
+            auto found=_ops.find(block);if(found==_ops.end())return false;
+            for(const auto& op:found->second){
+                if(op.code==spv::OpFunctionCall||op.code==spv::OpCopyMemory||op.code==spv::OpCopyMemorySized||
+                   (op.code==spv::OpExtInst&&op.n>=4&&(op.a[3]==35||op.a[3]==51)))return false;
+                if(op.code==spv::OpLoad){
+                    if(op.n<3)return false;
+                    loads.erase(op.a[1]);
+                    if(op.n>3&&(op.a[3]&~(spv::MemoryAccessAlignedMask|spv::MemoryAccessNontemporalMask)))continue;
+                    auto src=pointer(op.a[2]);auto found=locals.find(src.root);
+                    if(found!=locals.end()&&shape(op.a[0])){
+                        Constant v{op.a[0],{}};
+                        if(src.path.empty())v.bits=found->second.bits;
+                        else if(src.path.size()==1&&src.path[0]<found->second.bits.size())v.bits={found->second.bits[src.path[0]]};
+                        if(v.bits.size()==get_type(v.type).vecsize)loads.emplace(op.a[1],std::move(v));
+                    }
+                }
+                if(op.code!=spv::OpStore)continue;
+                if(op.n<2||(op.n>2&&op.a[2]))return false;
+                auto dst=pointer(op.a[0]);if(!dst.root)return false;
+                auto v=value(op.a[1],loads);
+                if(dst.root==_position){position={};if(dst.path==_positionPath)position=v;}
+                locals.erase(dst.root);
+                if(dst.path.empty()&&!v.bits.empty())locals.emplace(dst.root,std::move(v));
+            }
+            if(_returns.count(block)){
+                if(position.bits.size()!=4||get_type(position.type).basetype!=SPIRType::Float)return false;
+                float v[4];std::memcpy(v,position.bits.data(),sizeof(v));
+                return std::all_of(v,v+4,[](float x){return std::isfinite(x);})&&std::isnormal(v[2])&&std::isnormal(v[3])&&v[3]>0&&(v[2]<-v[3]||v[2]>v[3]);
+            }
+            auto next=_next.find(block);if(next==_next.end())return false;block=next->second;
+        }
+        return false;
+    }
+public:
+    SuffixProof(const std::vector<uint32_t>& words,const char* entry):CompilerReflection(words){
+        if(!entry||words.size()<5||words.size()>262144||words[3]>32768)return;
+        set_entry_point(entry,spv::ExecutionModelVertex);const auto& fn=get<SPIRFunction>(get_entry_point().self);
+        if(fn.blocks.size()>512)return;
+        for(auto variable:get_active_interface_variables()){
+            if(get_storage_class(variable)!=spv::StorageClassOutput)continue;
+            const auto& t=get_type(get_type_from_variable(variable).parent_type);
+            auto add=[&](std::vector<uint32_t> path){if(_position)return false;_position=variable;_positionPath=std::move(path);return true;};
+            if(has_decoration(variable,spv::DecorationBuiltIn)&&get_decoration(variable,spv::DecorationBuiltIn)==spv::BuiltInPosition){if(!add({}))return;}
+            for(uint32_t i=0;i<t.member_types.size();++i)if(has_member_decoration(t.self,i,spv::DecorationBuiltIn)&&get_member_decoration(t.self,i,spv::DecorationBuiltIn)==spv::BuiltInPosition){if(!add({i}))return;}
+        }
+        if(!_position)return;
+        for(auto block:fn.blocks){const auto& b=get<SPIRBlock>(block);if(b.terminator==SPIRBlock::Direct)_next[block]=b.next_block;else if(b.terminator==SPIRBlock::Return)_returns.insert(block);}
+        uint32_t function=0,block=0;
+        for(size_t offset=5;offset<words.size();){
+            uint32_t n=words[offset]>>16;if(!n||n>words.size()-offset)return;
+            Op op{static_cast<spv::Op>(words[offset]&spv::OpCodeMask),words.data()+offset+1,n-1};
+            // This narrow constant proof assumes exact 32-bit values. Refuse
+            // optional reduced precision, including decoration groups, rather
+            // than assume a barely-outside value survives rounding unchanged.
+            if(((op.code==spv::OpDecorate||op.code==spv::OpDecorateId)&&op.n>=2&&op.a[1]==spv::DecorationRelaxedPrecision)||
+               (op.code==spv::OpMemberDecorate&&op.n>=3&&op.a[2]==spv::DecorationRelaxedPrecision))return;
+            if(op.code==spv::OpFunction){if(op.n<2)return;function=op.a[1];block=0;}
+            if(op.code==spv::OpLabel){if(op.n!=1)return;block=op.a[0];}
+            bool result,type;spv::HasResultAndType(op.code,&result,&type);
+            if(result){uint32_t i=type?1:0;if(op.n<=i)return;_defs.emplace(op.a[i],op);}
+            if(function==fn.self&&block)_ops[block].push_back(op);
+            if(op.code==spv::OpFunctionEnd){function=0;block=0;}
+            offset+=n;
+        }
+        _valid=true;
+    }
+    std::unordered_set<uint32_t> blocks() const {
+        std::unordered_set<uint32_t> result;if(_valid)for(const auto& block:_ops)if(suffix(block.first))result.insert(block.first);return result;
+    }
+};
+inline std::unordered_set<uint32_t> blocks(const std::vector<uint32_t>& words,const char* entry){return SuffixProof(words,entry).blocks();}
+} // namespace mvk_metal4_clipped
diff --git a/b/MoltenVK/MoltenVK/GPUObjects/MVKMetal4InvariantDiagnostics.h b/MoltenVK/MoltenVK/GPUObjects/MVKMetal4InvariantDiagnostics.h
new file mode 100644
index 0000000..4958cea
--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKMetal4InvariantDiagnostics.h
@@ -0,0 +1,142 @@
+#pragma once
+
+// Optional CPU-only attribution. Never controls a rendering/proof decision.
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+enum class MVKMetal4InvariantGate : uint8_t {
+    Unsupported, NoFlat, ExternalWrites, Builtins, Layout, ProofRejected, Admitted
+};
+
+namespace mvk_metal4_diagnostic {
+inline const char* gateName(MVKMetal4InvariantGate gate) noexcept {
+    switch (gate) {
+        case MVKMetal4InvariantGate::NoFlat: return "no_provoking_required";
+        case MVKMetal4InvariantGate::ExternalWrites: return "external_write_proof_failed";
+        case MVKMetal4InvariantGate::Builtins: return "raster_builtin_or_reflection_guard";
+        case MVKMetal4InvariantGate::Layout: return "unsupported_vertex_layout";
+        case MVKMetal4InvariantGate::ProofRejected: return "invariant_proof_failed_or_exception";
+        case MVKMetal4InvariantGate::Admitted: return "invariant_admitted";
+        default: return "unsupported_stages";
+    }
+}
+
+inline std::string quote(const char* value) {
+    std::string out = "\"";
+    if (value) for (const unsigned char* p = (const unsigned char*)value; *p; ++p) {
+        if (*p == '"' || *p == '\\') { out += '\\'; out += char(*p); }
+        else if (*p < 32) { char escaped[7]; std::snprintf(escaped, sizeof(escaped), "\\u%04x", *p); out += escaped; }
+        else { out += char(*p); }
+    }
+    out += '"'; return out;
+}
+
+class Collector;
+struct Record {
+    std::shared_ptr<Collector> owner;
+    uint64_t id = 0;
+    std::atomic<uint64_t> draws{0};
+    ~Record();
+    void draw() noexcept {
+        auto old = draws.load(std::memory_order_relaxed);
+        while (old != UINT64_MAX && !draws.compare_exchange_weak(old, old + 1, std::memory_order_relaxed)) {}
+    }
+};
+
+class Collector : public std::enable_shared_from_this<Collector> {
+    struct Module { uint64_t hash; std::vector<uint32_t> words; std::string file; };
+    std::mutex _mutex;
+    std::string _directory;
+    FILE* _manifest = nullptr;
+    std::vector<Module> _modules;
+    uint64_t _eligible = 0, _captured = 0, _omittedPipelines = 0, _omittedMetadataPipelines = 0;
+    uint64_t _moduleRequests = 0, _duplicateModules = 0, _omittedModuleRequests = 0;
+    uint64_t _spvBytes = 0, _errors = 0, _finished = 0;
+
+    std::string module(uint64_t hash, const std::vector<uint32_t>& words) {
+        ++_moduleRequests;
+        for (const auto& item : _modules) if (item.hash == hash && item.words == words) {
+            ++_duplicateModules; return quote(item.file.c_str());
+        }
+        if (words.empty() || words.size() > (maxSPVBytes - _spvBytes) / sizeof(uint32_t)) {
+            ++_omittedModuleRequests; return "null";
+        }
+        char name[96];
+        std::snprintf(name, sizeof(name), "module-%016llx-%zu-%zu.spv", (unsigned long long)hash, words.size(), _modules.size());
+        Module saved{hash, words, name}; // Allocate before writing an immutable file.
+        std::string path = _directory + "/" + name;
+        FILE* file = std::fopen(path.c_str(), "wx");
+        if (!file) { ++_errors; ++_omittedModuleRequests; return "null"; }
+        bool written = std::fwrite(words.data(), sizeof(uint32_t), words.size(), file) == words.size();
+        written = std::fclose(file) == 0 && written;
+        if (!written) { std::remove(path.c_str()); ++_errors; ++_omittedModuleRequests; return "null"; }
+        _spvBytes += words.size() * sizeof(uint32_t);
+        _modules.emplace_back(std::move(saved));
+        return quote(name);
+    }
+public:
+    static constexpr uint64_t maxPipelines = 256, maxSPVBytes = 32 * 1024 * 1024, maxMetadataBytes = 64 * 1024;
+    explicit Collector(const char* directory) : _directory(directory) {
+        // Host supplies a fresh, app-private directory. Do not overwrite a prior run.
+        _manifest = std::fopen((_directory + "/invariant-pipelines.jsonl").c_str(), "wx");
+        if (!_manifest) { _errors = 1; }
+    }
+    ~Collector() noexcept {
+        if (_manifest) {
+            std::fprintf(_manifest, "{\"event\":\"summary\",\"eligiblePipelines\":%llu,\"capturedPipelines\":%llu,\"omittedPipelines\":%llu,\"omittedMetadataPipelines\":%llu,\"moduleRequests\":%llu,\"uniqueModules\":%zu,\"duplicateModuleRequests\":%llu,\"omittedModuleRequests\":%llu,\"spvBytes\":%llu,\"finishedPipelines\":%llu,\"ioOrAllocationErrors\":%llu,\"pipelineCap\":256,\"spvByteCap\":33554432,\"metadataByteCap\":65536}\n",
+                (unsigned long long)_eligible, (unsigned long long)_captured, (unsigned long long)_omittedPipelines,
+                (unsigned long long)_omittedMetadataPipelines,
+                (unsigned long long)_moduleRequests, _modules.size(), (unsigned long long)_duplicateModules,
+                (unsigned long long)_omittedModuleRequests, (unsigned long long)_spvBytes,
+                (unsigned long long)_finished, (unsigned long long)_errors);
+            std::fclose(_manifest);
+        }
+        std::fprintf(stderr, "[mvk-invariant-diagnostic] captured=%llu omitted=%llu spvBytes=%llu omittedModuleRequests=%llu errors=%llu finished=%llu\n",
+            (unsigned long long)_captured, (unsigned long long)_omittedPipelines, (unsigned long long)_spvBytes,
+            (unsigned long long)_omittedModuleRequests, (unsigned long long)_errors, (unsigned long long)_finished);
+    }
+    std::shared_ptr<Record> capture(uint64_t vertexHash, const std::vector<uint32_t>& vertex,
+                                    uint64_t fragmentHash, const std::vector<uint32_t>& fragment,
+                                    const std::string& metadata) noexcept {
+        std::lock_guard<std::mutex> lock(_mutex);
+        ++_eligible;
+        if (!_manifest || _captured >= maxPipelines) { ++_omittedPipelines; return {}; }
+        if (metadata.size() > maxMetadataBytes) { ++_omittedPipelines; ++_omittedMetadataPipelines; return {}; }
+        try {
+            auto record = std::make_shared<Record>();
+            record->id = _eligible;
+            std::string vs = module(vertexHash, vertex), fs = module(fragmentHash, fragment);
+            if (std::fprintf(_manifest, "{\"event\":\"pipeline\",\"id\":%llu,\"vertexSPV\":%s,\"fragmentSPV\":%s,%s}\n",
+                             (unsigned long long)record->id, vs.c_str(), fs.c_str(), metadata.c_str()) < 0) {
+                ++_errors; ++_omittedPipelines; return {};
+            }
+            ++_captured;
+            record->owner = shared_from_this();
+            return record;
+        } catch (...) { ++_errors; ++_omittedPipelines; return {}; }
+    }
+    void finish(uint64_t id, uint64_t draws) noexcept {
+        std::lock_guard<std::mutex> lock(_mutex);
+        if (_manifest && std::fprintf(_manifest, "{\"event\":\"pipeline_retired\",\"id\":%llu,\"encodedDrawUses\":%llu}\n",
+                                      (unsigned long long)id, (unsigned long long)draws) < 0) { ++_errors; }
+        ++_finished;
+    }
+};
+inline Record::~Record() { if (owner) { owner->finish(id, draws.load(std::memory_order_relaxed)); } }
+
+// Process-local owner plus per-pipeline ownership keeps teardown safe across devices.
+inline std::shared_ptr<Collector> collector() noexcept {
+    static auto value = []() -> std::shared_ptr<Collector> {
+        const char* directory = std::getenv("MVK_METAL4_INVARIANT_DIAGNOSTIC_DIR");
+        if (!directory || !*directory) { return {}; }
+        try { return std::make_shared<Collector>(directory); } catch (...) { return {}; }
+    }();
+    return value;
+}
+} // namespace mvk_metal4_diagnostic
