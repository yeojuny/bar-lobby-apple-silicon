+VkResult MVKQueue::handleMetal4Error(NSError* error, bool executionFailure) {
+	VkResult result = VK_ERROR_INITIALIZATION_FAILED;
+	bool physicalLoss = false;
+	if ([error.domain isEqualToString:MTL4CommandQueueErrorDomain]) {
+		// These values differ from MTLCommandBufferError; never use the old switch.
+		switch (error.code) {
+			case MTL4CommandQueueErrorTimeout: result = VK_TIMEOUT; break;
+			case MTL4CommandQueueErrorOutOfMemory: result = VK_ERROR_OUT_OF_DEVICE_MEMORY; break;
+			case MTL4CommandQueueErrorNotPermitted:
+			case MTL4CommandQueueErrorAccessRevoked:
+				physicalLoss = true; result = VK_ERROR_DEVICE_LOST; break;
+			default: result = VK_ERROR_DEVICE_LOST; break;
+		}
+	} else if ([error.domain isEqualToString:@"MVKMetal4Submission"]) {
+		switch (error.code) {
+			case 1: case 3: result = VK_ERROR_FEATURE_NOT_PRESENT; break;
+			case 2: result = VK_ERROR_OUT_OF_DEVICE_MEMORY; break;
+			case 4: result = VK_TIMEOUT; break;
+			case 5: result = VK_ERROR_DEVICE_LOST; break;
+			default: break;
+		}
+	}
+	reportError(result, "Native Metal 4 %s failed (%s:%li): %s", executionFailure ? "execution" : "submission",
+		error ? error.domain.UTF8String : "unknown", (long)(error ? error.code : 0),
+		error ? error.localizedDescription.UTF8String : "no error description");
