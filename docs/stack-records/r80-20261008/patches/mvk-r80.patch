@@ -0,0 +1,91 @@
+/* Copyright (c) 2026. Licensed under the Apache License, Version 2.0. */
+#pragma once
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <cstdint>
+#include <cstddef>
+#include <utility>
+
+// CPU allocation incarnations, not ownership of native storage. A cache must
+// separately retain its Metal objects until it removes their residency. Shared
+// registrations keep one incarnation; removing the last creates a hard boundary
+// even if an external owner later registers the same native object again.
+class MVKMetal4AllocationLifetimes {
+public:
+    using Token = std::weak_ptr<const uint8_t>;
+    void add(const void* object) {
+        if (!object) { return; }
+        std::lock_guard<std::mutex> lock(_mutex);
+        auto result = _entries.try_emplace(object);
+        auto& entry = result.first->second;
+        if (result.second) { entry.incarnation = std::make_shared<const uint8_t>(0); }
+        ++entry.owners;
+    }
+    void remove(const void* object) {
+        std::lock_guard<std::mutex> lock(_mutex);
+        auto found = _entries.find(object);
+        if (found != _entries.end() && --found->second.owners == 0) { _entries.erase(found); }
+    }
+    Token get(const void* object) {
+        std::lock_guard<std::mutex> lock(_mutex);
+        auto found = _entries.find(object);
+        return found == _entries.end() ? Token{} : Token(found->second.incarnation);
+    }
+private:
+    struct Entry { uint64_t owners = 0; std::shared_ptr<const uint8_t> incarnation; };
+    std::mutex _mutex;
+    std::unordered_map<const void*, Entry> _entries;
+};
+
+// Metadata only: the pack must separately retain each admitted native object.
+// A pack calls beginRecording only after exclusive acquisition, never in flight.
+class MVKMetal4StableAllocationCache {
+public:
+    static constexpr size_t maxCount = 256;
+    static constexpr uint64_t maxBytes = 8ull * 1024 * 1024;
+    struct Entry {
+        MVKMetal4AllocationLifetimes::Token incarnation;
+        uint64_t bytes;
+        bool used;
+    };
+    bool touch(const void* object) {
+        auto found = _entries.find(object);
+        if (found == _entries.end()) { return false; }
+        // Even after the Vulkan owner expires, the pack still owns this exact
+        // native allocation. Do not change GPU-visible membership mid-recording.
+        found->second.used = true;
+        return true;
+    }
+    bool insert(const void* object, MVKMetal4AllocationLifetimes::Token incarnation, uint64_t bytes) {
+        if (!object || incarnation.expired() || !bytes || bytes > maxBytes ||
+            _entries.size() >= maxCount || bytes > maxBytes - _bytes || _entries.count(object)) { return false; }
+        _entries.emplace(object, Entry{std::move(incarnation), bytes, true});
+        _bytes += bytes;
+        return true;
+    }
+    template<class Remove> void beginRecording(Remove remove) {
+        for (auto it = _entries.begin(); it != _entries.end();) {
+            if (!it->second.used || it->second.incarnation.expired()) {
+                // The caller stages set removal now and must commit ALL removals
+                // before releasing any native objects returned through this hook.
+                remove(it->first);
+                _bytes -= it->second.bytes;
+                it = _entries.erase(it);
+            } else {
+                it->second.used = false;
+                ++it;
+            }
+        }
+    }
+    const auto& entries() const { return _entries; }
+    uint64_t bytes() const { return _bytes; }
+    uint64_t hostStorageBytes() const {
+        // Known payload only; standard allocator bookkeeping is not reported.
+        return (_entries.bucket_count() > 1 ? _entries.bucket_count() * sizeof(void*) : 0) +
+            _entries.size() * sizeof(decltype(_entries)::value_type);
+    }
+private:
+    std::unordered_map<const void*, Entry> _entries;
+    uint64_t _bytes = 0;
+};
diff --git a/b/MoltenVK/MoltenVK/GPUObjects/MVKMetal4ClippedPath.h b/MoltenVK/MoltenVK/GPUObjects/MVKMetal4ClippedPath.h
