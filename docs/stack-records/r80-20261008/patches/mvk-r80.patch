+std::chrono::steady_clock::time_point deadline(uint64_t milliseconds) {
+    auto now = std::chrono::steady_clock::now();
+    auto room = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::time_point::max() - now).count();
+    return milliseconds >= static_cast<uint64_t>(room)
+        ? std::chrono::steady_clock::time_point::max()
+        : now + std::chrono::milliseconds(milliseconds);
