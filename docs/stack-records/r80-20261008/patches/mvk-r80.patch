+id<MTLBuffer> MVKMetal4Submission::uploadBytes(const void* bytes, NSUInteger length, NSError** error) {
+    if (error) { *error = nil; }
+    if (!bytes || !length) { fail(error, 3, @"Inline uploads require nonempty data."); return nil; }
+    id<MTLBuffer> buffer = [_state->storage->device newBufferWithBytes:bytes length:length
+                                                        options:MTLResourceStorageModeShared];
+    if (!buffer) { fail(error, 2, @"Could not allocate Metal 4 upload storage."); return nil; }
+    bool added = addResource(buffer, error);
+    [buffer release];
+    return added ? buffer : nil;
+}
