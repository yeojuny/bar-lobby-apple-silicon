+
+void MVKMetal4Submission::addEncodingStats(const MVKMetal4EncodingStats& stats) {
+    if (!mvkMetal4StatsEnabled()) { return; }
+    auto diagnosticQueue = _state->diagnosticQueue.lock();
+    auto cost = diagnosticQueue ? diagnosticQueue->costStats : nullptr;
+    const double recordHost = cost ? MVKBackendCostStats::hostSeconds() : 0;
+    {
+        std::lock_guard<std::mutex> lock(_state->mutex);
+        if (_state->phase != Phase::Recording) { return; }
+        mergeEncodingStats(_state->encodingStats, stats);
+    }
+    // One collector lock after the encoding-local counters have been produced.
+    // Never acquire a collector lock or read a clock in a draw/binding loop.
+    if (cost) { cost->recordEncoding(stats, recordHost); }
+}
+
+bool MVKMetal4Submission::deferUntilSubmit(std::function<void()> action, NSError** error) {
+    if (error) { *error = nil; }
+    std::lock_guard<std::mutex> lock(_state->mutex);
+    if (_state->phase != Phase::Recording || !action) {
+        return fail(error, 3, @"Host state must be staged while recording.");
+    }
+    _state->hostStateActions.push_back(std::move(action));
+    return true;
+}
+
+bool MVKMetal4Submission::end(NSError** error) {
+    if (error) { *error = nil; }
+    const bool logStats = batchStatsEnabled();
+    const bool queueStats = mvkMetal4QueueStatsEnabled();
+    MVKMetal4EncodingStats stats;
+    {
+        std::lock_guard<std::mutex> lock(_state->mutex);
+        if (_state->phase != Phase::Recording) { return fail(error, 3, @"Submission already ended."); }
+        if (_state->error) { return report(error, _state->error); }
+        if (_state->pack->dynamicResidencyHasAllocations) {
+            [_state->residency commit];
+            [_state->buffer useResidencySet:_state->residency];
+        }
+        _state->pack->commitStableResidency();
+        // begin clears prior associations. Apply every used set for this recording;
+        // stable membership survives retirement and contains only owned uploads
+        // and explicitly eligible native buffers. Textures, imports, oversized
+        // uploads and uncached overflow retain the dynamic path.
+        [_state->buffer useResidencySet:_state->pack->stableResidency];
+        [_state->buffer endCommandBuffer];
+        // Immutable CPU preparation plans serve recording only. Ending drops
+        // those weak-resource metadata lists, not native retention/residency.
+        _state->preparedGroups.clear();
+        _state->allocatorUse.end();
+        _state->phase = Phase::Ended;
+        if (logStats || queueStats) { stats = _state->encodingStats; }
+        if (queueStats) {
+            if (auto queue = _state->diagnosticQueue.lock()) {
+                std::lock_guard<std::mutex> queueLock(queue->stateMutex);
+                auto& total = queue->encodingStats;
+                mergeEncodingStats(total.encoding, stats);
+                if (total.endedBatches != UINT64_MAX) { ++total.endedBatches; }
+            }
+        }
+    }
+    if (logStats) {
+        // Queue-only diagnostics never take the per-batch I/O path.
+        logEncodingStats("mvk-metal4-stats", stats, 1);
+    }
+    return true;
+}
