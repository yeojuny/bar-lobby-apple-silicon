+// Queue operations outlive the command allocator when an actual signal observer
+// is still pending. Cache only empty capacity, independently of GPU work packs.
+struct MVKMetal4CompletionStorage {
+    NSMutableArray* retained = nil;
+    size_t retainedHighWater = 0;
+    std::vector<MVKMetal4EventValue> waits, signals;
+    std::vector<id<MTLDrawable>> drawables;
+    std::vector<MVKMetal4Presentation> presentations;
+    uint64_t hostStorageBytes() const {
+        return waits.capacity() * sizeof(MVKMetal4EventValue) + signals.capacity() * sizeof(MVKMetal4EventValue) +
+            drawables.capacity() * sizeof(id<MTLDrawable>) + presentations.capacity() * sizeof(MVKMetal4Presentation);
+    }
