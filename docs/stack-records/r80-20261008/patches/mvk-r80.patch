+		handleMetal4Error(gpuError, true);
+	}, &error) || !batch->addCompletedHandler([owner](NSError*) {}, &error) || !batch->end(&error) || !_metal4Queue->submit(batch, &error)) {
+		return handleMetal4Error(error, false);
+	}
+	// CPU-emulated semaphores use the same immediate acquire signal as before.
+	semaphore->encodeDeferredSignal(nil, deferredToken);
+	return VK_SUCCESS;
