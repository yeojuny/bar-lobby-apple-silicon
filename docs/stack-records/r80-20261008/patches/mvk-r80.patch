+static_assert(sizeof(Metal4PrimitiveConversion) == 32 && offsetof(Metal4PrimitiveConversion, inputCapacity) == 16);
+static_assert(VK_PRIMITIVE_TOPOLOGY_POINT_LIST == 0 && VK_PRIMITIVE_TOPOLOGY_LINE_LIST == 1 &&
