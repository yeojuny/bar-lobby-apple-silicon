+namespace {
+void removeAllocatorAvailableLocked(MVKMetal4RecordingPoolState& storage,
+                                    MVKMetal4AllocatorEpoch& epoch) {
+    if (!epoch.available) { return; }
+    auto& pool = storage.availableEpochs;
+    for (size_t i = 0; i < pool.size(); ++i) {
+        if (pool[i].get() != &epoch) { continue; }
+        // The caller's use/reset owner strongly holds epoch, so erasing this
+        // reference cannot release a native object while poolMutex is held.
+        if (i + 1 != pool.size()) { pool[i] = std::move(pool.back()); }
+        pool.pop_back();
+        storage.poolStats.idleBytes -= epoch.idleCharge;
+        epoch.idleCharge = 0; epoch.available = false;
+        return;
+    }
+    assert(false && "Allocator availability membership must be unique.");
+}
+
+void discardAllocatorLocked(MVKMetal4RecordingPoolState& storage, MVKMetal4AllocatorEpoch& epoch) {
+    removeAllocatorAvailableLocked(storage, epoch);
+    if (epoch.state != MVKMetal4AllocatorState::DiscardOnly) { ++storage.poolStats.allocatorDiscarded; }
+    epoch.state = MVKMetal4AllocatorState::DiscardOnly;
+}
+
+void offerAllocatorLocked(MVKMetal4RecordingPoolState& storage,
+                          const std::shared_ptr<MVKMetal4AllocatorEpoch>& epoch) {
+    assert(!epoch->writer);
+    if (storage.poisoned.load(std::memory_order_acquire)) {
+        discardAllocatorLocked(storage, *epoch); return;
+    }
+    if (epoch->state != MVKMetal4AllocatorState::Appendable) { return; }
+    if (!epoch->available && storage.availableEpochs.size() >= MVKMetal4ResourcePoolStats::maxAvailableAllocatorEpochs) {
+        epoch->state = MVKMetal4AllocatorState::Sealed;
+        if (!epoch->liveUses) { discardAllocatorLocked(storage, *epoch); }
+        return;
+    }
+    // Live epochs cost no idle charge. In particular, an already-available
+    // Appendable epoch must be charged when its last GPU/unsubmitted user leaves.
+    if (!epoch->liveUses && !epoch->idleCharge) {
+        if (epoch->allocatedBytes > MVKMetal4ResourcePoolStats::maxIdleBytes - storage.poolStats.idleBytes) {
+            discardAllocatorLocked(storage, *epoch); return;
+        }
+        epoch->idleCharge = epoch->allocatedBytes;
+        storage.poolStats.idleBytes += epoch->idleCharge;
+    }
+    if (!epoch->available) {
+        epoch->available = true;
+        storage.availableEpochs.push_back(epoch); // Capacity reserved at creation.
+    }
+}
+
+// Caller holds poolMutex and has checked poison. Reserve recording service in
+// the same critical section as the pack and empty completion capacity.
+MVKMetal4AllocatorUse takeAllocatorLocked(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage) {
+    if (storage->availableEpochs.empty()) { return {}; }
+    auto epoch = std::move(storage->availableEpochs.back()); storage->availableEpochs.pop_back();
+    assert(!epoch->writer && epoch->state == MVKMetal4AllocatorState::Appendable);
+    storage->poolStats.idleBytes -= epoch->idleCharge;
+    epoch->idleCharge = 0; epoch->available = false;
+    epoch->writer = true; ++epoch->liveUses;
+    ++storage->poolStats.allocatorReused;
+    return {storage, std::move(epoch)};
+}
+
+MVKMetal4AllocatorUse createAllocatorUse(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage,
+                                       NSError** error) {
+    // No writer or GPU wait: simultaneous open recordings get different storage.
+    auto epoch = std::make_shared<MVKMetal4AllocatorEpoch>();
+    epoch->device = [storage->device retain];
+    epoch->allocator = [storage->device newCommandAllocator];
+    if (!epoch->allocator) { fail(error, 2, @"Could not allocate Metal 4 command storage."); return {}; }
+    // Also account for cold reservations cancelled before any native begin.
+    // New allocators, like reset allocators, contain no live command bytes.
+    epoch->allocatedBytes = [epoch->allocator allocatedSize];
+    epoch->resetAllocatedBytes = epoch->allocatedBytes;
+    {
+        std::lock_guard<std::mutex> lock(storage->poolMutex);
+        if (storage->poisoned.load(std::memory_order_acquire)) {
+            fail(error, 5, @"Recording storage belongs to a lost device."); return {};
+        }
+        epoch->writer = true; epoch->liveUses = 1;
+        ++storage->poolStats.allocatorCreated;
+    }
+    return {storage, std::move(epoch)};
+}
+
+// No ownership is destroyed under the mutex. Every released use retains its
+// epoch until the outside-lock finish pass, including the one reset election.
+void releaseAllocatorLocked(MVKMetal4AllocatorUse& use) {
+    if (!use.epoch || use.phase == MVKMetal4AllocatorUsePhase::Released) { return; }
+    auto& storage = *use.storage;
+    auto& epoch = *use.epoch;
+    const bool reservedRollback = use.phase == MVKMetal4AllocatorUsePhase::Reserved;
+    if (use.phase == MVKMetal4AllocatorUsePhase::Recording) { discardAllocatorLocked(storage, epoch); }
+    if (use.phase == MVKMetal4AllocatorUsePhase::Recording || use.phase == MVKMetal4AllocatorUsePhase::Reserved) {
+        assert(epoch.writer); epoch.writer = false;
+    }
+    assert(epoch.liveUses); --epoch.liveUses;
+    use.phase = MVKMetal4AllocatorUsePhase::Released;
+    if (epoch.liveUses) {
+        // No native attachment was begun: return its recording service even
+        // while older ended/unsubmitted/GPU users still own the same bytes.
+        if (reservedRollback && epoch.state == MVKMetal4AllocatorState::Appendable) {
+            offerAllocatorLocked(storage, use.epoch);
+        }
+        return;
+    }
+    assert(!epoch.writer);
+    if (storage.poisoned.load(std::memory_order_acquire)) { discardAllocatorLocked(storage, epoch); }
+    if (epoch.state == MVKMetal4AllocatorState::Sealed) {
+        removeAllocatorAvailableLocked(storage, epoch);
+        epoch.state = MVKMetal4AllocatorState::Resetting;
+        use.resetElected = true;
+    } else if (epoch.state == MVKMetal4AllocatorState::Appendable) {
+        offerAllocatorLocked(storage, use.epoch);
+    }
+}
+
+template<class UseAt> void releaseAllocatorUses(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage,
+                                                size_t count, UseAt useAt) {
+    {
+        std::lock_guard<std::mutex> lock(storage->poolMutex);
+        for (size_t i = 0; i < count; ++i) { releaseAllocatorLocked(useAt(i)); }
+    }
+    for (size_t i = 0; i < count; ++i) { useAt(i).finishRelease(); }
+}
+}
+
+void MVKMetal4AllocatorUse::begin(id<MTL4CommandBuffer> buffer) {
+    assert(epoch && phase == MVKMetal4AllocatorUsePhase::Reserved);
+    // If native begin throws/fails partway through, cancellation must not infer
+    // that no recording attachment exists and reoffer its memory.
+    phase = MVKMetal4AllocatorUsePhase::Recording;
+    [buffer beginCommandBufferWithAllocator:epoch->allocator];
+}
+
+void MVKMetal4AllocatorUse::end() {
+    assert(epoch && phase == MVKMetal4AllocatorUsePhase::Recording);
+    uint64_t bytes = [epoch->allocator allocatedSize]; // Still the exclusive writer.
+    std::lock_guard<std::mutex> lock(storage->poolMutex);
+    epoch->allocatedBytes = bytes; ++epoch->recordings;
+    epoch->writer = false; phase = MVKMetal4AllocatorUsePhase::Ended;
+    const uint64_t growth = bytes > epoch->resetAllocatedBytes ? bytes - epoch->resetAllocatedBytes : 0;
+    if (epoch->recordings >= MVKMetal4ResourcePoolStats::maxAllocatorEpochRecordings ||
+        growth >= MVKMetal4ResourcePoolStats::maxAllocatorEpochGrowthBytes) {
+        epoch->state = MVKMetal4AllocatorState::Sealed;
+    }
+    offerAllocatorLocked(*storage, epoch);
+}
+
+void MVKMetal4AllocatorUse::discardOpen() {
+    if (!epoch || phase != MVKMetal4AllocatorUsePhase::Recording) { return; }
+    std::lock_guard<std::mutex> lock(storage->poolMutex);
+    discardAllocatorLocked(*storage, *epoch);
+}
+
+void MVKMetal4AllocatorUse::finishRelease() {
+    if (!epoch) { return; }
+    assert(phase == MVKMetal4AllocatorUsePhase::Released);
+    if (resetElected) {
+        [epoch->allocator reset];
+        uint64_t bytes = [epoch->allocator allocatedSize];
+        {
+            std::lock_guard<std::mutex> lock(storage->poolMutex);
+            assert(!epoch->writer && !epoch->liveUses && epoch->state == MVKMetal4AllocatorState::Resetting);
+            ++storage->poolStats.allocatorResets;
+            epoch->allocatedBytes = bytes; epoch->resetAllocatedBytes = bytes; epoch->recordings = 0;
+            // Poison may overlap an already-elected, zero-user reset, but never
+            // its publication. Retained native heap capacity is reusable memory,
+            // not new growth: offerAllocatorLocked applies the total idle budget.
+            if (storage->poisoned.load(std::memory_order_acquire)) {
+                discardAllocatorLocked(*storage, *epoch);
+            } else {
+                epoch->state = MVKMetal4AllocatorState::Appendable;
+                offerAllocatorLocked(*storage, epoch);
+            }
+        }
+        resetElected = false;
+    }
+    epoch.reset(); storage.reset(); // Native destruction is outside all locks.
+}
+
+void MVKMetal4AllocatorUse::release() {
+    if (!epoch) { return; }
+    {
+        std::lock_guard<std::mutex> lock(storage->poolMutex);
+        releaseAllocatorLocked(*this);
+    }
+    finishRelease();
+}
+
+// Value-owned tail: no additional heap node for its allocator use. Open failure
+// disposes native state before dropping its writer; ended cancellation is safe.
+struct MVKMetal4TailRecording {
+    std::unique_ptr<MVKMetal4ResourcePack> pack;
+    MVKMetal4AllocatorUse allocatorUse;
+    MVKMetal4TailRecording() = default;
+    MVKMetal4TailRecording(const MVKMetal4TailRecording&) = delete;
+    MVKMetal4TailRecording& operator=(const MVKMetal4TailRecording&) = delete;
+    MVKMetal4TailRecording(MVKMetal4TailRecording&&) = default;
+    MVKMetal4TailRecording& operator=(MVKMetal4TailRecording&& other) noexcept {
+        reset(); pack = std::move(other.pack); allocatorUse = std::move(other.allocatorUse); return *this;
+    }
+    explicit operator bool() const { return bool(pack); }
+    void reset() {
+        allocatorUse.discardOpen(); pack.reset(); allocatorUse.release();
+    }
+    ~MVKMetal4TailRecording() { reset(); }
+};
+
+namespace {
+std::unique_ptr<MVKMetal4ResourcePack> acquirePack(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage,
+                                                bool isTail, NSError** error,
+                                                MVKMetal4AllocatorUse& allocatorUse,
+                                                std::unique_ptr<MVKMetal4CompletionStorage>* completionStorage = nullptr) {
+    assert(!allocatorUse.epoch);
+    std::unique_ptr<MVKMetal4ResourcePack> reused;
+    {
+        std::lock_guard<std::mutex> lock(storage->poolMutex);
+        if (storage->poisoned.load(std::memory_order_acquire)) {
+            fail(error, 5, @"Recording storage belongs to a lost device."); return nullptr;
+        }
+        // begin() acquires both kinds of empty capacity with the existing lock.
+        if (!isTail && completionStorage && !storage->completionPool.empty()) {
+            *completionStorage = std::move(storage->completionPool.back()); storage->completionPool.pop_back();
+            storage->poolStats.idleBytes -= (*completionStorage)->hostStorageBytes();
+        }
+        auto& pool = isTail ? storage->tailPool : storage->primaryPool;
+        if (!pool.empty()) {
+            reused = std::move(pool.back()); pool.pop_back();
+            storage->poolStats.idleBytes -= reused->idleBytes;
+            ++(isTail ? storage->poolStats.tailReused : storage->poolStats.primaryReused);
+            if (!isTail && reused->retained) { ++storage->poolStats.hostStorageReused; }
+        }
+        allocatorUse = takeAllocatorLocked(storage);
+    }
+    // Cold creation and every failure unwind remain outside the pool lock.
+    // The caller owns Reserved rollback even if subsequent pack creation fails.
+    if (!allocatorUse.epoch) { allocatorUse = createAllocatorUse(storage, error); }
+    if (!allocatorUse.epoch) { return nullptr; }
+    if (reused) {
+        if (!isTail) { reused->prepareStableBuffersForRecording(); }
+        return reused;
+    }
+    // Pool exhaustion never waits for GPU completion or resets an in-flight pack.
+    auto pack = std::make_unique<MVKMetal4ResourcePack>();
+    if (!isTail) {
+        pack->uploadSlabs.reserve(MVKMetal4ResourcePoolStats::maxUploadSlabsPerPack);
+        pack->argumentTables.reserve(MVKMetal4ResourcePoolStats::maxArgumentTableGroupsPerPack);
+    }
+    pack->buffer = [storage->device newCommandBuffer];
+    pack->marker = [storage->device newBufferWithLength:4 options:MTLResourceStorageModeShared];
+    MTLResidencySetDescriptor* desc = [MTLResidencySetDescriptor new];
+    if (!isTail) {
+        desc.label = @"MoltenVK Metal 4 submission resources";
+        pack->residency = [storage->device newResidencySetWithDescriptor:desc error:error];
+    }
+    if (isTail || pack->residency) {
+        desc.label = isTail ? @"MoltenVK Metal 4 owned retirement storage" : @"MoltenVK Metal 4 owned upload storage";
+        pack->stableResidency = [storage->device newResidencySetWithDescriptor:desc error:error];
+    }
+    [desc release];
+    if (!pack->buffer || !pack->marker || !pack->stableResidency ||
+        (!isTail && !pack->residency)) {
+        if (!error || !*error) { fail(error, 2, @"Could not allocate Metal 4 submission resource pack."); }
+        return nullptr;
+    }
+    pack->addStableAllocation(pack->marker);
+    {
+        std::lock_guard<std::mutex> lock(storage->poolMutex);
+        ++(isTail ? storage->poolStats.tailCreated : storage->poolStats.primaryCreated);
+    }
+    return pack;
+}
+
+// Only terminal GPU retirement or cancellation of an ended, unsubmitted buffer
+// may call this. No callbacks, Objective-C releases or Metal calls under poolMutex.
+void publishIdleStorage(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage,
+                        std::unique_ptr<MVKMetal4ResourcePack> pack, bool isTail,
+                        std::unique_ptr<MVKMetal4CompletionStorage> completion) {
+    std::lock_guard<std::mutex> poolLock(storage->poolMutex);
+    // Failure may arrive during reset/preparation. Publish neither kind of
+    // reusable storage after observed poison; destruction occurs outside locks.
+    if (storage->poisoned.load(std::memory_order_acquire)) { return; }
+    constexpr uint64_t cap = MVKMetal4ResourcePoolStats::maxIdleBytes;
+    if (pack) {
+        auto& pool = isTail ? storage->tailPool : storage->primaryPool;
+        if (pool.size() < MVKMetal4ResourcePoolStats::maxIdlePacksPerKind &&
+            pack->idleBytes <= cap - storage->poolStats.idleBytes) {
+            storage->poolStats.idleBytes += pack->idleBytes;
+            pool.push_back(std::move(pack));
+        }
+    }
+    if (completion) {
+        uint64_t bytes = completion->hostStorageBytes();
+        if (storage->completionPool.size() < MVKMetal4ResourcePoolStats::maxIdlePacksPerKind &&
+            bytes <= cap - storage->poolStats.idleBytes) {
+            storage->poolStats.idleBytes += bytes;
+            storage->completionPool.push_back(std::move(completion));
+        }
+    }
+}
+
+void recyclePack(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage,
+                 std::unique_ptr<MVKMetal4ResourcePack> pack, bool isTail,
+                 std::unique_ptr<MVKMetal4CompletionStorage> completion = nullptr) {
+    if (!pack) {
+        if (completion) { publishIdleStorage(storage, nullptr, false, std::move(completion)); }
+        return;
+    }
+    if (storage->poisoned.load(std::memory_order_acquire)) { return; }
+    uint64_t residencyBytes = 0;
+    if (!isTail) {
+        // This pack's GPU feedback (or ended cancellation) is already proved.
+        // Tables and dynamic residency are independent of shared command memory.
+        for (auto& group : pack->argumentTables) {
+            if (!group.tables->resetForReuse()) { return; }
+            group.leased = false;
+        }
+        if (pack->dynamicResidencyHasAllocations) {
+            [pack->residency removeAllAllocations];
+            [pack->residency commit];
+            pack->dynamicResidencyHasAllocations = false;
+        }
+        residencyBytes = pack->residency.allocatedSize;
+    }
+    uint64_t stableResidencyBytes = pack->stableResidency.allocatedSize;
+    constexpr uint64_t cap = MVKMetal4ResourcePoolStats::maxIdleBytes;
+    if (residencyBytes > cap || stableResidencyBytes > cap - residencyBytes) { return; }
+    // Count the committed set's reported footprint once. It covers the marker
+    // cached slabs and cached native buffers; it may include internal allocations. Adding
+    // those same buffers separately would count their storage a second time.
+    pack->idleBytes = residencyBytes + stableResidencyBytes;
+    if (!isTail) {
+        uint64_t hostBytes = pack->hostStorageBytes();
+        if (hostBytes > cap - pack->idleBytes) { return; }
+        pack->idleBytes += hostBytes;
+        for (auto& group : pack->argumentTables) {
+            uint64_t bytes = sizeof(MVKMetal4ArgumentTables) + group.tables->retainedHostByteCapacity();
+            if (bytes > cap - pack->idleBytes) { return; }
+            pack->idleBytes += bytes;
+        }
+    }
+    publishIdleStorage(storage, std::move(pack), isTail, std::move(completion));
+    // Excess idle capacity is destroyed here, after releasing the pool lock.
+}
+
+void recycleCompletionStorage(const std::shared_ptr<MVKMetal4RecordingPoolState>& storage,
+                              std::unique_ptr<MVKMetal4CompletionStorage> completion) {
+    if (completion) { publishIdleStorage(storage, nullptr, false, std::move(completion)); }
+}
+}
+
+struct MVKMetal4SubmissionState {
+    uint64_t timelineID = 0;
+    // Published only by submit's exclusive adoption claim. Recording storage
+    // does not require a queue; the weak diagnostic link is never an owner.
+    std::shared_ptr<MVKMetal4QueueState> owner;
+    std::shared_ptr<MVKMetal4RecordingPoolState> storage;
+    std::weak_ptr<MVKMetal4QueueState> diagnosticQueue;
+    std::unique_ptr<MVKMetal4ResourcePack> pack;
+    MVKMetal4AllocatorUse allocatorUse;
+    // Borrowed from this record's use, detached before releasing that use.
+    id<MTL4CommandAllocator> allocator = nil;
+    id<MTL4CommandBuffer> buffer = nil;
+    // Borrowed from pack/retained. Each closed prefix is followed by a queue
+    // completion boundary at submit. Empty in all recordings without counters.
+    std::vector<id<MTL4CommandBuffer>> counterPrefixes;
+    bool counterPrefixComplete = false, counterWritesPending = false;
+    id<MTLResidencySet> residency = nil;
+    NSMutableArray* retained = nil;
+    NSMutableArray* operationRetained = nil;
+    size_t operationRetainedHighWater = 0;
+    std::unique_ptr<MVKMetal4CompletionStorage> completionStorage;
+    using ObjectIdentity = MVKMetal4ObjectIdentity;
+    MVKMetal4ObjectIdentityMap objects;
+    MVKMetal4PreparedGroupCache preparedGroups;
+    MVKMetal4RecordingDependencies dependencies;
+    size_t retainedHighWater = 0;
+    MVKMetal4ResourceRegistrationStats registrationStats;
+    std::vector<std::shared_ptr<void>> deviceResidencyLeases;
+    id<MTLBuffer> uploadArena = nil; // Owned by retained and optionally pack until retirement.
+    NSUInteger uploadArenaCursor = 0;
+    size_t uploadSlabIndex = 0;
+    mutable std::mutex mutex;
+    std::condition_variable done;
+    Phase phase = Phase::Recording;
+    NSError* error = nil;
+    std::vector<std::function<void()>> cleanup;
+    std::vector<std::function<void()>> hostStateActions;
+    std::vector<std::function<void(NSError*)>> errorHandlers, completedHandlers;
+    bool errorHandlersRunning = false;
+    std::vector<MVKMetal4EventValue> waits, signals;
+    std::vector<id<MTLDrawable>> drawables;
+    std::vector<MVKMetal4Presentation> presentations;
+    // Overflow leases retain their native tables until the same GPU retirement,
+    // but never increase the idle cache's bounded table group count.
+    std::vector<MVKMetal4ResourcePack::ArgumentTableGroup> transientArgumentTables;
+    MVKMetal4EncodingStats encodingStats;
+    bool costPresentation = false; // Set before publication; classification only.
+
+    // Caller holds mutex while recording. Retention and residency are distinct:
+    // an object retained for another purpose must still be registered resident.
+    ObjectIdentity& retainUnique(id object) {
+        auto result = objects.try_emplace((const void*)object);
+        if (!result.first->second.gpuRetained) {
+            [retained addObject:object];
+            result.first->second.gpuRetained = true;
+        }
+        if (result.second) { ++registrationStats.retainedObjects; }
+        return result.first->second;
+    }
+    // Recording-only deduplication shares the identity map, but the actual
+    // event/drawable owner is independent of the map and GPU retained array.
+    bool retainOperationUnique(id object) {
+        if (!operationRetained) {
+            if (!completionStorage) { completionStorage = std::make_unique<MVKMetal4CompletionStorage>(); }
+            operationRetained = [[NSMutableArray alloc] initWithCapacity:8];
+            if (!operationRetained) { return false; }
+        }
+        auto result = objects.try_emplace((const void*)object);
+        if (!result.first->second.operationRetained) {
+            [operationRetained addObject:object];
+            result.first->second.operationRetained = true;
+        }
+        if (result.second) { ++registrationStats.retainedObjects; }
+        return true;
+    }
+    ObjectIdentity& addResident(id<MTLResource> resource, bool stableBufferCandidate = true) {
+        auto& identity = retainUnique(resource);
+        if (!identity.resident) {
+            auto lease = storage->deviceResidency ? storage->deviceResidency->lease(resource) : std::shared_ptr<void>{};
+            if (lease) {
+                deviceResidencyLeases.push_back(std::move(lease));
+                ++registrationStats.deviceResidencyLeases;
+            } else if (!stableBufferCandidate || !pack->cacheStableBuffer(resource)) {
+                [residency addAllocation:resource];
+                pack->dynamicResidencyHasAllocations = true;
+            }
+            identity.resident = true;
+            ++registrationStats.residentResources;
+        }
+        return identity;
+    }
+    // Explicit owned-storage path only; never infer stable ownership from a
+    // caller's pointer. The pack survives independently until GPU retirement.
+    void addStableResident(id<MTLBuffer> resource) {
+        auto& identity = retainUnique(resource);
+        if (!identity.resident) {
+            identity.resident = true;
+            ++registrationStats.residentResources;
+        }
+    }
+    void forgetIdentities() {
+        objects.clear();
+        preparedGroups.clear();
+        uploadArena = nil; uploadArenaCursor = 0; uploadSlabIndex = 0;
+    }
+    void clearGPUReferences() {
+        retainedHighWater = std::max(retainedHighWater, objects.size());
+        forgetIdentities();
+        deviceResidencyLeases.clear();
+        counterPrefixes.clear();
+        [retained removeAllObjects];
+    }
+    void clearOperationReferences() {
+        operationRetainedHighWater = std::max(operationRetainedHighWater, size_t(operationRetained.count));
+        [operationRetained removeAllObjects];
+        presentations.clear(); // Destroy beforePresent captures before reuse.
+        waits.clear(); signals.clear(); drawables.clear();
+    }
+    template<class T> static void trimEmptyVector(std::vector<T>& values) {
+        if (values.capacity() > MVKMetal4ResourcePoolStats::maxHostVectorEntries) {
+            std::vector<T>().swap(values);
+        }
+    }
+    // Only after GPU storage retirement or ended-unsubmitted cancellation, after
+    // cleanup has run. No live identity, Objective-C retain or callback moves.
+    void cacheEmptyHostStorage(MVKMetal4ResourcePack& destination) {
+        if (objects.bucket_count() > MVKMetal4ResourcePoolStats::maxHostIdentityBuckets) {
+            decltype(objects)().swap(objects);
+        }
+        if (retainedHighWater > MVKMetal4ResourcePoolStats::maxRetainedHostObjects) {
+            [retained release]; retained = nil; retainedHighWater = 0;
+        }
+        destination.objects.swap(objects);
+        destination.retained = retained; retained = nil;
+        destination.retainedHighWater = retainedHighWater; retainedHighWater = 0;
+        if (destination.hostStorageBytes() > MVKMetal4ResourcePoolStats::maxHostStoragePayloadBytes) {
+            decltype(destination.objects)().swap(destination.objects);
+        }
+    }
+    // Queue-operation ownership and callback/vector capacity remain exclusive
+    // to this fresh state until full semantic completion or cancellation.
+    void cacheEmptyCompletionStorage() {
+        if (!completionStorage) { return; }
+        trimEmptyVector(waits); trimEmptyVector(signals);
+        trimEmptyVector(drawables); trimEmptyVector(presentations);
+        if (operationRetainedHighWater > MVKMetal4ResourcePoolStats::maxRetainedHostObjects) {
+            [operationRetained release]; operationRetained = nil; operationRetainedHighWater = 0;
+        }
+        completionStorage->waits.swap(waits); completionStorage->signals.swap(signals);
+        completionStorage->drawables.swap(drawables); completionStorage->presentations.swap(presentations);
+        completionStorage->retained = operationRetained; operationRetained = nil;
+        completionStorage->retainedHighWater = operationRetainedHighWater; operationRetainedHighWater = 0;
+        if (completionStorage->hostStorageBytes() > MVKMetal4ResourcePoolStats::maxHostStoragePayloadBytes) {
+            decltype(completionStorage->waits)().swap(completionStorage->waits);
+            decltype(completionStorage->signals)().swap(completionStorage->signals);
+            decltype(completionStorage->drawables)().swap(completionStorage->drawables);
+            decltype(completionStorage->presentations)().swap(completionStorage->presentations);
+        }
+    }
+
+    ~MVKMetal4SubmissionState() {
+        // Submitted state is retained by Metal's feedback block and, when work
+        // feedback arrives first, its eligible notification owner slot. Neither
+        // releases GPU storage before its feedback/scheduling gate. Queue-operation
+        // retains and semantic callbacks independently survive signal observation.
+        // An unsubmitted batch still owns cleanup obligations (e.g. pool leases).
+        for (auto& action : cleanup) { action(); }
+        cleanup.clear();
+        clearGPUReferences();
+        clearOperationReferences();
+        buffer = nil; allocator = nil; residency = nil;
+        // Recording cancellation is intentionally destroyed, never reset while
+        // an encoder might still be open. Ended cancellation has no GPU owner.
+        if (phase == Phase::Ended) {
+            allocatorUse.release();
+            if (pack) { cacheEmptyHostStorage(*pack); }
+            cacheEmptyCompletionStorage();
+            recyclePack(storage, std::move(pack), false, std::move(completionStorage));
+        } else {
+            // The prepared encoder's owner disposes its encoders before this
+            // state. Explicitly dispose our native buffer before its writer use;
+            // member destruction order must not determine allocator safety.
+            allocatorUse.discardOpen();
+            pack.reset();
+            allocatorUse.release();
+        }
+        [retained release]; retained = nil;
+        [operationRetained release]; operationRetained = nil;
+        [error release];
+    }
+};
