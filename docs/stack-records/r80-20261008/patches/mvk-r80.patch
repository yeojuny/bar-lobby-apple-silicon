diff --git a/b/MoltenVK/MoltenVK/Commands/MVKMetal4QueryDependencies.h b/MoltenVK/MoltenVK/Commands/MVKMetal4QueryDependencies.h
new file mode 100644
index 0000000..9e87245
--- /dev/null
+++ b/MoltenVK/MoltenVK/Commands/MVKMetal4QueryDependencies.h
@@ -0,0 +1,60 @@
+#pragma once
+#include "MVKMetal4DependencyScopes.h"
+
+// Only implementation-owned query operations qualify for these scopes.
+// ResultCopy retains the general contract because its destination is a Vulkan buffer.
+// Timestamp writes have no Metal stage: the submission layer orders them with
+// command-buffer timestamp semantics and explicit queue completion events.
+enum class MVKMetal4QueryOperation {
+    None, OcclusionReset, VisibilityInitialize, OcclusionAccumulate,
+    ResultCopy, VisibilityWrite, CounterResolve
+};
+
+template<uint64_t Vertex, uint64_t Fragment, uint64_t Dispatch, uint64_t Blit>
+struct MVKMetal4QueryDependencies {
+    using Scopes = MVKMetal4DependencyScopes<Vertex, Fragment, Dispatch, Blit>;
+    using Operation = MVKMetal4QueryOperation;
+
+    static uint64_t stages(Operation operation) {
+        switch (operation) {
+            case Operation::OcclusionReset:
+            case Operation::VisibilityInitialize: return Blit;
+            case Operation::OcclusionAccumulate:
+            case Operation::ResultCopy: return Dispatch;
+            default: return 0;
+        }
+    }
+    static uint64_t priorStages(Operation operation) {
+        switch (operation) {
+            case Operation::OcclusionReset: return Dispatch | Blit;
+            case Operation::OcclusionAccumulate: return Fragment | Dispatch | Blit;
+            case Operation::ResultCopy: return Scopes::all;
+            default: return 0;
+        }
+    }
+    static void addOutputs(Scopes& scopes, Operation operation) {
+        switch (operation) {
+            case Operation::VisibilityWrite:
+                scopes.add(Fragment, Dispatch, true);
+                break;
+            case Operation::OcclusionReset:
+                scopes.add(Blit, Dispatch | Blit, true);
+                break;
+            case Operation::VisibilityInitialize:
+                // A newly allocated native buffer has no previous consumer.
+                scopes.add(Blit, Fragment | Dispatch, true);
+                break;
+            case Operation::OcclusionAccumulate:
+                scopes.add(Dispatch, Dispatch | Blit, true); // Query pool writes.
+                scopes.add(Dispatch, Fragment, true); // Cleared visibility slots before reuse.
+                break;
+            case Operation::CounterResolve:
+                scopes.add(Blit, Dispatch | Blit, true);
+                break;
+            case Operation::ResultCopy:
+                scopes.add(Dispatch, Scopes::all, true);
+                break;
+            default: break;
+        }
+    }
+};
diff --git a/b/MoltenVK/MoltenVK/Commands/MVKMetal4TextureRegistrationCache.h b/MoltenVK/MoltenVK/Commands/MVKMetal4TextureRegistrationCache.h
new file mode 100644
index 0000000..430f7d8
--- /dev/null
+++ b/MoltenVK/MoltenVK/Commands/MVKMetal4TextureRegistrationCache.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+// Successful registration pins the exact Metal object in the recording. This
+// memo owns no resources; recording changes clear it before any lookup. Known
+// drawable incarnations invalidate individually; unknown textures retain the
+// registry-generation fallback. Ordinary entries need no drawable checks.
+class MVKMetal4TextureRegistrationCache {
+    struct Entry { const void* object = nullptr; uint64_t generation = 0; };
+    static constexpr std::size_t kCapacity = 256;
+    std::array<Entry, kCapacity> _entries{};
+    static std::size_t slot(const void* object) {
+        uintptr_t key = reinterpret_cast<uintptr_t>(object) >> 4;
+        return (key ^ (key >> 8) ^ (key >> 16)) & (kCapacity - 1);
+    }
+public:
+    void clear() { _entries.fill({}); }
+    bool matchesOrdinary(const void* object) const {
+        if (!object) { return false; }
+        const auto& entry = _entries[slot(object)];
+        return entry.object == object && !entry.generation;
+    }
+    void rememberOrdinary(const void* object) {
+        if (object) { _entries[slot(object)] = {object, 0}; }
+    }
+    bool matches(const void* object, uint64_t generation) const {
+        if (!object || !generation || generation == UINT64_MAX) { return false; }
+        const auto& entry = _entries[slot(object)];
+        return entry.object == object && entry.generation == generation;
+    }
+    void remember(const void* object, uint64_t generation) {
+        if (!object || !generation || generation == UINT64_MAX) { return; }
+        // Collisions replace only a CPU memo; neither resource ownership nor
+        // residency is removed. The displaced object takes the original path.
+        _entries[slot(object)] = { object, generation };
+    }
+};
diff --git a/b/MoltenVK/MoltenVK/GPUObjects/MVKBackendTimeline.cpp b/MoltenVK/MoltenVK/GPUObjects/MVKBackendTimeline.cpp
new file mode 100644
index 0000000..14e39d0
--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKBackendTimeline.cpp
@@ -0,0 +1,165 @@
+// Bounded opt-in timing capture; one binary write after normal process teardown.
+#include "MVKBackendTimeline.h"
+#include <atomic>
+#include <chrono>
+#include <cerrno>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <limits>
+#include <mach/mach_time.h>
+#include <new>
+#include <pthread.h>
+#include <thread>
+#include <unistd.h>
+
+namespace {
+constexpr uint64_t Capacity = 6 * 1024 * 1024;
+struct Header {
+    char magic[8];
+    uint32_t version, recordBytes;
+    uint64_t capacity, reserved, committed, dropped, invalid, incomplete;
+    double originHost, originUnixMS;
+};
+static_assert(sizeof(Header) == 80, "timeline header layout");
+bool writeAll(int fd, const void* data, size_t size) {
+    auto* bytes = static_cast<const char*>(data);
+    while (size) {
+        ssize_t n = write(fd, bytes, size);
+        if (n < 0 && errno == EINTR) { continue; }
+        if (n <= 0) { return false; }
+        bytes += n; size -= size_t(n);
+    }
+    return true;
+}
+uint64_t threadID() {
+    static thread_local const uint64_t id = [] {
+        uint64_t value = 0;
+        pthread_threadid_np(nullptr, &value);
+        return value;
+    }();
+    return id;
+}
+}
+
+struct MVKBackendTimeline::Storage {
+    MVKBackendTimelineEvent* events = nullptr;
+    std::atomic<uint8_t>* ready = nullptr;
+    char* path = nullptr;
+    std::atomic<uint64_t> next {0}, ids {1}, invalid {0}, writers {0};
+    std::atomic<bool> sealed {false};
+    double originHost = 0, originUnixMS = 0;
+};
+
+double MVKBackendTimeline::clock() {
+    static const double scale = [] {
+        mach_timebase_info_data_t info;
+        mach_timebase_info(&info);
+        return double(info.numer) / double(info.denom) * 1e-9;
+    }();
+    return double(mach_absolute_time()) * scale;
+}
+
+MVKBackendTimeline::MVKBackendTimeline() : _storage(new (std::nothrow) Storage) {
+    if (!_storage) { return; }
+    auto& s = *_storage;
+    s.path = strdup(std::getenv("MVK_CONFIG_BACKEND_TIMELINE_FILE"));
+    s.events = static_cast<MVKBackendTimelineEvent*>(std::malloc(Capacity * sizeof(MVKBackendTimelineEvent)));
+    s.ready = new (std::nothrow) std::atomic<uint8_t>[Capacity];
+    if (!s.path || !s.events || !s.ready) {
+        std::free(s.path); std::free(s.events); delete[] s.ready;
+        delete _storage; _storage = nullptr;
+        return;
+    }
+    for (uint64_t i = 0; i < Capacity; ++i) { s.ready[i].store(0, std::memory_order_relaxed); }
+    s.originHost = clock();
+    s.originUnixMS = std::chrono::duration<double, std::milli>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+MVKBackendTimeline* mvkBackendTimeline() {
+    static MVKBackendTimeline* const capture = []() -> MVKBackendTimeline* {
+        const char* flag = std::getenv("MVK_CONFIG_BACKEND_TIMELINE");
+        const char* path = std::getenv("MVK_CONFIG_BACKEND_TIMELINE_FILE");
+        if (!flag || std::strcmp(flag, "1") || !path || path[0] != '/' || std::strlen(path) > 4095) { return nullptr; }
+        auto* value = new (std::nothrow) MVKBackendTimeline;
+        if (!value || !value->_storage) { delete value; return nullptr; }
+        if (std::atexit([] { if (auto* c = mvkBackendTimeline()) { c->dump(); } }) != 0) {
+            // No capture is preferable to silently collecting data that cannot be emitted.
+            value->_storage->sealed.store(true, std::memory_order_relaxed);
+            return nullptr;
+        }
+        return value;
+    }();
+    return capture;
+}
+
+uint64_t MVKBackendTimeline::nextID() {
+    auto& ids = _storage->ids;
+    uint64_t current = ids.load(std::memory_order_relaxed);
+    while (current != std::numeric_limits<uint64_t>::max()) {
+        if (ids.compare_exchange_weak(current, current + 1, std::memory_order_relaxed)) { return current; }
+    }
+    _storage->invalid.fetch_add(1, std::memory_order_relaxed);
+    return 0;
+}
+
+void MVKBackendTimeline::record(MVKBackendTimelineKind kind, double begin, double end,
+                               uint64_t entity, uint64_t related, uint64_t value,
+                               uint32_t flags, double aux0, double aux1) {
+    auto& s = *_storage;
+    if (s.sealed.load(std::memory_order_acquire)) { return; }
+    // Sequential order across the two admission atomics prevents dump and a
+    // new writer from both observing the other side's old value.
+    s.writers.fetch_add(1, std::memory_order_seq_cst);
+    if (s.sealed.load(std::memory_order_seq_cst)) {
+        s.writers.fetch_sub(1, std::memory_order_seq_cst); return;
+    }
+    if (!std::isfinite(begin) || !std::isfinite(end) || begin < 0 || end < begin ||
+        !std::isfinite(aux0) || !std::isfinite(aux1)) {
+        s.invalid.fetch_add(1, std::memory_order_relaxed);
+    } else {
+        uint64_t index = s.next.fetch_add(1, std::memory_order_relaxed);
+        if (index < Capacity) {
+            s.events[index] = {begin, end, threadID(), entity, related, value,
+                               uint32_t(kind), flags, aux0, aux1};
+            s.ready[index].store(1, std::memory_order_release);
+        }
+    }
+    s.writers.fetch_sub(1, std::memory_order_seq_cst);
+}
+
+void MVKBackendTimeline::dump() {
+    auto& s = *_storage;
+    if (s.sealed.exchange(true, std::memory_order_seq_cst)) { return; }
+    // Only finish already-entered fixed-size writes. No GPU wait or callback is requested.
+    double deadline = clock() + 1;
+    while (s.writers.load(std::memory_order_seq_cst) && clock() < deadline) { std::this_thread::yield(); }
+    bool writersPending = s.writers.load(std::memory_order_seq_cst) != 0;
+    uint64_t attempted = s.next.load(std::memory_order_acquire);
+    uint64_t reserved = attempted < Capacity ? attempted : Capacity;
+    uint64_t committed = 0;
+    for (uint64_t i = 0; i < reserved; ++i) {
+        if (s.ready[i].load(std::memory_order_acquire)) { ++committed; }
+    }
+    uint64_t incomplete = reserved - committed;
+    if (writersPending || incomplete) {
+        // Never serialize a concurrently changing prefix as a complete timeline.
+        committed = 0;
+        incomplete = reserved ? reserved : 1;
+    }
+    Header h {{'R','4','6','T','L','N','0','1'}, 1, sizeof(MVKBackendTimelineEvent), Capacity,
+              reserved, committed, attempted - reserved, s.invalid.load(std::memory_order_relaxed),
+              incomplete, s.originHost, s.originUnixMS};
+    int fd = open(s.path, O_WRONLY | O_CREAT | O_EXCL, 0600);
+    if (fd < 0) { std::fprintf(stderr, "[mvk-backend-timeline] output-create-failed\n"); return; }
+    bool ok = writeAll(fd, &h, sizeof(h));
+    // Complete prefix only; an incomplete terminal snapshot emits no event payload.
+    ok = ok && writeAll(fd, s.events, committed * sizeof(MVKBackendTimelineEvent));
+    if (close(fd) != 0) { ok = false; }
+    std::fprintf(stderr, "[mvk-backend-timeline] records=%llu dropped=%llu invalid=%llu incomplete=%llu write_ok=%d\n",
+                 (unsigned long long)h.committed, (unsigned long long)h.dropped,
+                 (unsigned long long)h.invalid, (unsigned long long)h.incomplete, int(ok));
+}
diff --git a/b/MoltenVK/MoltenVK/GPUObjects/MVKBackendTimeline.h b/MoltenVK/MoltenVK/GPUObjects/MVKBackendTimeline.h
new file mode 100644
index 0000000..64010da
--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKBackendTimeline.h
@@ -0,0 +1,40 @@
+// Opt-in, bounded host/GPU timing evidence. Does not change synchronization.
+#pragma once
+#include <cstdint>
+
+enum class MVKBackendTimelineKind : uint32_t {
+    QueueDelay = 1, QueueExecute, CommandReplay, NativeEnd,
+    NativeSubmit, SubmitLock, TailSetup, WorkCommit, SignalPresent, TailCommit,
+    GPUWork, GPUTail, CallbackEntry, MandatoryCleanup, CompletionHandlers,
+    CacheRecycle, SemaphoreWait, FenceWait, QueueSignal, QueueFence, Present,
+    SemaphoreSignal, WaitTarget, SubmitTarget, RetireReady,
+};
+
+// On-disk little-endian, native IEEE754 double. No pointers or object ownership.
+struct MVKBackendTimelineEvent {
+    double begin, end;
+    uint64_t thread, entity, related, value;
+    uint32_t kind, flags;
+    double aux0, aux1;
+};
+static_assert(sizeof(MVKBackendTimelineEvent) == 72, "timeline record layout");
+
+class MVKBackendTimeline {
+public:
+    static double clock();
+    uint64_t nextID();
+    void record(MVKBackendTimelineKind kind, double begin, double end,
+                uint64_t entity = 0, uint64_t related = 0, uint64_t value = 0,
+                uint32_t flags = 0, double aux0 = 0, double aux1 = 0);
+    // One terminal dump after Vulkan device/queue cleanup. Never in draw loops.
+    void dump();
+private:
+    MVKBackendTimeline();
+    struct Storage;
+    Storage* _storage;
+    friend MVKBackendTimeline* mvkBackendTimeline();
+};
+
+// Cached OFF unless both ENV flag=1 and an absolute new output path are present.
+// Enabled collector storage has process lifetime, avoiding teardown callback UAF.
+MVKBackendTimeline* mvkBackendTimeline();
