+#include <algorithm>
+#include <cstdint>
+
+// These are the core Vulkan point/line/triangle topology values (0 through 5).
+// Admission still requires the draw prepass's producer, attachment and shader
+// independence proof; these helpers only describe the shared restart kernel.
+namespace mvkMetal4PrimitiveBatch {
+inline bool eligible(bool indexed, uint32_t topology, bool restart,
+                     bool polygonPoint, uint32_t indexBytes) {
+    return indexed && topology <= 5 && restart && (!polygonPoint || topology == 0) &&
+        (indexBytes == 1 || indexBytes == 2 || indexBytes == 4);
+}
+
+inline bool capacity(uint32_t topology, uint32_t count, uint64_t maxBufferBytes,
+                     uint32_t& output) {
+    if (topology > 5) { return false; }
+    uint64_t primitives = topology == 0 ? count : topology == 1 ? count / 2 :
+        topology == 2 ? (count > 1 ? count - 1 : 0) : topology == 3 ? count / 3 :
+        (count > 2 ? count - 2 : 0);
+    uint32_t size = topology == 0 ? 1 : topology < 3 ? 2 : 3;
+    uint64_t indices = std::max(uint64_t(1), primitives * size);
+    if (indices > UINT32_MAX || indices > maxBufferBytes / sizeof(uint32_t)) { return false; }
+    output = uint32_t(indices);
+    return true;
+}
+
+inline uint32_t width(uint32_t count, uint64_t maxThreads) {
+    return uint32_t(std::min(std::min(uint64_t(256), std::max(uint64_t(1), uint64_t(count))), maxThreads));
+}
+
+// A larger group merely adds inactive lanes for a shorter draw. Every record
+// receives this actual width as threadStride; scratch and barriers stay local
+// to that record's group. Never exceed the selected PSO's limit at dispatch.
+inline uint32_t appendWidth(uint32_t current, uint32_t count, uint64_t maxThreads) {
+    return std::max(current, width(count, maxThreads));
+}
+}
