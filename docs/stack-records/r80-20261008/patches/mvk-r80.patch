+static bool metal4TypeUsesProvokingVertex(const CompilerReflection& reflect, const SPIRType& type, bool includeFlat) {
+	for (uint32_t member = 0; member < type.member_types.size(); ++member) {
+		if ((includeFlat && reflect.has_member_decoration(type.self, member, spv::DecorationFlat)) ||
