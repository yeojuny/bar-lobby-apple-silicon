+// No queue or submission owner references: idle packs cannot form owner cycles.
+struct MVKMetal4ResourcePack {
+    // Resource packs remain exclusive through their own GPU-retirement gate.
+    // Command memory is separately owned by every primary/tail allocator use.
+    id<MTL4CommandBuffer> buffer = nil;
+    id<MTLResidencySet> residency = nil;
+    bool dynamicResidencyHasAllocations = false;
+    // Marker, cached slabs, and bounded eligible native buffers strongly owned
+    // below. Membership changes only while the pack is exclusive, never in flight.
+    id<MTLResidencySet> stableResidency = nil;
+    bool stableResidencyDirty = false;
+    MVKMetal4StableAllocationCache stableBuffers;
+    id<MTLBuffer> marker = nil;
+    // Exclusive to this pack until actual retirement. Only small immutable
+    // upload slabs are cached; oversized transient uploads are never pooled.
+    std::vector<id<MTLBuffer>> uploadSlabs;
+    struct ArgumentTableGroup {
+        std::unique_ptr<MVKMetal4ArgumentTables> tables;
+        bool computeOnly = false, leased = false;
+    };
+    std::vector<ArgumentTableGroup> argumentTables;
+    // Always empty when idle. Only host capacity is reused; each begin retains
+    // a fresh submission state/control block and weak recording identity.
+    MVKMetal4ObjectIdentityMap objects;
+    NSMutableArray* retained = nil;
+    size_t retainedHighWater = 0;
+    uint64_t hostStorageBytes() const {
+        // Bucket/vector payload accounting only; allocator overhead and opaque
+        // Foundation capacity are not reported as known allocated bytes.
+        return objects.hostStorageBytes() + stableBuffers.hostStorageBytes();
+    }
+    uint64_t idleBytes = 0;
+    void addStableAllocation(id<MTLBuffer> allocation) {
+        [stableResidency addAllocation:allocation];
+        stableResidencyDirty = true;
+    }
+    void commitStableResidency() {
+        if (!stableResidencyDirty) { return; }
+        [stableResidency commit];
+        stableResidencyDirty = false;
+    }
+    bool cacheStableBuffer(id<MTLResource> resource) {
+        const void* key = (const void*)resource;
+        if (stableBuffers.touch(key)) { return true; }
+        // Only explicit, paired allocation-lifetime registration can admit a
+        // native object. Textures, imports, heap aliases and ordinary wrappers
+        // have no token and remain in the submission's dynamic set.
+        auto token = s_metal4StableBufferLifetimes.get(key);
+        if (token.expired() || !stableBuffers.insert(key, std::move(token), resource.allocatedSize)) { return false; }
+        [resource retain];
+        addStableAllocation((id<MTLBuffer>)resource);
+        return true;
+    }
+    void prepareStableBuffersForRecording() {
+        std::vector<id<MTLBuffer>> removed;
+        stableBuffers.beginRecording([&](const void* object) {
+            auto buffer = (id<MTLBuffer>)object;
+            [stableResidency removeAllocation:buffer];
+            stableResidencyDirty = true;
+            removed.push_back(buffer);
+        });
+        // Removing residency can take effect immediately. Only a retired,
+        // exclusive pack enters here, and set removal commits before releases.
+        if (!removed.empty()) {
+            commitStableResidency();
+            for (auto buffer : removed) { [buffer release]; }
+        }
+    }
+    ~MVKMetal4ResourcePack() {
+        [buffer release]; [residency release];
+        [stableResidency release]; [marker release];
+        [retained release];
+        for (auto slab : uploadSlabs) { [slab release]; }
+        for (auto& entry : stableBuffers.entries()) { [(id)entry.first release]; }
+    }
+};
