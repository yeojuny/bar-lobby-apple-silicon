+        }
+        // Unknown aggregate construction cannot prove a member independently.
+        return false;
+    }
+public:
+    Proof(const std::vector<uint32_t>& words,const char* entry,
+          const std::unordered_set<uint32_t>& locations,bool(*pure)(spv::Op),bool externallyWriteFreePipeline=false,const std::unordered_set<uint32_t>& clippedBlocks={}):
+          CompilerReflection(words),_pure(pure),_externallyWriteFreePipeline(externallyWriteFreePipeline),_instanceLocations(locations),_clippedBlocks(clippedBlocks) {
+        if(!entry||words.size()>262144||words.size()<5||words[3]>32768)return;
+        set_entry_point(entry,spv::ExecutionModelVertex);_entry=get_entry_point().self;
+        auto& function=get<SPIRFunction>(_entry);_entryBlock=function.entry_block;
+        if(function.blocks.size()>512)return;
+        for(auto blockID:function.blocks){
+            const auto& block=get<SPIRBlock>(blockID);auto& edge=_edges[blockID];
+            switch(block.terminator){
+                case SPIRBlock::Direct:edge.push_back(block.next_block);break;
+                case SPIRBlock::Select:edge={block.true_block,block.false_block};_conditions[blockID]=block.condition;break;
+                case SPIRBlock::MultiSelect:
+                    _conditions[blockID]=block.condition;
+                    edge.push_back(block.default_block);
+                    for(const auto& c:block.cases_32bit)edge.push_back(c.block);
+                    for(const auto& c:block.cases_64bit)edge.push_back(c.block);break;
+                case SPIRBlock::Return:_returns.insert(blockID);break;
+                default:return;
+            }
+        }
+        for(auto blockID:function.blocks)if(reach(_entryBlock,blockID))_reachable.insert(blockID);
+        if(_returns.empty())return;
+        uint32_t currentFunction=0,currentBlock=0;
+        for(size_t offset=5;offset<words.size();){
+            uint32_t size=words[offset]>>16;if(!size||size>words.size()-offset)return;
+            auto code=static_cast<spv::Op>(words[offset]&spv::OpCodeMask);
+            const uint32_t* args=words.data()+offset+1;uint32_t n=size-1;
+            if(code==spv::OpFunction){if(n<2)return;currentFunction=args[1];currentBlock=0;}
+            if(code==spv::OpLabel){if(n!=1)return;currentBlock=args[0];}
+            Op op{code,args,n,currentBlock,currentFunction};bool result,type;spv::HasResultAndType(code,&result,&type);
+            if(result){uint32_t idx=type?1:0;if(n<=idx)return;_defs.emplace(args[idx],op);}
+            if(code==spv::OpStore){
+                if(n<2||(n>2&&(args[2]&spv::MemoryAccessVolatileMask)))return;
+                _stores.push_back(op);
+            }
+            if(code==spv::OpCopyMemory||code==spv::OpCopyMemorySized)return;
+            // Modf/Frexp write through an out pointer even though they are
+            // side-effect-free with respect to external storage. Do not omit it.
+            if(code==spv::OpExtInst && n>=4 && (args[3]==35||args[3]==51))return;
+            if(code==spv::OpFunctionCall)_calls.push_back(op);
+            if(code==spv::OpFunctionEnd){currentFunction=0;currentBlock=0;}
+            offset+=size;
+        }
+        // Pointer-valued memory can hide an alias before it reaches a callee.
+        // This proof supports ordinary logical scalar/vector data only.
+        for(const auto& store:_stores){
+            auto valueType=_defs.find(store.a[1]);
+            if(valueType==_defs.end()||valueType->second.n<2)return;
+            if(get_type(valueType->second.a[0]).pointer)return;
+            if(pointerStorage(store.a[0])==spv::StorageClassMax)return;
+        }
+        _valid=true;
+    }
+    static bool interfaces(CompilerReflection& compiler,spv::StorageClass storage,bool flatOnly,std::vector<Interface>& result) {
+        for(auto variable:compiler.get_active_interface_variables()){
+            if(compiler.get_storage_class(variable)!=storage)continue;
+            const auto& pointerType=compiler.get_type_from_variable(variable);
+            const auto& type=compiler.get_type(pointerType.parent_type);
+            bool flat=compiler.has_decoration(variable,spv::DecorationFlat);
+            if(compiler.has_decoration(variable,spv::DecorationBuiltIn))continue;
+            if(type.member_types.empty()){
+                if(flatOnly&&!flat)continue;
+                if(!type.array.empty()||type.columns!=1||!type.width||type.width>32||type.vecsize>4||!compiler.has_decoration(variable,spv::DecorationLocation)||
+                   compiler.has_decoration(variable,spv::DecorationComponent))return false;
+                result.push_back({variable,compiler.get_decoration(variable,spv::DecorationLocation),type.self,{}});
+            }else{
+                for(uint32_t member=0;member<type.member_types.size();++member){
+                    bool memberFlat=flat||compiler.has_member_decoration(type.self,member,spv::DecorationFlat);
+                    const auto& mt=compiler.get_type(type.member_types[member]);
+                    if(!mt.member_types.empty())return false;
+                    if(flatOnly&&!memberFlat)continue;
+                    if(compiler.has_member_decoration(type.self,member,spv::DecorationBuiltIn))continue;
+                    if(!mt.array.empty()||mt.columns!=1||!mt.width||mt.width>32||mt.vecsize>4||!compiler.has_member_decoration(type.self,member,spv::DecorationLocation)||
+                       compiler.has_member_decoration(type.self,member,spv::DecorationComponent))return false;
+                    result.push_back({variable,compiler.get_member_decoration(type.self,member,spv::DecorationLocation),mt.self,{member}});
+                }
+            }
+            if(result.size()>64)return false;
+        }
+        return true;
+    }
+    bool prove(const std::vector<Interface>& consumed) {
+        if(!_valid||consumed.empty())return false;
+        std::vector<Interface> outputs;if(!interfaces(*this,spv::StorageClassOutput,false,outputs))return false;
+        for(const auto& input:consumed){
+            auto match=std::find_if(outputs.begin(),outputs.end(),[&](const Interface& out){return out.location==input.location;});
+            if(match==outputs.end())return false;
+            bool initialized=false;
+            for(const auto& call:_calls)for(uint32_t i=3;i<call.n;++i){
+                auto arg=pointer(call.a[i]);
+                if(arg.root==match->root||(!arg.root&&pointerStorage(call.a[i])==spv::StorageClassOutput))return false;
+            }
+            for(const auto& store:_stores){
+                auto dst=pointer(store.a[0]);
+                if(!dst.root&&pointerStorage(store.a[0])==spv::StorageClassOutput)return false;
+                if(dst.root!=match->root)continue;
+                std::vector<uint32_t> path;
+                for(auto index:dst.indices){uint32_t member;if(!literal(index,member))return false;path.push_back(member);}
+                size_t common=std::min(path.size(),match->path.size());
+                if(!std::equal(path.begin(),path.begin()+common,match->path.begin()))continue;
+                if(!unconditional(store))return false;
+                if(path.size()<=match->path.size()){
+                    std::vector<uint32_t> rest(match->path.begin()+path.size(),match->path.end());
+                    if(!extracted(store.a[1],rest))return false;
+                    initialized=true;
+                }else if(!value(store.a[1]))return false;
+            }
+            if(!initialized)return false;
+        }
+        return true;
+    }
+};
+
+// Dynamic binding stride never changes instance-rate. Full dynamic input/rate
+// and unknown vertex-input extensions cannot use the pipeline-time proof.
+inline bool instanceLocations(const VkGraphicsPipelineCreateInfo* info,std::unordered_set<uint32_t>& locations) {
+    const auto* vi=info->pVertexInputState;
+    if(!vi)return false;
+    bool dynamicStride=false;
+    if(info->pDynamicState)for(uint32_t i=0;i<info->pDynamicState->dynamicStateCount;++i){
+        auto state=info->pDynamicState->pDynamicStates[i];
+        if(state==VK_DYNAMIC_STATE_VERTEX_INPUT_EXT)return false;
+        dynamicStride |= state==VK_DYNAMIC_STATE_VERTEX_INPUT_BINDING_STRIDE;
+    }
+    for(auto* next=(const VkBaseInStructure*)vi->pNext;next;next=next->pNext)
+        if(next->sType!=VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_DIVISOR_STATE_CREATE_INFO)return false;
+    for(uint32_t i=0;i<vi->vertexAttributeDescriptionCount;++i){
+        const auto& attribute=vi->pVertexAttributeDescriptions[i];
+        for(uint32_t b=0;b<vi->vertexBindingDescriptionCount;++b){
+            const auto& binding=vi->pVertexBindingDescriptions[b];
+            if(binding.binding==attribute.binding &&
+               (binding.inputRate==VK_VERTEX_INPUT_RATE_INSTANCE || (!dynamicStride&&binding.stride==0)))
+                locations.insert(attribute.location);
+        }
+    }
+    return true;
+}
+
+inline bool prove(const std::vector<uint32_t>& vertex,const char* vertexEntry,
+                  const std::vector<uint32_t>& fragment,const char* fragmentEntry,
+                  const std::unordered_set<uint32_t>& instanceLocations,bool(*pure)(spv::Op),bool externallyWriteFreePipeline=false,const std::unordered_set<uint32_t>& clippedBlocks={}) {
+    if(vertex.empty()||fragment.empty()||!vertexEntry||!fragmentEntry)return false;
+    CompilerReflection fs(fragment);fs.set_entry_point(fragmentEntry,spv::ExecutionModelFragment);
+    std::vector<Interface> consumed;if(!Proof::interfaces(fs,spv::StorageClassInput,true,consumed))return false;
+    Proof vs(vertex,vertexEntry,instanceLocations,pure,externallyWriteFreePipeline,clippedBlocks);return vs.prove(consumed);
+}
