+            uint a = metal4ReadIndex(indices, first, parameters.indexBytes);
+            uint b = speculativeSize >= 2 ? metal4ReadIndex(indices, first + 1, parameters.indexBytes) : 0;
+            uint c = speculativeSize == 3 ? metal4ReadIndex(indices, first + 2, parameters.indexBytes) : 0;
+            foundRestart |= a == sentinel || (speculativeSize >= 2 && b == sentinel) || (speculativeSize == 3 && c == sentinel);
+            if (writable) {
+                device uint* out = output + primitive * speculativeSize;
+                if (speculativeSize == 1) out[0] = a;
+                else if (speculativeSize == 2) {
+                    out[0] = parameters.provokingLast ? b : a;
+                    out[1] = parameters.provokingLast ? a : b;
+                } else metal4WriteTriangle(out, a, b, c, false, parameters.provokingLast != 0, false);
+            }
+        }
+        ulong complete = ulong(primitiveCount) * speculativeSize;
+        for (ulong i = complete + position; i < source.indexCount; i += parameters.threadStride) {
+            foundRestart |= metal4ReadIndex(indices, ulong(source.indexStart) + i, parameters.indexBytes) == sentinel;
+        }
+    } else {
+        for (ulong i = position; i < source.indexCount; i += parameters.threadStride) {
+            if (metal4ReadIndex(indices, ulong(source.indexStart) + i, parameters.indexBytes) == sentinel) {
+                foundRestart = true; break;
+            }
+        }
+    }
+    if (foundRestart) atomic_store_explicit(&hasRestart, 1u, memory_order_relaxed);
+    // Device ordering is essential: a later compaction lane may overwrite an
+    // address speculatively written by a different lane in this same group.
+    threadgroup_barrier(mem_flags::mem_threadgroup | mem_flags::mem_device);
+    if (!atomic_load_explicit(&hasRestart, memory_order_relaxed)) {
+        if (position == 0) {
+            result.indexCount = writable ? primitiveCount * speculativeSize : 0;
+            result.instanceCount = writable ? source.instanceCount * parameters.instanceMultiplier : 0;
+        }
+        if (!list && writable) for (ulong primitive = position; primitive < primitiveCount; primitive += parameters.threadStride) {
+            metal4ConvertPrimitive(indices, source, output, parameters, uint(primitive), speculativeSize);
+        }
+        return;
+    }
+	// One flag per SIMD group combines the local prefixes. No global atomics,
+	// extra dispatch or CPU readback is needed, and every primitive keeps its
+	// original order. Carries include segments spanning any number of chunks.
+	if (position == 0) { segmentStartCarry = 0; writtenCarry = 0; }
+	threadgroup_barrier(mem_flags::mem_threadgroup);
+	uint size = metal4PrimitiveSize(parameters.topology);
+	uint groupCount = (parameters.threadStride + simdWidth - 1) / simdWidth;
+	for (ulong chunk = 0; chunk < source.indexCount; chunk += parameters.threadStride) {
+		ulong i = chunk + position;
+		bool active = i < source.indexCount;
+		uint c = active ? metal4ReadIndex(indices, ulong(source.indexStart) + i, parameters.indexBytes) : 0;
+		uint restartNext = active && c == sentinel ? uint(i) + 1 : 0;
+		for (uint step = 1; step < simdWidth; step <<= 1) {
+			uint earlier = simd_shuffle_up(restartNext, step);
+			if (lane >= step) restartNext = max(restartNext, earlier);
+		}
+		if (lane + 1 == simdWidth || position + 1 == parameters.threadStride) groupRestart[group] = restartNext;
+		threadgroup_barrier(mem_flags::mem_threadgroup);
+		uint segmentStart = max(segmentStartCarry, restartNext);
+		for (uint g = 0; g < group; ++g) segmentStart = max(segmentStart, groupRestart[g]);
+		uint relative = uint(i) - segmentStart;
+		bool emit = active && c != sentinel && (parameters.topology == 0 ||
+			(parameters.topology == 1 && relative % 2 == 1) ||
+			(parameters.topology == 2 && relative >= 1) ||
+			(parameters.topology == 3 && relative % 3 == 2) ||
+			(parameters.topology >= 4 && relative >= 2));
+		uint prefix = simd_prefix_exclusive_sum(uint(emit));
+		uint simdCount = simd_sum(uint(emit));
+		if (lane == 0) groupEmits[group] = simdCount;
+		threadgroup_barrier(mem_flags::mem_threadgroup);
+		uint total = 0, nextStart = segmentStartCarry;
+		for (uint g = 0; g < groupCount; ++g) {
+			if (g < group) prefix += groupEmits[g];
+			total += groupEmits[g];
+			nextStart = max(nextStart, groupRestart[g]);
+		}
+		// Uniform capacity rejection precedes all stores for this chunk.
+		if (writtenCarry > parameters.outputCapacity || total > (parameters.outputCapacity - writtenCarry) / size) {
+			if (position == 0) { result.indexCount = 0; result.instanceCount = 0; }
+			return;
+		}
+		if (emit) {
+			device uint* out = output + writtenCarry + prefix * size;
+			if (size == 1) out[0] = c;
+			else {
+				uint b = metal4ReadIndex(indices, ulong(source.indexStart) + i - 1, parameters.indexBytes);
+				if (size == 2) { out[0] = parameters.provokingLast ? c : b; out[1] = parameters.provokingLast ? b : c; }
+				else {
+					ulong first = parameters.topology == 5 ? ulong(segmentStart) : i - 2;
+					uint a = metal4ReadIndex(indices, ulong(source.indexStart) + first, parameters.indexBytes);
+					metal4WriteTriangle(out, a, b, c, parameters.topology == 4 && ((relative - 2) & 1),
+						parameters.provokingLast != 0, parameters.topology == 5);
+				}
+			}
+		}
+		threadgroup_barrier(mem_flags::mem_threadgroup);
+		if (position == 0) { writtenCarry += total * size; segmentStartCarry = nextStart; }
+		threadgroup_barrier(mem_flags::mem_threadgroup);
+	}
+	if (position == 0) {
+		result.indexCount = writtenCarry;
+		result.instanceCount = source.instanceCount * parameters.instanceMultiplier;
+	}
+}
+
+
 kernel void convertUint8Indices(device uint8_t* src [[ buffer(0) ]],
                                 device uint16_t* dst [[ buffer(1) ]],
                                 uint pos [[thread_position_in_grid]]) {
