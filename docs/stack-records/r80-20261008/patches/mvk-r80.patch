+// One threadgroup proves whether this draw actually contains a restart index.
+// No sentinel means ordinary parallel conversion is identical for every mode.
+// When a sentinel exists, compact ordered primitives cooperatively in bounded
+// chunks. SIMD prefixes preserve segment resets, fan centers and strip parity.
+// The single-draw and batched entry points use the same compaction algorithm.
+// All scratch is supplied by the caller's own threadgroup, never shared across draws.
+static void metal4ConvertPrimitivesRestartImpl(const device uchar* indices,
+        const device MTLDrawIndexedPrimitivesIndirectArguments& source,
+        device uint* output, device MTLDrawIndexedPrimitivesIndirectArguments& result,
+        constant Metal4PrimitiveConversion& parameters, uint position,
+        uint simdWidth, uint lane, uint group,
+        threadgroup atomic_uint& hasRestart, threadgroup uint* groupRestart,
+        threadgroup uint* groupEmits, threadgroup uint& segmentStartCarry,
+        threadgroup uint& writtenCarry) {
+	bool hasOriginalRecord = (parameters.provokingLast & 2u) != 0;
+	if (position == 0) {
+		result = source; result.indexStart = 0; result.indexCount = 0;
+		result.instanceCount = 0;
+		if (hasOriginalRecord) {
+			device MTLDrawIndexedPrimitivesIndirectArguments& original = *(&result + 1);
+			original = source; original.indexCount = 0; original.instanceCount = 0;
+		}
+		atomic_store_explicit(&hasRestart, 0u, memory_order_relaxed);
+	}
+	// This is uniform: arguments are immutable throughout this dispatch. Reject
+	// invalid ranges before any index load or nonuniform barrier participation.
+	if (!parameters.threadStride || parameters.threadStride > 256 || !simdWidth || !metal4ConversionValid(source, parameters)) return;
+	threadgroup_barrier(mem_flags::mem_threadgroup);
+	uint sentinel = parameters.indexBytes == 1 ? 0xFFu : parameters.indexBytes == 2 ? 0xFFFFu : 0xFFFFFFFFu;
+	bool foundRestart = false;
+	for (ulong i = position; i < source.indexCount; i += parameters.threadStride) {
+		if (metal4ReadIndex(indices, ulong(source.indexStart) + i, parameters.indexBytes) == sentinel) {
+			foundRestart = true; break;
+		}
+	}
+	if (foundRestart) atomic_store_explicit(&hasRestart, 1u, memory_order_relaxed);
+	threadgroup_barrier(mem_flags::mem_threadgroup);
+	if (!atomic_load_explicit(&hasRestart, memory_order_relaxed)) {
+		uint size = metal4PrimitiveSize(parameters.topology);
+		uint count = metal4PrimitiveCount(source.indexCount, parameters.topology);
+		bool valid = ulong(count) * size <= parameters.outputCapacity;
+		bool originalList = hasOriginalRecord && (parameters.indexBytes == 2 || parameters.indexBytes == 4) &&
+			(parameters.topology == 0 || parameters.topology == 1 || parameters.topology == 3);
+		if (originalList) {
+			if (position == 0 && valid) {
