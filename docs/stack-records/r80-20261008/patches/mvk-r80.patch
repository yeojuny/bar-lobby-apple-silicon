+VkResult MVKQueue::signalMetal4Semaphore(MVKSemaphore* semaphore, uint64_t deferredToken) {
+	if (!_metal4Queue || !semaphore) { return VK_ERROR_INITIALIZATION_FAILED; }
+	NSError* error = nil;
