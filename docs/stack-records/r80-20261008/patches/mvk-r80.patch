+		// cannot safely implement resumeLostDevice while tail work may be pending.
+		_device->markLost(physicalLoss);
+		return VK_ERROR_DEVICE_LOST;
+	}
+	// Once a native submission is lost, dependent GPU signals will not execute.
+	// Publish device loss and wake waiters before any completion fence is signaled.
+	return _device->markLost();
+}
