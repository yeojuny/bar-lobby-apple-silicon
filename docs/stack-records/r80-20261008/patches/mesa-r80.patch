+static _EGLSurface *
+dri2_cocoa_create_window_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                                 void *native_window,
+                                 const EGLint *attrib_list)
+{
+   struct dri2_egl_config *dri2_conf = dri2_egl_config(conf);
+   struct dri2_egl_surface *dri2_surf;
+   const struct dri_config *config;
+   const struct baronmvk_cocoa_egl_surface *native = native_window;
+
+   if (!cocoa_native_surface_valid(native)) {
+      _eglError(EGL_BAD_NATIVE_WINDOW, "eglCreateWindowSurface");
+      return NULL;
+   }
+
+   dri2_surf = calloc(1, sizeof *dri2_surf);
+   if (!dri2_surf) {
+      _eglError(EGL_BAD_ALLOC, "eglCreateWindowSurface");
+      return NULL;
+   }
+
+   if (!dri2_init_surface(&dri2_surf->base, disp, EGL_WINDOW_BIT, conf,
+                          attrib_list, false, native_window)) {
+      free(dri2_surf);
+      return NULL;
+   }
+
+   cocoa_update_surface_size(dri2_surf);
+
+   config = dri2_get_dri_config(dri2_conf, EGL_WINDOW_BIT,
+                                dri2_surf->base.GLColorspace);
+   if (!config) {
+      _eglError(EGL_BAD_MATCH,
+                "Unsupported window surfacetype/colorspace configuration");
+      goto cleanup_surface;
+   }
+
+   if (!dri2_create_drawable(dri2_egl_display(disp), config, dri2_surf,
+                             dri2_surf))
+      goto cleanup_surface;
+
+   return &dri2_surf->base;
+
+cleanup_surface:
+   dri2_fini_surface(&dri2_surf->base);
+   free(dri2_surf);
+   return NULL;
+}
+
+static EGLBoolean
+dri2_cocoa_swap_interval(_EGLDisplay *disp, _EGLSurface *surf,
+                         EGLint interval)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   kopperSetSwapInterval(dri2_surf->dri_drawable, interval);
+   return EGL_TRUE;
+}
+
+static EGLBoolean
+dri2_cocoa_swap_buffers_with_damage(_EGLDisplay *disp, _EGLSurface *draw,
+                                    const EGLint *rects, EGLint n_rects)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(draw);
+
+   cocoa_update_surface_size(dri2_surf);
+   if (n_rects) {
+      kopperSwapBuffersWithDamage(dri2_surf->dri_drawable,
+                                  __DRI2_FLUSH_CONTEXT |
+                                     __DRI2_FLUSH_INVALIDATE_ANCILLARY,
+                                  n_rects, rects);
+   } else {
+      kopperSwapBuffers(dri2_surf->dri_drawable,
+                        __DRI2_FLUSH_CONTEXT |
+                           __DRI2_FLUSH_INVALIDATE_ANCILLARY);
+   }
+
+   kopperQuerySurfaceSize(dri2_surf->dri_drawable,
+                          &dri2_surf->base.Width,
+                          &dri2_surf->base.Height);
+   return EGL_TRUE;
+}
+
+static EGLBoolean
+dri2_cocoa_swap_buffers(_EGLDisplay *disp, _EGLSurface *draw)
+{
+   return dri2_cocoa_swap_buffers_with_damage(disp, draw, NULL, 0);
+}
+
+static EGLint
+dri2_cocoa_query_buffer_age(_EGLDisplay *disp, _EGLSurface *surf)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   return kopperQueryBufferAge(dri2_surf->dri_drawable);
+}
+
+static const struct dri2_egl_display_vtbl dri2_cocoa_display_vtbl = {
+   .create_window_surface = dri2_cocoa_create_window_surface,
+   .create_pbuffer_surface = dri2_surfaceless_create_pbuffer_surface,
+   .destroy_surface = surfaceless_destroy_surface,
+   .create_image = dri2_create_image_khr,
+   .swap_interval = dri2_cocoa_swap_interval,
+   .swap_buffers = dri2_cocoa_swap_buffers,
+   .swap_buffers_with_damage = dri2_cocoa_swap_buffers_with_damage,
+   .query_buffer_age = dri2_cocoa_query_buffer_age,
+   .get_dri_drawable = dri2_surface_get_dri_drawable,
+};
+
+static void
+dri2_cocoa_add_configs_for_visuals(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+
+   for (unsigned i = 0; dri2_dpy->driver_configs[i] != NULL; i++) {
+      const struct gl_config *gl_config =
+         (const struct gl_config *)dri2_dpy->driver_configs[i];
+
+      if (!cocoa_config_format_supported(gl_config->color_format))
+         continue;
+
+      dri2_add_config(disp, dri2_dpy->driver_configs[i],
+                      EGL_WINDOW_BIT | EGL_PBUFFER_BIT, NULL);
+   }
+}
