 EGLBoolean
 dri2_initialize_surfaceless(_EGLDisplay *disp)
 {
@@ -418,3 +642,45 @@ dri2_initialize_surfaceless(_EGLDisplay *disp)
 cleanup:
    return _eglError(EGL_NOT_INITIALIZED, err);
 }
+
+EGLBoolean
+dri2_initialize_cocoa(_EGLDisplay *disp)
+{
+   const char *err;
+   bool driver_loaded = false;
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+
+   driver_loaded = surfaceless_probe_device(disp, disp->Options.ForceSoftware,
+                                            disp->Options.Zink);
+   if (!driver_loaded &&
+       (disp->Options.ForceSoftware || disp->Options.Zink)) {
+      _eglLog(_EGL_DEBUG, "Falling back to cocoa zink/kopper without DRM.");
+      driver_loaded = surfaceless_probe_device_sw(disp);
+   }
+
+   if (!driver_loaded) {
+      err = "DRI2: failed to load driver";
+      goto cleanup;
+   }
+
+   if (!dri2_dpy->kopper) {
+      err = "DRI2: Cocoa platform requires zink/kopper";
+      goto cleanup;
+   }
+
+   dri2_setup_screen(disp);
+#ifdef HAVE_WAYLAND_PLATFORM
+   dri2_dpy->device_name =
+      loader_get_device_name_for_fd(dri2_dpy->fd_render_gpu);
+#endif
+   dri2_set_WL_bind_wayland_display(disp);
+
+   dri2_cocoa_add_configs_for_visuals(disp);
+
+   dri2_dpy->vtbl = &dri2_cocoa_display_vtbl;
+
+   return EGL_TRUE;
+
+cleanup:
+   return _eglError(EGL_NOT_INITIALIZED, err);
+}
