+#define BARONMVK_COCOA_EGL_SURFACE_MAGIC 0x434f4341u
+#define BARONMVK_COCOA_EGL_SURFACE_VERSION 1u
+
+struct baronmvk_cocoa_egl_surface {
+   uint32_t magic;
+   uint32_t version;
+   void *metal_layer;
+   uint32_t width;
+   uint32_t height;
+};
+
+static bool
+cocoa_config_format_supported(enum pipe_format format)
+{
+   switch (format) {
+   case PIPE_FORMAT_BGRA8888_UNORM:
+   case PIPE_FORMAT_BGRA8888_SRGB:
+   case PIPE_FORMAT_BGRX8888_UNORM:
+   case PIPE_FORMAT_BGRX8888_SRGB:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static bool
+cocoa_native_surface_valid(const struct baronmvk_cocoa_egl_surface *native)
+{
+   return native &&
+          native->magic == BARONMVK_COCOA_EGL_SURFACE_MAGIC &&
+          native->version == BARONMVK_COCOA_EGL_SURFACE_VERSION &&
+          native->metal_layer &&
+          native->width > 0 &&
+          native->height > 0;
+}
+
+static void
+cocoa_update_surface_size(struct dri2_egl_surface *dri2_surf)
+{
+   const struct baronmvk_cocoa_egl_surface *native =
+      dri2_surf->base.NativeSurface;
+
+   if (!cocoa_native_surface_valid(native))
+      return;
+
+   dri2_surf->base.Width = native->width;
+   dri2_surf->base.Height = native->height;
+}
+
+static void
+cocoa_kopper_set_surface_create_info(void *_draw,
+                                     struct kopper_loader_info *out)
+{
+   struct dri2_egl_surface *dri2_surf = _draw;
+   const struct baronmvk_cocoa_egl_surface *native =
+      dri2_surf->base.NativeSurface;
+   VkMetalSurfaceCreateInfoEXT *metal =
+      (VkMetalSurfaceCreateInfoEXT *)&out->bos;
+
+   memset(out, 0, sizeof(*out));
+   metal->sType = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT;
+   metal->pNext = NULL;
+   metal->flags = 0;
+   metal->pLayer = cocoa_native_surface_valid(native) ?
+      (const CAMetalLayer *)native->metal_layer : NULL;
+   out->has_alpha = true;
+   out->present_opaque = dri2_surf->base.PresentOpaque;
+}
+
+static void
+cocoa_kopper_get_drawable_info(struct dri_drawable *draw, int *w, int *h,
+                               void *loaderPrivate)
+{
+   struct dri2_egl_surface *dri2_surf = loaderPrivate;
+
+   cocoa_update_surface_size(dri2_surf);
+   *w = dri2_surf->base.Width;
+   *h = dri2_surf->base.Height;
+}
+
+static const __DRIkopperLoaderExtension cocoa_kopper_loader_extension = {
+   .base = {__DRI_KOPPER_LOADER, 1},
+   .SetSurfaceCreateInfo = cocoa_kopper_set_surface_create_info,
+   .GetDrawableInfo = cocoa_kopper_get_drawable_info,
+};
+
+static const __DRIextension *cocoa_kopper_loader_extensions[] = {
+   &cocoa_kopper_loader_extension.base,
+   &image_lookup_extension.base,
+   NULL,
+};
