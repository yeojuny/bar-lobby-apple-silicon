+bool
+util_translate_prim_restart_data_and_check(unsigned index_size,
+                                         void *src_map, void *dst_map,
+                                         unsigned count, unsigned restart_index)
+{
+   bool has_restart = false;
+   if (index_size == 2) {
+      const uint16_t *src = (const uint16_t *) src_map;
+      uint16_t *dst = (uint16_t *) dst_map;
+      for (unsigned i = 0; i < count; i++) {
+         uint16_t value = (src[i] == restart_index) ? 0xffff : src[i];
+         dst[i] = value;
+         has_restart |= value == 0xffff;
+      }
+   } else if (index_size == 4) {
+      const uint32_t *src = (const uint32_t *) src_map;
+      uint32_t *dst = (uint32_t *) dst_map;
+      for (unsigned i = 0; i < count; i++) {
+         uint32_t value = (src[i] == restart_index) ? 0xffffffff : src[i];
+         dst[i] = value;
+         has_restart |= value == 0xffffffff;
+      }
+   } else {
+      /* Preserve the old width-conversion contract without claiming a proof. */
+      util_translate_prim_restart_data(index_size, src_map, dst_map, count,
+                                      restart_index);
+      return true;
+   }
+   return has_restart;
+}
