+	bool SameFloatBits(float lhs, float rhs)
+	{
+		return std::bit_cast<uint32_t>(lhs) == std::bit_cast<uint32_t>(rhs);
+	}
+
+	bool SameFloatBits(const float4& lhs, const float4& rhs)
+	{
+		return SameFloatBits(lhs.x, rhs.x) && SameFloatBits(lhs.y, rhs.y)
+			&& SameFloatBits(lhs.z, rhs.z) && SameFloatBits(lhs.w, rhs.w);
+	}
+}
+
+void ModelUniformsStorage::UpdateObjectUniforms(const CSolidObject* o, bool visible)
+{
+	RECOIL_DETAILED_TRACY_ZONE;
+	const size_t offset = GetObjOffset(o);
+	// FreeListMap's mutable operator[] may resize; producers only access elements.
+	auto& uni = storage.GetData()[offset];
+
+	if (!visible) {
+		if (uni.drawFlag != o->drawFlag) {
+			uni.drawFlag = o->drawFlag;
+			updateList.SetUpdate(offset);
+		}
+		return;
+	}
+
+	const uint16_t id = o->id;
+	const uint8_t teamID = o->team;
+	const float4 drawPos{ o->drawPos, o->heading * math::PI / SPRING_MAX_HEADING };
+	if (uni.drawFlag == o->drawFlag
+		&& SameFloatBits(uni.drawPos, drawPos)
+		&& SameFloatBits(uni.speed, o->speed)
+		&& uni.id == id && uni.teamID == teamID
+		&& SameFloatBits(uni.maxHealth, o->maxHealth)
+		&& SameFloatBits(uni.health, o->health))
+		return;
+
+	uni.drawFlag = o->drawFlag;
+	uni.id = id;
+	uni.teamID = teamID;
+	uni.drawPos = drawPos;
+	uni.speed = o->speed;
+	uni.maxHealth = o->maxHealth;
+	uni.health = o->health;
+	updateList.SetUpdate(offset);
+}
+
+void ModelUniformsStorage::UpdateUserDefinedUniforms(size_t objectOffset, const float* values, size_t offset, size_t count)
+{
+	RECOIL_DETAILED_TRACY_ZONE;
+	assert(objectOffset < storage.size());
+	assert(offset <= MyType::MAX_MODEL_UD_UNIFORMS);
+	assert(count <= MyType::MAX_MODEL_UD_UNIFORMS - offset);
+	if (count == 0)
+		return;
+
+	auto* target = storage.GetData()[objectOffset].userDefined + offset;
+	const auto equalBits = [](float lhs, float rhs) { return SameFloatBits(lhs, rhs); };
+	if (std::equal(values, values + count, target, equalBits))
+		return;
+
+	std::copy(values, values + count, target);
+	updateList.SetUpdate(objectOffset);
+}
