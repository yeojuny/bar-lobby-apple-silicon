+#if defined(RECOIL_MACOS_SDL3_EGL)
+// Window-space coordinates include the notch strip; game-space coordinates do not.
+// Keep this at the local presentation/input boundary, outside synced game logic.
+static bool ClampMacPresentationMousePosition(int& x, int& y)
+{
+	if (globalRendering == nullptr || !globalRendering->active ||
+		!globalRendering->fullScreen || globalRendering->dualScreenMode ||
+		globalRendering->viewSizeX <= 0 || globalRendering->viewSizeY <= 0)
+		return false;
+
+	const int minX = globalRendering->viewPosX;
+	const int minY = globalRendering->viewWindowOffsetY;
+	const int maxX = minX + globalRendering->viewSizeX - 1;
+	const int maxY = minY + globalRendering->viewSizeY - 1;
+	const int clampedX = x < minX ? minX : (x > maxX ? maxX : x);
+	const int clampedY = y < minY ? minY : (y > maxY ? maxY : y);
+	const bool constrained = x != clampedX || y != clampedY;
+	x = clampedX;
+	y = clampedY;
+	return constrained;
+}
+#endif
