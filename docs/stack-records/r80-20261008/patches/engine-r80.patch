+	SDL_DisplayMode** modes = SDL_GetFullscreenDisplayModes(SDLCompat_GetDisplayIDFromIndex(displayIndex), &count);
+	SDL_free(modes);
+	return count;
+}
+
+static inline int SDLCompat_CopyDisplayMode(const SDL_DisplayMode* mode, SDL_DisplayMode* outMode)
