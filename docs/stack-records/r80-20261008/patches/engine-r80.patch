+
+// Model index uploads establish this proof once. Unknown writes or raw buffer
+// exposure invalidate it for every Lua wrapper borrowing the same model IBO.
+class IndexBufferRestartState {
+public:
+	void IncludeUpload(std::span<const uint32_t> indices)
+	{
+		if (indices.empty())
+			return;
+		maxIndex = std::max(maxIndex, *std::max_element(indices.begin(), indices.end()));
+		hasUpload = true;
+	}
+	void Invalidate() { externallyMutable = true; }
+	bool CanSkip(uint32_t restartIndex) const
+	{
+		return hasUpload && !externallyMutable && maxIndex < restartIndex;
+	}
+private:
+	uint32_t maxIndex = 0;
+	bool hasUpload = false;
+	bool externallyMutable = false;
+};
