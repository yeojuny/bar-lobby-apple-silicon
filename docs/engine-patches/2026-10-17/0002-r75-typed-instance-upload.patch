+size_t LuaVBOImpl::UploadInstanceData(const SInstanceData* data, size_t count, uint32_t elemOffset, int attrID)
+{
+	static_assert(sizeof(SInstanceData) == 4 * sizeof(uint32_t));
+	static_assert(std::is_trivially_copyable_v<SInstanceData>);
+	assert(count > 0 && elemOffset < elementsCount && count <= elementsCount - elemOffset);
+
+	// Callers have validated a uint4 attribute and resolved all object IDs.
+	const auto& attr = bufferAttribDefs.at(attrID);
+	const uint32_t bufferOffset = elemOffset * elemSizeInBytes;
+	auto* const bufferStart = static_cast<uint8_t*>(bufferData) + bufferOffset;
+	if (elemSizeInBytes == sizeof(SInstanceData)) {
+		assert(attr.pointer == 0);
+		memcpy(bufferStart, data, count * sizeof(SInstanceData));
+	} else {
+		for (size_t i = 0; i < count; ++i)
+			memcpy(bufferStart + i * elemSizeInBytes + attr.pointer, &data[i], sizeof(SInstanceData));
+	}
+
+	// Match UploadImpl's span, including untouched attributes but excluding the
+	// final record's trailing alignment padding. Preserve CPU Download contents.
+	const auto& lastAttr = bufferAttribDefsVec.back().second;
+	const size_t bytesWritten = (count - 1) * elemSizeInBytes + lastAttr.pointer + lastAttr.size * lastAttr.typeSizeInBytes;
+	if (S3DModelVAO::IsValid())
+		S3DModelVAO::GetInstance().InvalidateIndexRestartProof(vbo);
+	vbo->Bind();
+	vbo->SetBufferSubData(bufferOffset, bytesWritten, bufferStart);
+	vbo->Unbind();
+	return bytesWritten;
 }
 
