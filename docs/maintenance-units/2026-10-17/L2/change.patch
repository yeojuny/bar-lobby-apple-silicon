+TEST(Threading, LayersDeviceCreateDestroyLoop) {
+    const auto processor_count = std::thread::hardware_concurrency();
+
+    FrameworkEnvironment env{FrameworkSettings{}.set_log_filter("")};
+    auto& driver = env.add_icd(TEST_ICD_PATH_VERSION_2_EXPORT_ICD_GPDPA);
+
+    env.add_implicit_layer({}, ManifestLayer{}.add_layer(ManifestLayer::LayerDescription{}
+                                                             .set_name("implicit_layer_name")
+                                                             .set_lib_path(TEST_LAYER_PATH_EXPORT_VERSION_2)
+                                                             .set_disable_environment("DISABLE_ME")));
+    env.get_test_layer(0).set_call_create_and_destroy_device_in_GetQueue(true);
+
+    uint32_t num_loops_create_destroy_device = 100;
+    uint32_t num_loops_try_get_device_proc_addr = 5;
+
+    driver.add_and_get_physical_device("physical_device_0").known_device_functions = {
+        {"vkCmdBindPipeline", to_vkVoidFunction(test_vkCmdBindPipeline)},
+        {"vkCmdBindDescriptorSets", to_vkVoidFunction(test_vkCmdBindDescriptorSets)},
+        {"vkCmdBindVertexBuffers", to_vkVoidFunction(test_vkCmdBindVertexBuffers)},
+        {"vkCmdBindIndexBuffer", to_vkVoidFunction(test_vkCmdBindIndexBuffer)},
+        {"vkCmdDraw", to_vkVoidFunction(test_vkCmdDraw)}};
+
+    std::vector<std::thread> device_creation_threads;
+
+    for (uint32_t i = 0; i < processor_count; i++) {
+        device_creation_threads.emplace_back(create_destroy_device_loop, &env, num_loops_create_destroy_device,
+                                             num_loops_try_get_device_proc_addr);
+    }
+    for (uint32_t i = 0; i < processor_count; i++) {
+        device_creation_threads[i].join();
+    }
+}
+
+// Keep the owning layer's device vector fixed while the GetQueue hook creates devices below that layer.
+// The official loop above never calls GetQueue; these cases exercise and count the direct callbacks explicitly.
+class LayerDeviceCallbackResult : public testing::TestWithParam<VkResult> {};
+
+TEST_P(LayerDeviceCallbackResult, GetQueueCreatesDestroysAndRecovers) {
+    FrameworkEnvironment env{FrameworkSettings{}.set_log_filter("")};
+    auto& driver = env.add_icd(TEST_ICD_PATH_VERSION_2_EXPORT_ICD_GPDPA);
+    driver.add_and_get_physical_device("physical_device_0")
+        .add_queue_family_properties({{VK_QUEUE_GRAPHICS_BIT, 1, 0, {1, 1, 1}}, false});
+    env.add_implicit_layer({}, ManifestLayer{}.add_layer(ManifestLayer::LayerDescription{}
+                                                             .set_name("implicit_layer_name")
+                                                             .set_lib_path(TEST_LAYER_PATH_EXPORT_VERSION_2)
+                                                             .set_disable_environment("DISABLE_ME")));
+    auto& layer = env.get_test_layer(0);
+    layer.set_call_create_and_destroy_device_in_GetQueue(true);
+
+    InstWrapper inst{env.vulkan_functions};
+    ASSERT_NO_FATAL_FAILURE(inst.CheckCreate());
+    ASSERT_NE(nullptr, layer.callback_vkCreateDevice);
+    ASSERT_NE(nullptr, layer.callback_vkDestroyDevice);
+    VkPhysicalDevice phys_dev = inst.GetPhysDev();
+
+    const uint32_t worker_count = 2;
+    const uint32_t query_loops = 16;
+    std::vector<DeviceWrapper> devices;
+    devices.reserve(worker_count);
+    for (uint32_t i = 0; i < worker_count; i++) {
+        auto& device = devices.emplace_back(inst);
+        device.create_info.add_device_queue(DeviceQueueCreateInfo{}.add_priority(1.0f));
+        ASSERT_NO_FATAL_FAILURE(device.CheckCreate(phys_dev));
+    }
+    ASSERT_EQ(worker_count, layer.created_devices.size());
+    ASSERT_EQ(worker_count, driver.created_device_details.size());
+
+    const VkResult callback_result = GetParam();
+    const uint32_t calls_before = driver.create_device_call_count;
+    driver.set_create_device_return_code(callback_result);
+    std::vector<std::thread> threads;
+    for (uint32_t i = 0; i < worker_count; i++) {
+        threads.emplace_back([&, i]() {
+            for (uint32_t j = 0; j < query_loops; j++) {
+                VkQueue queue = VK_NULL_HANDLE;
+                env.vulkan_functions.vkGetDeviceQueue(devices[i], 0, 0, &queue);
+                if (callback_result == VK_SUCCESS) {
+                    EXPECT_NE(VK_NULL_HANDLE, queue);
+                } else {
+                    EXPECT_EQ(VK_NULL_HANDLE, queue);
+                }
+            }
+        });
+    }
+    for (auto& thread : threads) thread.join();
+    const uint32_t callback_calls = driver.create_device_call_count - calls_before;
+    EXPECT_EQ(worker_count * query_loops, callback_calls);
+    EXPECT_EQ(worker_count, driver.created_device_details.size());
+    EXPECT_EQ(worker_count, layer.created_devices.size());
+    RecordProperty("injected_callback_result", std::to_string(callback_result));
+    RecordProperty("callback_create_attempts", std::to_string(callback_calls));
+    RecordProperty("live_devices_after_callbacks", std::to_string(driver.created_device_details.size()));
+
+    // A new worker must acquire the lock after the failure/success workers have exited.
+    driver.set_create_device_return_code(VK_SUCCESS);
+    const uint32_t calls_before_recovery = driver.create_device_call_count;
+    std::thread recovery([&]() {
+        VkQueue queue = VK_NULL_HANDLE;
+        env.vulkan_functions.vkGetDeviceQueue(devices[0], 0, 0, &queue);
+        EXPECT_NE(VK_NULL_HANDLE, queue);
+    });
+    recovery.join();
+    EXPECT_EQ(1U, driver.create_device_call_count - calls_before_recovery);
+    EXPECT_EQ(worker_count, driver.created_device_details.size());
+    RecordProperty("recovery_create_attempts", std::to_string(driver.create_device_call_count - calls_before_recovery));
+
+    devices.clear();
+    EXPECT_TRUE(driver.created_device_details.empty());
+    EXPECT_TRUE(layer.created_devices.empty());
+    RecordProperty("live_devices_after_cleanup", std::to_string(driver.created_device_details.size()));
+}
+
