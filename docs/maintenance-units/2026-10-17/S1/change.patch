+                                "%s NUL-terminated stepping", cases[i].name);
+            decoded = SDL_StepBackUTF8(cases[i].text, &cursor);
+            SDLTest_AssertCheck(decoded == cases[i].expected && cursor == cases[i].text,
+                                "%s reverse stepping", cases[i].name);
+        }
+    }
+    return TEST_COMPLETED;
+}
 
