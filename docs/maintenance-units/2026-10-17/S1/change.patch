+        { "ASCII", "A", 0x0041, 1, true },
+        { "U+0080", "\xC2\x80", 0x0080, 2, true },
+        { "U+07FF", "\xDF\xBF", 0x07FF, 2, true },
+        { "U+0800", "\xE0\xA0\x80", 0x0800, 3, true },
+        { "Korean U+D55C", "\xED\x95\x9C", 0xD55C, 3, true },
+        { "U+FFFF", "\xEF\xBF\xBF", 0xFFFF, 3, true },
+        { "U+10000", "\xF0\x90\x80\x80", 0x10000, 4, true },
+        { "U+1F4BB", "\xF0\x9F\x92\xBB", 0x1F4BB, 4, true },
+        { "U+20000", "\xF0\xA0\x80\x80", 0x20000, 4, true },
+        { "U+3FFFF", "\xF0\xBF\xBF\xBF", 0x3FFFF, 4, true },
+        { "U+40000", "\xF1\x80\x80\x80", 0x40000, 4, true },
+        { "U+60000", "\xF1\xA0\x80\x80", 0x60000, 4, true },
+        { "U+FFFFF", "\xF3\xBF\xBF\xBF", 0xFFFFF, 4, true },
+        { "U+10FFFF", "\xF4\x8F\xBF\xBF", 0x10FFFF, 4, true },
+        { "overlong two-byte", "\xC0\xAF", SDL_INVALID_UNICODE_CODEPOINT, 1, false },
+        { "overlong three-byte", "\xE0\x80\x80", SDL_INVALID_UNICODE_CODEPOINT, 1, false },
+        { "surrogate", "\xED\xA0\x80", SDL_INVALID_UNICODE_CODEPOINT, 1, false },
+        { "overlong four-byte", "\xF0\x80\x80\x80", SDL_INVALID_UNICODE_CODEPOINT, 1, false },
+        { "invalid continuation", "\xF0\x28\x8C\xBC", SDL_INVALID_UNICODE_CODEPOINT, 1, false },
+        { "invalid lead", "\xFF", SDL_INVALID_UNICODE_CODEPOINT, 1, false },
+        { "stray continuation", "\x80", SDL_INVALID_UNICODE_CODEPOINT, 1, false },
+        { "truncated two-byte", "\xF0\x9F", SDL_INVALID_UNICODE_CODEPOINT, 1, false },
+        { "truncated three-byte", "\xF0\x9F\x92", SDL_INVALID_UNICODE_CODEPOINT, 1, false }
