+#if TESTING_COMMON_UNIX_PLATFORMS
+class SettingsPathListIntegration : public testing::TestWithParam<std::tuple<bool, bool>> {};
+
+TEST_P(SettingsPathListIntegration, SelectsDriverAndLayer) {
+    const auto [use_data_dirs, first_path_exists] = GetParam();
+    FrameworkEnvironment env{};
+    env.add_icd(TEST_ICD_PATH_VERSION_2, ManifestOptions{}.set_discovery_type(ManifestDiscoveryType::env_var))
+        .add_physical_device(PhysicalDevice{}.set_deviceName("regular-driver"));
+    for (const char* name : {"first-driver", "later-driver"}) {
+        env.add_icd(TEST_ICD_PATH_VERSION_2, ManifestOptions{}.set_discovery_type(ManifestDiscoveryType::override_folder))
+            .add_physical_device(PhysicalDevice{}.set_deviceName(name));
+    }
+    const char* layer_names[] = {"VK_LAYER_XDG_first", "VK_LAYER_XDG_later"};
+    for (const char* name : layer_names) {
+        env.add_explicit_layer(ManifestOptions{}.set_discovery_type(ManifestDiscoveryType::override_folder),
+                               ManifestLayer{}.add_layer(ManifestLayer::LayerDescription{}
+                                                             .set_name(name)
+                                                             .set_lib_path(TEST_LAYER_PATH_EXPORT_VERSION_2)));
+    }
+    const auto root = env.get_folder(ManifestLocation::settings_location).location().parent_path();
+    const std::string first = (root / "xdg-first").string();
+    const std::string later = (root / "xdg-later").string();
+    const std::string missing = (root / "xdg-missing").string();
+    env.file_system_manager.add_path_redirect(first + "/vulkan/loader_settings.d", ManifestLocation::settings_location);
+    env.file_system_manager.add_path_redirect(later + "/vulkan/loader_settings.d", ManifestLocation::unsecured_settings);
+    // Set only child-process fixture variables. Nonempty missing homes prevent fallback to the default home fixture.
+    EnvVarWrapper config_home{"XDG_CONFIG_HOME", missing};
+    EnvVarWrapper data_home{"XDG_DATA_HOME", missing};
+    const std::string paths = first + ":" + later;
+    EnvVarWrapper config_dirs{"XDG_CONFIG_DIRS", use_data_dirs ? missing : paths};
+    EnvVarWrapper data_dirs{"XDG_DATA_DIRS", use_data_dirs ? paths : missing};
+    for (size_t i = first_path_exists ? 0 : 1; i < 2; ++i) {
+        LoaderSettings settings;
+        settings.set_file_format_version({1, 0, 0}).add_app_specific_setting(
+            AppSpecificSettings{}
+                .set_additional_drivers_use_exclusively(true)
+                .add_driver_configuration(LoaderSettingsDriverConfiguration{}.set_path(env.get_icd_manifest_path(i + 1)))
+                .add_layer_configuration(LoaderSettingsLayerConfiguration{}
+                                             .set_name(layer_names[i])
+                                             .set_path(env.get_layer_manifest_path(i))
+                                             .set_control("on")));
+        env.update_loader_settings(settings, i == 0);
+    }
+    const size_t selected = first_path_exists ? 0 : 1;
+    InstWrapper inst{env.vulkan_functions};
+    inst.CheckCreate();
+    auto devices = inst.GetPhysDevs();
+    ASSERT_EQ(1U, devices.size());
+    VkPhysicalDeviceProperties properties{};
+    inst->vkGetPhysicalDeviceProperties(devices[0], &properties);
+    EXPECT_STREQ(selected == 0 ? "first-driver" : "later-driver", properties.deviceName);
+    auto layers = inst.GetActiveLayers(devices[0], 1);
+    ASSERT_EQ(1U, layers.size());
+    EXPECT_STREQ(layer_names[selected], layers[0].layerName);
+}
+
+INSTANTIATE_TEST_SUITE_P(SettingsXDG, SettingsPathListIntegration, testing::Combine(testing::Bool(), testing::Bool()));
