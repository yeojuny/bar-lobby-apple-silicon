 #include "testautomation_suites.h"
 
 /* Test case functions */
+
+/* Environment OOM checks use the existing runner, not a standalone harness.
+ * Hooks are installed at process startup and always use the saved allocator.
+ * Only the owning test thread records allocations; harness timer threads bypass it.
+ */
+static SDL_malloc_func environment_malloc;
+static SDL_calloc_func environment_calloc;
+static SDL_realloc_func environment_realloc;
+static SDL_free_func environment_free;
+static SDL_ThreadID environment_owner;
+static bool environment_hooks_ready;
+static struct
+{
+    bool active;
+    unsigned int fail_at, calls, failed, allocated, other_allocations, bad_frees, overflow;
+    void *pointers[8];
+    unsigned int frees[8];
+} environment_trace;
+
+static bool environment_tracking(void)
+{
+    return SDL_GetCurrentThreadID() == environment_owner && environment_trace.active;
+}
+
+static void *SDLCALL environment_test_malloc(size_t size)
+{
+    if (environment_tracking()) {
+        ++environment_trace.other_allocations;
+    }
+    return environment_malloc(size);
+}
+
+static void *SDLCALL environment_test_calloc(size_t count, size_t size)
+{
+    const bool tracking = environment_tracking();
+    void *pointer;
+    if (tracking && ++environment_trace.calls == environment_trace.fail_at) {
+        ++environment_trace.failed;
+        return NULL;
+    }
+    pointer = environment_calloc(count, size);
+    if (tracking && pointer) {
+        if (environment_trace.allocated < SDL_arraysize(environment_trace.pointers)) {
+            environment_trace.pointers[environment_trace.allocated++] = pointer;
+        } else {
+            ++environment_trace.overflow;
+        }
+    }
+    return pointer;
+}
+
+static void *SDLCALL environment_test_realloc(void *pointer, size_t size)
+{
+    if (environment_tracking()) {
+        ++environment_trace.other_allocations;
+    }
+    return environment_realloc(pointer, size);
+}
+
+static void SDLCALL environment_test_free(void *pointer)
+{
+    if (pointer && environment_tracking()) {
+        unsigned int i;
+        for (i = 0; i < environment_trace.allocated; ++i) {
+            if (environment_trace.pointers[i] == pointer) {
+                if (environment_trace.frees[i]++ != 0) {
+                    ++environment_trace.bad_frees;
+                    return; /* Report the double-free without crashing the runner. */
+                }
+                break;
+            }
+        }
+        if (i == environment_trace.allocated) {
+            ++environment_trace.bad_frees;
+        }
+    }
+    environment_free(pointer);
+}
+
+bool SDLTest_InstallEnvironmentMemoryHooks(void)
+{
+    environment_owner = SDL_GetCurrentThreadID();
+    SDL_GetMemoryFunctions(&environment_malloc, &environment_calloc, &environment_realloc, &environment_free);
+    environment_hooks_ready = SDL_SetMemoryFunctions(environment_test_malloc, environment_test_calloc,
+                                                    environment_test_realloc, environment_test_free);
+    return environment_hooks_ready;
+}
+
+static void environment_check_cleanup(const char *label)
+{
+    unsigned int i;
+    SDLTest_Log("%s: calloc calls=%u, allocated=%u, failed=%u", label,
+                environment_trace.calls, environment_trace.allocated, environment_trace.failed);
+    SDLTest_AssertCheck(environment_trace.other_allocations == 0, "%s no untracked allocation kind", label);
+    SDLTest_AssertCheck(environment_trace.bad_frees == 0, "%s no unknown or duplicate free", label);
+    SDLTest_AssertCheck(environment_trace.overflow == 0, "%s allocation ledger fits", label);
+    for (i = 0; i < environment_trace.allocated; ++i) {
+        SDLTest_AssertCheck(environment_trace.frees[i] == 1, "%s allocation %u freed exactly once", label, i + 1);
+    }
+}
+
+static int SDLCALL stdlib_environmentAllocations(void *arg)
+{
+    unsigned int i, allocations;
+    SDL_Environment *env;
+    const char *value;
+    const char *name = "SDL_S2_ISOLATED_ENVIRONMENT_TEST";
+    bool returned_null;
+
+    if (!environment_hooks_ready) {
+        SDLTest_Log("This test requires --no-init to install memory hooks before runner allocations.");
+        return TEST_SKIPPED;
+    }
+
+    /* These private copies never change the process or user's environment. */
+    for (i = 0; i < 2; ++i) {
+        env = SDL_CreateEnvironment(i != 0);
+        SDLTest_AssertCheck(env != NULL, "CreateEnvironment(populated=%u)", i);
+        if (!env) {
+            return TEST_ABORTED;
+        }
+        SDLTest_AssertCheck(SDL_SetEnvironmentVariable(env, name, "first", true), "Set isolated variable");
+        value = SDL_GetEnvironmentVariable(env, name);
+        SDLTest_AssertCheck(value && SDL_strcmp(value, "first") == 0, "Get isolated variable");
+        SDLTest_AssertCheck(SDL_SetEnvironmentVariable(env, name, "second", false), "Keep existing variable");
+        value = SDL_GetEnvironmentVariable(env, name);
+        SDLTest_AssertCheck(value && SDL_strcmp(value, "first") == 0, "No-overwrite keeps first value");
+        SDLTest_AssertCheck(SDL_SetEnvironmentVariable(env, name, "second", true), "Overwrite isolated variable");
+        value = SDL_GetEnvironmentVariable(env, name);
+        SDLTest_AssertCheck(value && SDL_strcmp(value, "second") == 0, "Get overwritten variable");
+        SDLTest_AssertCheck(SDL_UnsetEnvironmentVariable(env, name), "Unset isolated variable");
+        SDLTest_AssertCheck(SDL_GetEnvironmentVariable(env, name) == NULL, "Unset variable is absent");
+        SDL_DestroyEnvironment(env);
+    }
+
+    /* Warm the existing error buffer before observing only environment allocations. */
+    SDL_SetError("environment allocation test warmup");
+    SDL_ClearError();
+    SDL_zero(environment_trace);
+    environment_trace.active = true;
+    env = SDL_CreateEnvironment(false);
+    returned_null = env == NULL;
+    SDL_DestroyEnvironment(env);
+    environment_trace.active = false;
+    allocations = environment_trace.calls;
+    SDLTest_AssertCheck(!returned_null, "Uninjected environment creation succeeds");
+    SDLTest_AssertCheck(allocations > 0 && allocations <= SDL_arraysize(environment_trace.pointers),
+                        "Environment allocation sweep is bounded (%u calls)", allocations);
+    environment_check_cleanup("control creation/destruction");
+    if (returned_null || allocations == 0 || allocations > SDL_arraysize(environment_trace.pointers)) {
+        return TEST_ABORTED;
+    }
+
+    for (i = 1; i <= allocations; ++i) {
+        char label[64];
+        SDL_zero(environment_trace);
+        environment_trace.fail_at = i;
+        environment_trace.active = true;
+        env = SDL_CreateEnvironment(false);
+        returned_null = env == NULL;
+        SDL_DestroyEnvironment(env);
+        environment_trace.active = false;
+        SDL_snprintf(label, sizeof(label), "failure at allocation %u", i);
+        SDLTest_AssertCheck(returned_null, "%s returns NULL", label);
+        SDLTest_AssertCheck(environment_trace.failed == 1, "%s failure was injected", label);
+        environment_check_cleanup(label);
+    }
+
+    SDLTest_AssertCheck(SDL_GetEnvironmentVariable(NULL, name) == NULL, "NULL environment get is safe");
+    SDLTest_AssertCheck(!SDL_SetEnvironmentVariable(NULL, name, "value", true), "NULL environment set fails");
+    SDLTest_AssertCheck(!SDL_UnsetEnvironmentVariable(NULL, name), "NULL environment unset fails");
+    SDLTest_AssertCheck(SDL_GetEnvironmentVariables(NULL) == NULL, "NULL environment listing fails");
+    SDL_DestroyEnvironment(NULL);
+    SDL_ClearError();
+    return TEST_COMPLETED;
+}
 
