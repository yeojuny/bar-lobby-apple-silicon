+
+// The loader swaps its own copy of VkDeviceGroupDeviceCreateInfo into the pNext chain while creating the device. Make sure the
+// caller's chain is restored when device creation fails, otherwise it is left pointing at the loader's stack.
+TEST(CreateDevice, DeviceGroupPNextRestoredOnFailure) {
+    FrameworkEnvironment env{};
+    // A 1.0 driver without VK_KHR_device_group_creation, so the loader rejects a device group with more than one device
+    env.add_icd(TEST_ICD_PATH_VERSION_2).add_physical_device("physical_device_0");
+
+    InstWrapper inst{env.vulkan_functions};
+    inst.CheckCreate();
+
+    VkPhysicalDevice phys_dev = inst.GetPhysDev();
+    std::array<VkPhysicalDevice, 2> group_devices{phys_dev, phys_dev};
+
+    VkDeviceGroupDeviceCreateInfo group_info{};
+    group_info.sType = VK_STRUCTURE_TYPE_DEVICE_GROUP_DEVICE_CREATE_INFO;
+    group_info.physicalDeviceCount = static_cast<uint32_t>(group_devices.size());
+    group_info.pPhysicalDevices = group_devices.data();
+    VkBaseInStructure spacer_structure{};
+    spacer_structure.sType = static_cast<VkStructureType>(100000);
+    spacer_structure.pNext = reinterpret_cast<const VkBaseInStructure*>(&group_info);
+
+    DeviceWrapper dev{inst};
+    dev.create_info.dev.pNext = &spacer_structure;
+    dev.CheckCreate(phys_dev, VK_ERROR_INITIALIZATION_FAILED);
+
+    ASSERT_EQ(reinterpret_cast<const VkBaseInStructure*>(&group_info), spacer_structure.pNext);
+}
+
+class DeviceGroupPNextRestore : public testing::TestWithParam<std::tuple<VkResult, bool, bool>> {};
+
+TEST_P(DeviceGroupPNextRestore, PreservesCallerChain) {
+    const auto [expected_result, prepend_features, append_features] = GetParam();
+    FrameworkEnvironment env{};
+    auto& driver = env.add_icd(TEST_ICD_PATH_VERSION_2, {}, ManifestICD{}.set_api_version(VK_API_VERSION_1_1))
+                       .set_min_icd_interface_version(5)
+                       .set_icd_api_version(VK_API_VERSION_1_1)
+                       .add_instance_extension({VK_KHR_GET_PHYSICAL_DEVICE_PROPERTIES_2_EXTENSION_NAME});
+    driver.add_physical_device(PhysicalDevice{"physical_device_0"}.set_api_version(VK_API_VERSION_1_1));
+    driver.add_physical_device(PhysicalDevice{"physical_device_1"}.set_api_version(VK_API_VERSION_1_1));
+    driver.physical_device_groups.emplace_back(std::vector<size_t>{0, 1});
+    driver.set_create_device_return_code(expected_result);
+
+    InstWrapper inst{env.vulkan_functions};
+    inst.create_info.set_api_version(VK_API_VERSION_1_1);
+    inst.CheckCreate();
+    auto physical_devices = inst.GetPhysDevs(2U);
+    ASSERT_EQ(2U, physical_devices.size());
+    const auto original_physical_devices = physical_devices;
+
+    VkPhysicalDeviceProtectedMemoryFeatures tail{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROTECTED_MEMORY_FEATURES};
+    VkDeviceGroupDeviceCreateInfo group{VK_STRUCTURE_TYPE_DEVICE_GROUP_DEVICE_CREATE_INFO};
+    group.physicalDeviceCount = static_cast<uint32_t>(physical_devices.size());
+    group.pPhysicalDevices = physical_devices.data();
+    group.pNext = append_features ? &tail : nullptr;
+    VkPhysicalDeviceFeatures2 head{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+    head.pNext = &group;
+    const void* original_head = prepend_features ? static_cast<const void*>(&head) : static_cast<const void*>(&group);
+
+    DeviceWrapper dev{inst};
+    dev.create_info.dev.pNext = original_head;
+    dev.CheckCreate(physical_devices[0], expected_result);
+    ASSERT_EQ(1U, driver.create_device_call_count);
+
+    // Compare original caller-owned links before following any returned pNext value. A broken link may point at dead stack.
+    ASSERT_EQ(original_head, dev.create_info.dev.pNext);
+    ASSERT_EQ(&group, head.pNext);
+    ASSERT_EQ(append_features ? &tail : nullptr, group.pNext);
+    ASSERT_EQ(physical_devices.data(), group.pPhysicalDevices);
+    ASSERT_EQ(2U, group.physicalDeviceCount);
+    ASSERT_EQ(original_physical_devices, physical_devices);
+    ASSERT_EQ(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, head.sType);
+    ASSERT_EQ(VK_FALSE, head.features.robustBufferAccess);
+    ASSERT_EQ(VK_STRUCTURE_TYPE_DEVICE_GROUP_DEVICE_CREATE_INFO, group.sType);
+    ASSERT_EQ(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROTECTED_MEMORY_FEATURES, tail.sType);
+    ASSERT_EQ(nullptr, tail.pNext);
+    ASSERT_EQ(VK_FALSE, tail.protectedMemory);
+    ASSERT_EQ(expected_result == VK_SUCCESS ? 1U : 0U, driver.created_device_details.size());
+}
+
+INSTANTIATE_TEST_SUITE_P(CreateDevice, DeviceGroupPNextRestore,
+                        testing::Combine(testing::Values(VK_SUCCESS, VK_ERROR_INITIALIZATION_FAILED, VK_ERROR_OUT_OF_DEVICE_MEMORY),
+                                         testing::Bool(), testing::Bool()));
 
