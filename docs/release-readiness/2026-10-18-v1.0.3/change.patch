+			EmitGlyphVertex(vec2(-BARWIDTH - (currentglyphpos + 3.0) * BARHEIGHT + BARHEIGHT * 0.5, 0.0), vec2(0.0, msb * ATLASSTEP), vec2(ATLASSTEP, ATLASSTEP), idx - 72, centerpos, rotY, zoffset, sizemultiplier, glyphAlpha);
+			return;
+		}
+	}
+
+	HideVertex();
+}
